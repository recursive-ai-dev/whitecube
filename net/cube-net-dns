#!/usr/bin/python3 -I
"""dhcpcd hook: write router DNS to /run/whitecube-net/resolv.conf (no resolved, no dbus).

/etc/resolv.conf is a symlink to that file, so DNS exists only while the
dongle holds a lease. dhcpcd runs this as root with the lease in its environment.

Only plain unicast IPv4 resolvers are accepted: a DHCP server cannot point name
lookups at loopback, multicast, link-local or reserved addresses. If a new lease
(BOUND/REBOOT) offers nothing usable, the previous network's resolvers are removed
rather than kept; a RENEW/REBIND that omits DNS leaves the working file alone.
Search domains and hostnames offered by the server are never applied.
"""
import argparse
import ipaddress
import json
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

VERSION = "0.14.0"
RESOLV = Path("/run/whitecube-net/resolv.conf")
UP = {"BOUND", "RENEW", "REBIND", "REBOOT", "INFORM"}
FRESH = {"BOUND", "REBOOT"}   # a new or re-validated lease; RENEW/REBIND ACKs may omit options mid-lease
DOWN = {"EXPIRE", "FAIL", "STOP", "STOPPED", "NOCARRIER", "DEPARTED", "RELEASE"}


def usable(text):
    try:
        address = ipaddress.IPv4Address(text)
    except ValueError:
        return None
    if address.is_unspecified or address.is_loopback or address.is_multicast or address.is_link_local \
            or address.is_reserved:
        return None
    return str(address)


def write_atomic(path, body):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    temporary = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            os.fchmod(fd, 0o644)  # os.open's mode is masked by umask (the service runs with UMask=0077)
            stream.write(body)
        os.replace(temporary, path)
    except BaseException:
        temporary.unlink(missing_ok=True)
        raise


def inspect_resolv(resolv=RESOLV):
    """Read-only inspection of the hook-managed resolv.conf file."""
    path = Path(resolv)
    try:
        info = path.lstat()
    except FileNotFoundError:
        return {"present": False, "path": str(path), "nameservers": [], "options": [], "interface": None}
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_size > 8192:
        return {"present": True, "path": str(path), "valid": False, "nameservers": [], "options": [], "interface": None}
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    interface = None
    if lines and lines[0].startswith("# ") and " via dhcpcd" in lines[0]:
        interface = lines[0][2:].partition(" via dhcpcd")[0].strip() or None
    nameservers = [parts[1] for line in lines if (parts := line.split()) and len(parts) == 2 and parts[0] == "nameserver" and usable(parts[1])]
    options = [line[len("options "):].strip() for line in lines if line.startswith("options ")]
    return {
        "present": True,
        "valid": bool(nameservers),
        "path": str(path),
        "interface": interface,
        "nameservers": nameservers,
        "options": options,
    }


def main(environ=os.environ, resolv=RESOLV):
    interface = environ.get("interface", "")
    if not re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", interface):
        sys.exit("Invalid interface")
    reason = environ.get("reason", "")
    if reason in UP:
        servers = []
        raw_servers = environ.get("new_domain_name_servers", "")
        for item in re.split(r"[\s,]+", raw_servers.strip()):
            if not item:
                continue
            address = usable(item)
            if address and address not in servers:
                servers.append(address)
        if servers:
            # timeout/attempts keep a dead first resolver from stalling every lookup for ten seconds.
            body = f"# {interface} via dhcpcd (cube-net-dns)\noptions timeout:2 attempts:2\n"
            body += "".join(f"nameserver {server}\n" for server in servers[:3])
            write_atomic(resolv, body)
        elif reason in FRESH:
            resolv.unlink(missing_ok=True)
    elif reason in DOWN:
        resolv.unlink(missing_ok=True)


def cli(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    if not argv:
        main()
        return 0
    parser = argparse.ArgumentParser(description="Whitecube dhcpcd DNS hook and lease resolver inspector.")
    parser.add_argument("-v", "--version", action="version", version=f"cube-net-dns {VERSION}")
    parser.add_argument("--check", "--status", action="store_true", dest="check",
                        help="inspect active resolv.conf written by cube-net-dns without modifying anything")
    parser.add_argument("--json", action="store_true", help="output JSON when used with --check/--status")
    parser.add_argument("--resolv", type=Path, default=RESOLV, help="path to inspect instead of /run/whitecube-net/resolv.conf")
    args = parser.parse_args(argv)
    if args.check:
        info = inspect_resolv(args.resolv)
        if args.json:
            print(json.dumps(info, indent=2))
        else:
            if not info["present"]:
                print(f"cube-net-dns: no active lease resolvers at {info['path']}")
            elif not info.get("valid"):
                print(f"cube-net-dns: invalid or empty resolver file at {info['path']}")
            else:
                iface = f" on {info['interface']}" if info["interface"] else ""
                print(f"cube-net-dns: active resolvers{iface}: {', '.join(info['nameservers'])}")
        return 0 if info.get("valid") else 1
    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(cli())
