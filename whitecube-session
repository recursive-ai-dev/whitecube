#!/bin/sh
# Whitecube: pure Wayland, no dbus, no logind. Started by ~/.bash_profile on tty1;
# seatd provides DRM/input access. The browser and scripts terminal open on demand.
set -u
umask 077  # session logs and runtime records are private to this account
# A per-user installation keeps its compositor next to this session script.
session_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
compositor="$session_dir/whitecube"
[ -x "$compositor" ] || compositor=/usr/local/bin/whitecube
export PATH="$session_dir:${PATH:-/usr/local/bin:/usr/bin:/bin}"
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=whitecube
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM=wayland SDL_VIDEODRIVER=wayland ELM_DISPLAY=wl
unset DISPLAY DBUS_SESSION_BUS_ADDRESS

# Nothing creates /run/user/$UID without logind, and wlroots will not start
# without a private XDG_RUNTIME_DIR, so make one ourselves.
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ] || [ ! -w "$XDG_RUNTIME_DIR" ]; then
  XDG_RUNTIME_DIR="/run/user/$(id -u)"
  if [ ! -d "$XDG_RUNTIME_DIR" ] || [ ! -w "$XDG_RUNTIME_DIR" ]; then
    XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/xdg-runtime-$(id -u)"
    mkdir -p -m 700 "$XDG_RUNTIME_DIR"
    [ -O "$XDG_RUNTIME_DIR" ] || { echo "whitecube: $XDG_RUNTIME_DIR not owned by $(id -un)" >&2; exit 1; }
    chmod 700 "$XDG_RUNTIME_DIR"
  fi
  export XDG_RUNTIME_DIR
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}/whitecube"
mkdir -p -m 700 "$state" 2>/dev/null && [ -w "$state" ] || state="$XDG_RUNTIME_DIR"
log="$state/session.log"
fails="$state/failed-starts"

# Crash guard: after 3 failed starts within 60 s, stay on a plain shell instead
# of letting getty autologin respawn us forever. `exit` from that shell retries.
now=$(date +%s)
recent=$(awk -v now="$now" 'now - $1 < 60' "$fails" 2>/dev/null | wc -l)
if [ "$recent" -ge 3 ]; then
  : > "$fails"
  printf '\nwhitecube failed to start 3 times. Last log (%s):\n\n' "$log"
  tail -n 25 "$log" 2>/dev/null
  printf '\nType exit to try again.\n\n'
  exec bash -i  # non-login shell: does not re-run ~/.bash_profile
fi

[ -f "$log" ] && mv -f "$log" "$log.old"

# audio=pipewire (set from cube-settings > Sound) runs PipeWire as session
# children: no system service, and it stops with the compositor.
audio=$(sed -n 's/^audio=//p' /etc/whitecube/config "$HOME/.config/whitecube/config" 2>/dev/null | tail -n 1)
clients='for app in cube-ca cube-status; do command -v "$app" >/dev/null 2>&1 && "$app" & done; if command -v cube-check >/dev/null 2>&1; then cube-check --first-boot & fi'
if [ "$audio" = pipewire ] && command -v pipewire >/dev/null 2>&1; then
  clients="pipewire & sleep 0.5; wireplumber & pipewire-pulse & $clients"
fi

(
  echo "=== whitecube session $(date -Is) on $(tty) runtime=$XDG_RUNTIME_DIR audio=${audio:-alsa}"
  # The compositor exports its actual socket before starting these clients.
  "$compositor" -s "$clients"
  status=$?
  echo "=== whitecube exited with status $status at $(date -Is)"
  exit "$status"
) >>"$log" 2>&1
status=$?

if [ "$status" -ne 0 ]; then
  echo "$now" >> "$fails"
else
  : > "$fails"
fi
exit "$status"
