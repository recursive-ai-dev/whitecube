#!/usr/bin/env python3
"""Keyboard-accessible native display preferences and reviewable settings recovery."""
import argparse
import json
import os
from pathlib import Path
import sys

base = Path('/usr/share/whitecube/workspace')
if not (base / 'desktop_state.py').is_file():
    base = Path(__file__).resolve().parent.parent / 'workspace'
sys.path.insert(0, str(base))
from desktop_state import DesktopStore
from recovery import RecoveryConsole
from workspace_data import atomic_json

WHITECUBE_VERSION = '0.14.0'


def state_dir():
    return Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'whitecube'


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('-v', '--version', action='version', version=f'whitecube-desktop {WHITECUBE_VERSION}')
    parser.add_argument('--show', action='store_true', help='print current display settings without entering interactive mode')
    parser.add_argument('--json', action='store_true', help='format non-interactive output as JSON')
    parser.add_argument('--set-ui-scale', type=float, metavar='SCALE', help='set UI scale (0.8..1.6)')
    parser.add_argument('--set-terminal-scale', type=float, metavar='SCALE', help='set terminal scale (0.8..2.0)')
    parser.add_argument('--contrast', choices=('normal', 'strong'), help='set contrast mode')
    parser.add_argument('--reduced-motion', choices=('on', 'off'), help='set reduced motion')
    parser.add_argument('--list-backups', action='store_true', help='list recovery backups and exit')
    parser.add_argument('--backup', metavar='LABEL', help='create a settings backup with LABEL and exit')
    args = parser.parse_args(argv)

    store = DesktopStore(state_dir())
    console = RecoveryConsole(state=state_dir())
    non_interactive = (
        args.show or args.list_backups or args.backup is not None
        or args.set_ui_scale is not None or args.set_terminal_scale is not None
        or args.contrast is not None or args.reduced_motion is not None
    )
    if non_interactive:
        try:
            if args.backup is not None:
                created = console.create(args.backup)
                print(json.dumps(created, indent=2) if args.json else f"Created backup {created.get('id', '')}")
                return 0
            if args.list_backups:
                backups = console.list()
                if args.json:
                    print(json.dumps(backups, indent=2))
                else:
                    for item in backups:
                        print(f"{item.get('id', '')}\t{item.get('created_at', '')}\t{item.get('label', '')}")
                return 0
            settings = store.get_settings()
            updated = False
            if args.set_ui_scale is not None:
                settings['ui_scale'] = args.set_ui_scale; updated = True
            if args.set_terminal_scale is not None:
                settings['terminal_scale'] = args.set_terminal_scale; updated = True
            if args.contrast is not None:
                settings['contrast'] = args.contrast; updated = True
            if args.reduced_motion is not None:
                settings['reduced_motion'] = (args.reduced_motion == 'on'); updated = True
            if updated:
                settings = store.save_settings(settings)
            if args.json:
                print(json.dumps(settings, indent=2))
            else:
                print(f"UI scale {settings['ui_scale']}; terminal scale {settings['terminal_scale']}; contrast {settings['contrast']}; reduced motion {settings['reduced_motion']}")
            return 0
        except (OSError, ValueError, KeyError) as exc:
            print(f'whitecube-desktop: {exc}', file=sys.stderr)
            return 1

    state = state_dir()
    while True:
        settings = store.get_settings()
        print('\nWHITECUBE / DISPLAY AND RECOVERY\n')
        print(f"UI scale {settings['ui_scale']}; terminal scale {settings['terminal_scale']}; contrast {settings['contrast']}; reduced motion {settings['reduced_motion']}")
        print('u  UI scale (.8..1.6)   t  Terminal scale (.8..2)\nc  Toggle strong contrast   m  Toggle reduced motion\nn  Rename native workspaces   b  Create settings backup\nl  List backups   v  Verify backup   r  Review and restore backup\nq  Return to desktop')
        try:
            choice = input('Choice > ').strip().lower()
            if choice == 'q':
                return 0
            if choice in ('u', 't'):
                key = 'ui_scale' if choice == 'u' else 'terminal_scale'
                settings[key] = float(input('Scale > '))
                store.save_settings(settings)
            elif choice == 'c':
                settings['contrast'] = 'strong' if settings['contrast'] == 'normal' else 'normal'
                store.save_settings(settings)
            elif choice == 'm':
                settings['reduced_motion'] = not settings['reduced_motion']
                store.save_settings(settings)
            elif choice == 'n':
                names = []
                for index, default in enumerate(['Coding', 'Play', 'Monitor', 'Browse']):
                    name = input(f'Workspace {index + 1} ({default}) > ').strip() or default
                    encoded = name.encode('utf-8')
                    if len(encoded) > 63 or any(ord(char) < 32 or ord(char) == 127 for char in name):
                        raise ValueError('Workspace names must be at most 63 UTF-8 bytes with no control characters')
                    names.append(encoded.hex())
                atomic_json(state / 'native-names.json', {f'w{i}': value for i, value in enumerate(names)})
            elif choice == 'b':
                print(json.dumps(console.create(input('Backup label > ')), indent=2))
            elif choice == 'l':
                print(json.dumps(console.list(), indent=2))
            elif choice in ('v', 'r'):
                identifier = input('Backup identifier > ').strip()
                if choice == 'v':
                    print(json.dumps(console.verify(identifier), indent=2))
                else:
                    review = console.review(identifier)
                    print(json.dumps(review, indent=2))
                    if input('Type RESTORE to apply these exact changes > ').strip() == 'RESTORE':
                        print(json.dumps(console.restore(identifier, review['review_token']), indent=2))
            print('Display changes apply within two seconds; terminal scale applies to newly opened native terminals. Existing foot terminals have Ctrl+Plus/Minus for font size.')
        except (OSError, ValueError, KeyError) as exc:
            print('Unable to apply choice:', exc)


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (EOFError, KeyboardInterrupt):
        print()
