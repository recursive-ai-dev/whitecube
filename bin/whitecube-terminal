#!/usr/bin/env python3
"""Use the existing foot terminal with Whitecube's shared display preferences."""
import os
from pathlib import Path
import re
import sys

base = Path('/usr/share/whitecube/workspace')
if not (base / 'desktop_state.py').is_file():
    base = Path(__file__).resolve().parent.parent / 'workspace'
sys.path.insert(0, str(base))
from desktop_state import DesktopStore


def terminal_argv(args, settings, home=None):
    home = Path(home or Path.home())
    config = home / '.config/foot/foot.ini'
    index = 0
    options_with_values = {'-c', '--config', '-a', '--app-id', '-T', '--title', '-o', '--override', '-f', '--font', '-w', '--window-size-pixels', '-W', '--window-size-chars'}
    while index < len(args):
        arg = args[index]
        if arg == '--' or not arg.startswith('-'):
            break
        if arg in options_with_values and index + 1 < len(args):
            if arg in ('-c', '--config'):
                config = Path(args[index + 1])
            index += 2
        else:
            index += 1
    font = 'monospace:size=11'
    if config.is_file() and not config.is_symlink() and config.stat().st_size < 262144:
        for line in config.read_text().splitlines():
            if line.startswith('font='):
                font = line.partition('=')[2]
                break
    match = re.search(r':size=([0-9.]+)', font)
    if match:
        size = float(match.group(1)) * settings['terminal_scale']
        font = font[:match.start(1)] + str(round(size, 2)) + font[match.end(1):]
    else:
        font += ':size=' + str(round(11 * settings['terminal_scale'], 2))
    argv = ['foot', '-o', 'font=' + font]
    if settings['contrast'] == 'strong':
        argv.extend(['-o', 'colors.foreground=ffffff', '-o', 'colors.background=000000'])
    return argv + args


def main():
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'whitecube'
    settings = DesktopStore(state).get_settings()
    argv = terminal_argv(sys.argv[1:], settings)
    os.execvp(argv[0], argv)


if __name__ == '__main__':
    main()
