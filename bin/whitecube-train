#!/usr/bin/python3 -I
"""Command-line entry to the same pipeline used by Whitecube Trainer."""
import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
for directory in (root / 'apps/cube-train', root / 'share/whitecube/cube-train'):
    if (directory / 'cli.py').is_file():
        os.environ.setdefault('WHITECUBE_TRAIN_COMMAND', 'whitecube-train')
        os.execv('/usr/bin/python3', ['python3', '-I', str(directory / 'cli.py'), *sys.argv[1:]])
print('whitecube-train: pipeline files are missing; reinstall whitecube-desktop', file=sys.stderr)
raise SystemExit(1)
