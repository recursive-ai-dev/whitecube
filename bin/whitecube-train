#!/usr/bin/python3 -I
"""Command-line entry to the same pipeline used by Whitecube Trainer."""
import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
for directory in (root / 'apps/cube-train', root / 'share/whitecube/cube-train'):
    if (directory / 'engine.py').is_file():
        sys.path.insert(0, str(directory))
        import engine
        trainer = engine.Trainer()
        # Read-only summaries that need neither PyTorch nor the training lock.
        if sys.argv[1:] in (['--list-runs'], ['--status']):
            print(trainer.summary() if sys.argv[1] == '--list-runs' else trainer.status_text())
            raise SystemExit(0)
        # Notebook export copies files only, so it runs on the system Python.
        if sys.argv[1:2] == ['--export-notebook']:
            os.execv('/usr/bin/python3', ['python3', '-I', str(directory / 'pipeline/export_notebook.py'), *sys.argv[2:]])
        if '--help' in sys.argv[1:] or '-h' in sys.argv[1:]:
            print('Whitecube Trainer summaries:\n  whitecube-train --list-runs   list runs (* pinned, B/L checkpoints)\n'
                  '  whitecube-train --status      show the running desktop job\n'
                  '  whitecube-train --export-notebook RUN --output DIR [--checkpoint best|latest|stepN]\n'
                  '                                [--with-corpus] [--reference] [--no-script]\n')
        executable = trainer.preferences()['python']
        os.execv(executable, [executable, '-u', str(directory / 'pipeline/train_supervisor.py'), *sys.argv[1:]])
print('whitecube-train: pipeline files are missing; reinstall whitecube-desktop', file=sys.stderr)
raise SystemExit(1)
