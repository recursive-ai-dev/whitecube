#!/usr/bin/python3 -I
"""Launch Whitecube's Qt workspace manager from an installation or checkout."""
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parent.parent
locations = [root / 'apps/chrootables', root / 'share/whitecube/chrootables']
for directory in locations:
    if (directory / 'app.py').is_file():
        os.execv('/usr/bin/python3', ['python3', '-I', str(directory / 'app.py'), *sys.argv[1:]])
print('cube-chrootables: application files are missing; reinstall whitecube-desktop', file=sys.stderr)
raise SystemExit(1)
