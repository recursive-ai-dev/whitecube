#!/usr/bin/python3 -I
"""Launch the installed or checkout copy of cube-editor."""
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parent.parent
locations = [root / 'apps/cube-editor', root / 'share/whitecube/cube-editor']
for directory in locations:
    if (directory / 'app.py').is_file():
        os.execv('/usr/bin/python3', ['python3', '-I', str(directory / 'app.py'), *sys.argv[1:]])
print('cube-editor: application files are missing; reinstall whitecube-desktop', file=sys.stderr)
raise SystemExit(1)
