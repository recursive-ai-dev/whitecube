#!/usr/bin/python3 -I
"""Launch the native Whitecube small-model trainer."""
import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
for directory in (root / 'apps/cube-train', root / 'share/whitecube/cube-train'):
    if (directory / 'app.py').is_file():
        os.environ['GDK_BACKEND'] = 'wayland'
        os.execv('/usr/bin/python3', ['python3', '-I', str(directory / 'app.py'), *sys.argv[1:]])
print('cube-train: application files are missing; reinstall whitecube-desktop', file=sys.stderr)
raise SystemExit(1)
