#!/usr/bin/python3 -I
"""whitecube-doctor: read-only health report for the Whitecube desktop. Changes nothing, needs no root.

  whitecube-doctor            human-readable report; exit status 1 if anything FAILs
  whitecube-doctor --json     the same findings as JSON
  whitecube-doctor --project DIR   compare installed files with the sources in DIR
  whitecube-doctor --check package --strict   fail on package warnings too
  whitecube-doctor --list-checks    list the selectable check groups

Each finding is ok / info / WARN / FAIL with the command that would fix it. It looks at the facts that
caused real trouble here: the firewall's output policy, competing network managers, the Wi-Fi
controller's state, wpa_supplicant leftovers, installed copies that lag the source, and over-broad
passwordless sudo.
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shlex
import stat
import subprocess
import sys
import time

LEVELS = ('ok', 'info', 'WARN', 'FAIL')
CHECK_GROUPS = ('package', 'network', 'drift', 'security', 'libraries', 'session', 'folders', 'audio', 'browser', 'editor', 'trainer', 'vm', 'chrootables', 'prompts', 'chat', 'suite')
WHITECUBE_VERSION = '0.13.0'


def sha(path):
    try:
        return hashlib.sha256(Path(path).read_bytes()).hexdigest()
    except OSError:
        return None


def finding(level, name, detail='', fix=''):
    return {'level': level, 'name': name, 'detail': detail, 'fix': fix}


class Env:
    def __init__(self, project, root=Path('/'), home=None):
        self.project, self.root = Path(project), Path(root)
        self.home = Path(home) if home else Path.home()

    @property
    def packaged(self):
        return any(self.at(name).exists() for name in
                   ('/usr/bin/whitecube-compositor', '/usr/share/wayland-sessions/whitecube.desktop',
                    '/var/lib/dpkg/info/whitecube-desktop.list'))

    def at(self, absolute):
        return self.root / str(absolute).lstrip('/')


def load_cube_net(env):
    for candidate in (env.project / 'net/cube-net', env.at('/usr/bin/cube-net')):
        if candidate.is_file():
            loader = importlib.machinery.SourceFileLoader('cube_net_for_doctor', str(candidate))
            spec = importlib.util.spec_from_loader('cube_net_for_doctor', loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            return module
    return None


# ---- checks: each returns a list of findings

def check_firewall(env):
    ufw = env.at('/etc/default/ufw')
    conf = env.at('/etc/ufw/ufw.conf')
    try:
        text = ufw.read_text()
    except OSError:
        return [finding('info', 'firewall', 'ufw is not configured here')]
    policy = re.search(r'^\s*DEFAULT_OUTPUT_POLICY\s*=\s*["\']?(\w+)', text, re.M)
    enabled = re.search(r'^\s*ENABLED\s*=\s*(\w+)', conf.read_text() if conf.is_file() else '', re.M)
    on = bool(enabled and enabled.group(1).lower() == 'yes')
    output = policy.group(1).upper() if policy else 'unknown'
    if on and output in ('DROP', 'REJECT'):
        return [finding('FAIL', 'firewall output policy', f'ufw is on and outgoing is {output}: DNS, web, NTP and DHCP renewals are blocked',
                        'sudo ufw default allow outgoing')]
    if output in ('DROP', 'REJECT'):
        return [finding('WARN', 'firewall output policy', f'ufw is off but would drop outgoing ({output}) the moment it is enabled',
                        'sudo ufw default allow outgoing   (before enabling ufw)')]
    return [finding('ok', 'firewall output policy', f'ufw {"on" if on else "off"}, outgoing {output}')]


def check_network(env, net):
    out = []
    if net is None:
        return [finding('WARN', 'wifi controller', 'cube-net is not installed and not in the source tree')]
    status_file = env.at('/run/whitecube-net/status.json')
    try:
        raw = json.loads(status_file.read_text())
        age = time.time() - float(raw.get('updated_epoch', 0))
    except (OSError, ValueError, TypeError):
        return [finding('WARN', 'wifi controller', 'no status published: the whitecube-network service is not running',
                        'sudo systemctl status whitecube-network.service')]
    if age > 15:
        return [finding('FAIL', 'wifi controller', f'status is {int(age)} s old: the service is stuck or stopped',
                        'journalctl -u whitecube-network.service -b | tail -40')]
    state = raw.get('association_state')
    code = None
    try:
        data = net.status(env.root.resolve() if env.root != Path('/') else Path('/'))
        code = data.get('diagnostic_code')
    except Exception:  # a doctor must not crash on the thing it diagnoses
        pass
    level = 'ok' if state == 'COMPLETED' and raw.get('dns_ok') is not False and raw.get('connectivity_ok') is not False else 'WARN'
    out.append(finding(level, 'wifi controller', f'{state}, signal {raw.get("signal_dbm")} dBm, ip {raw.get("ipv4_address")}'
                       + (f', diagnosis {code}' if code else ''), '' if level == 'ok' else 'cube-net status   (diagnostic_summary says what is wrong)'))
    return out


def check_dns_lease(env):
    status_file = env.at('/run/whitecube-net/status.json')
    try:
        raw = json.loads(status_file.read_text())
        age = time.time() - float(raw.get('updated_epoch', 0))
    except (OSError, ValueError, TypeError):
        return []
    if age > 15 or raw.get('association_state') != 'COMPLETED' or not raw.get('ipv4_address'):
        return []
    resolv = env.at('/run/whitecube-net/resolv.conf')
    try:
        lines = resolv.read_text().splitlines()
    except OSError:
        return [finding('WARN', 'dns lease', 'associated with IPv4 but /run/whitecube-net/resolv.conf is missing',
                        'sudo systemctl status whitecube-network.service   (check dhcpcd lease)')]
    servers = [parts[1] for line in lines if (parts := line.split()) and len(parts) == 2 and parts[0] == 'nameserver']
    if not servers:
        return [finding('WARN', 'dns lease', '/run/whitecube-net/resolv.conf has no active nameservers',
                        'sudo systemctl status whitecube-network.service   (check dhcpcd lease)')]
    return [finding('ok', 'dns lease', f'{len(servers)} active resolver(s) via cube-net-dns: {", ".join(servers[:3])}')]


def check_lockdown(env):
    marker = env.at('/var/lib/whitecube/net-lockdown.json')
    try:
        if not marker.exists():
            return []
        data = json.loads(marker.read_text())
    except PermissionError:
        return [finding('WARN', 'network lockdown', 'persistent net-off lockdown marker exists (unreadable without root)',
                        'sudo net-off --status')]
    except (OSError, ValueError):
        return [finding('WARN', 'network lockdown', 'persistent net-off lockdown marker exists but is unreadable or malformed',
                        'sudo net-off --status')]
    loopback = 'allowed' if data.get('allow_loopback', True) else 'blocked'
    return [finding('WARN', 'network lockdown', f'persistent net-off lockdown enabled (loopback {loopback})',
                    'sudo net-on')]


def check_competitors(env, net):
    if net is None:
        return []
    found = net.competing_processes('', env.at('/proc'))
    rivals = [name for name in found if name != 'dhcpcd']
    if rivals:
        return [finding('WARN', 'competing network managers', 'running: ' + ', '.join(rivals) + '; cube-net refuses to start next to them',
                        'sudo cube-net takeover   (rolls back by itself unless cube-net gets online)')]
    return [finding('ok', 'competing network managers', 'none running')]


def check_wpa_leftovers(env):
    present = [name for name in ('wpa_supplicant', 'wpa_cli') if env.at(f'/usr/sbin/{name}').is_file()]
    if present:
        return [finding('info', 'wpa_supplicant', 'still installed but unused since cube-net revision 3; remove once the built-in station has proven itself',
                        'sudo apt purge wpasupplicant && sudo apt autoremove')]
    return [finding('ok', 'wpa_supplicant', 'not installed (the built-in station is the only Wi-Fi supplicant)')]


def install_map(env):
    p, h = env.project, env.home
    if env.packaged:
        # Packaged installations deliberately use different compositor/unit paths.
        # Config and skel files are user choices, not stale program copies.
        pairs = [('net/cube-net', '/usr/bin/cube-net'),
                 ('net/cube-net-dns', '/usr/libexec/whitecube/cube-net-dns'),
                 ('net/whitecube-network.service', '/usr/lib/systemd/system/whitecube-network.service'),
                 ('libexec/cube-settings-helper', '/usr/libexec/whitecube/cube-settings-helper'),
                 ('build/whitecube', '/usr/bin/whitecube-compositor')]
        pairs += [('build/' + name, '/usr/bin/' + name)
                  for name in ('cube-ca', 'cube-settings', 'cube-status', 'cube-audio')]
        pairs += [('bin/' + name, '/usr/bin/' + name)
                  for name in ('cube-privacy', 'whitecube-session', 'whitecube-doctor')]
        return [(p / src, env.at(dst),
                 'rebuild the Debian package from the source tree, then install the printed .deb with sudo apt install')
                for src, dst in pairs]
    pairs = [('net/cube-net', '/usr/bin/cube-net'), ('net/cube-net-dns', '/usr/libexec/whitecube/cube-net-dns'),
             ('net/dhcpcd.conf', '/etc/whitecube/network/dhcpcd.conf'),
             ('net/whitecube-network.service', '/etc/systemd/system/whitecube-network.service'),
             ('libexec/cube-settings-helper', '/usr/libexec/whitecube/cube-settings-helper')]
    result = [(p / src, env.at(dst), f'sudo bash {p}/net/apply.sh --apply') for src, dst in pairs]
    for name in ('whitecube', 'cube-settings', 'cube-status', 'cube-audio'):
        result.append((p / 'build' / name, h / '.local/bin' / name, f'{p}/BUILD.sh && python3 {p}/tools/INSTALL-USER.py --apply'))
    for name in ('cube-privacy', 'whitecube-session'):
        result.append((p / 'bin' / name, h / '.local/bin' / name, f'python3 {p}/tools/INSTALL-USER.py --apply'))
    result.append((p / 'data/foot.ini', h / '.config/foot/foot.ini', f'cp {p}/data/foot.ini ~/.config/foot/foot.ini'))
    return result


def check_drift(env):
    stale, missing, fixes = [], [], []
    compared = 0
    for source, installed, fix in install_map(env):
        mine = sha(source)
        if mine is None:
            continue                                        # not built yet: nothing to compare against
        compared += 1
        theirs = sha(installed)
        if theirs is None:
            missing.append(installed.name)
        elif theirs != mine:
            stale.append(installed.name)
        else:
            continue
        if fix not in fixes:
            fixes.append(fix)
    if not compared:
        return [finding('info', 'installed copies', 'source tree unavailable; source comparison skipped',
                        'whitecube-doctor --project /path/to/whitecube --check drift')]
    if not stale and not missing:
        return [finding('ok', 'installed copies', 'every installed file matches the source')]
    detail = '; '.join(part for part in (('differs from source: ' + ', '.join(stale)) if stale else '',
                                         ('not installed: ' + ', '.join(missing)) if missing else '') if part)
    return [finding('WARN', 'installed copies', detail + ' (installs need your sudo; the doctor never installs)', ' ; '.join(fixes))]


def check_sudoers(env):
    candidates = [env.at('/etc/sudoers.d/whitecube-settings')]
    if not env.packaged:
        candidates.append(env.project / 'data/sudoers/whitecube-settings')
    for candidate in candidates:
        try:
            text = candidate.read_text()
        except OSError:
            continue
        broad = re.findall(r'^%(\w+)\s+ALL=\(root\)\s+NOPASSWD:', text, re.M)
        if broad:
            return [finding('info', 'passwordless sudo', f'group %{broad[0]} may run the settings helper actions in CUBE_FREE without a password; '
                            'any process running as you can use them (add a Wi-Fi network, power off)',
                            f'review {env.project}/data/sudoers/whitecube-settings.hardened')]
        return [finding('ok', 'passwordless sudo', 'no group-wide NOPASSWD rule')]
    return [finding('info', 'passwordless sudo', 'sudoers rule file not found')]


def check_xfree(env):
    """libX11/libxcb in the installed desktop binaries means the distro cairo is in use (policy: X-free)."""
    linked = []
    uninspected = []
    for name in ('whitecube-compositor' if env.packaged else 'whitecube', 'cube-ca', 'cube-settings', 'cube-status', 'cube-audio'):
        binary = env.at('/usr/bin/' + name) if env.packaged else env.home / '.local/bin' / name
        if not binary.is_file():
            continue
        try:
            done = subprocess.run(['/usr/bin/ldd', str(binary)], capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            uninspected.append(name)
            continue
        if re.search(r'libX11|libxcb', done.stdout):
            linked.append(name)
        elif done.returncode:
            uninspected.append(name)
    out = []
    if linked:
        out.append(finding('WARN', 'x11 libraries', 'linked into ' + ', '.join(linked) + ' through the distro cairo',
                        ('reinstall the Whitecube Debian package and check /etc/ld.so.conf.d/whitecube.conf' if env.packaged else
                         f'{env.project}/tools/build-xfree-cairo.sh   (then the sudo cp it prints; no rebuild needed)')))
    if uninspected:
        out.append(finding('WARN', 'x11 libraries', 'could not inspect ' + ', '.join(uninspected),
                           'run whitecube-doctor --check package to inspect installed runtime files'))
    return out or [finding('ok', 'x11 libraries', 'none linked into the installed desktop binaries')]


def check_session(env):
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    wayland = os.environ.get('XDG_SESSION_TYPE') == 'wayland'
    out = []
    if os.environ.get('DISPLAY'):
        out.append(finding('WARN', 'x11', 'DISPLAY is set; the desktop is Wayland-only', 'unset DISPLAY'))
    if not runtime:
        out.append(finding('FAIL' if wayland else 'info', 'session',
                           'XDG_RUNTIME_DIR is not set' + (' in a Wayland session' if wayland else ' (not in a desktop session)'),
                           'start Whitecube through whitecube-session' if wayland else ''))
        return out
    path = Path(runtime)
    try:
        attrs = path.lstat()
    except OSError as error:
        out.append(finding('FAIL', 'runtime directory', f'{runtime}: {error.strerror}',
                           'log out and start Whitecube through whitecube-session'))
        return out
    if not path.is_absolute() or not stat.S_ISDIR(attrs.st_mode) or attrs.st_uid != os.getuid() or stat.S_IMODE(attrs.st_mode) != 0o700:
        out.append(finding('FAIL', 'runtime directory',
                           f'{runtime} must be a real absolute directory (no symlinks) owned by this account with mode 0700',
                           'log out and start Whitecube through whitecube-session'))
        return out
    out.append(finding('ok', 'runtime directory', 'private runtime directory owned by this account'))
    display = os.environ.get('WAYLAND_DISPLAY')
    if display:
        socket = Path(display) if os.path.isabs(display) else path / display
        try:
            is_socket = stat.S_ISSOCK(socket.stat().st_mode)
        except OSError:
            is_socket = False
        out.append(finding('ok' if is_socket else 'WARN', 'Wayland display',
                           f'{display}: ' + ('socket exists' if is_socket else 'no Wayland socket; the compositor may have stopped'),
                           '' if is_socket else 'inspect ~/.local/state/whitecube/session.log'))
    elif wayland:
        out.append(finding('WARN', 'Wayland display', 'WAYLAND_DISPLAY is not set in this Wayland session',
                           'open a terminal inside the Whitecube session and rerun whitecube-doctor'))
    return out


def check_package(env):
    """Report broken startup paths before the user attempts their next login."""
    if not env.packaged:
        return [finding('info', 'package files', 'Whitecube Debian package is not installed')]
    executables = ('/usr/bin/whitecube-compositor', '/usr/bin/whitecube-session',
                   '/usr/bin/cube-status', '/usr/bin/cube-settings', '/usr/bin/cube-ca',
                   '/usr/bin/cube-audio', '/usr/bin/whitecube-terminal', '/usr/bin/desktop-chat',
                   '/usr/libexec/whitecube/cube-settings-helper',
                   '/usr/lib/whitecube/desktop-chat-runtime/electron')
    data = ('/usr/share/wayland-sessions/whitecube.desktop',
            '/usr/share/whitecube/schemas/gschemas.compiled', '/etc/whitecube/config',
            '/usr/share/whitecube/desktop-chat/main.js')
    broken = [name for name in executables if not env.at(name).is_file() or not os.access(env.at(name), os.X_OK)]
    broken += [name for name in data if not env.at(name).is_file()]
    remedy = 'sudo apt install --reinstall whitecube-desktop'
    out = [finding('FAIL' if broken else 'ok', 'package files',
                   'missing or unusable: ' + ', '.join(broken) if broken else 'desktop startup files and Chat runtime are present',
                   remedy if broken else '')]
    # ldd is bounded and only runs on the installed, known desktop binaries.
    missing = []
    runtime_binaries = [(name, '/usr/bin/' + name)
                        for name in ('whitecube-compositor', 'cube-status', 'cube-settings', 'cube-ca', 'cube-audio')]
    runtime_binaries.append(('desktop-chat', '/usr/lib/whitecube/desktop-chat-runtime/electron'))
    for name, path in runtime_binaries:
        binary = env.at(path)
        if not binary.is_file():
            continue
        try:
            done = subprocess.run(['/usr/bin/ldd', str(binary)], capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError) as error:
            out.append(finding('WARN', 'runtime libraries', f'could not inspect {name}: {type(error).__name__}'))
            continue
        libraries = re.findall(r'^\s*(\S+)\s+=>\s+not found', done.stdout, re.M)
        missing.extend(name + ': ' + lib for lib in libraries)
        if done.returncode and not libraries:
            out.append(finding('WARN', 'runtime libraries',
                               f'could not inspect {name}: ldd exited with status {done.returncode}', remedy))
    if missing:
        out.append(finding('FAIL', 'runtime libraries', '; '.join(missing),
                           'sudo apt --fix-broken install; then reinstall whitecube-desktop'))
    return out


def check_shadowing(env):
    """Once the package is installed, older per-user or /usr/local copies would still win on PATH."""
    if not env.at('/usr/bin/whitecube-compositor').exists():
        return []
    names = ('whitecube', 'whitecube-compositor', 'whitecube-desktop', 'whitecube-session', 'whitecube-terminal',
             'whitecube-web', 'whitecube-browser', 'whitecube-doctor', 'whitecube-migrate', 'whitecube-train',
             'whitecube-vm', 'whitecube-chrootable-manager', 'cube-status', 'cube-settings', 'cube-ca', 'cube-audio',
             'cube-player', 'cube-net', 'cube-prompts', 'cube-chrootables', 'cube-strap', 'cube-train', 'cube-editor',
             'cube-lock', 'cube-pdf', 'cube-hash', 'cube-rename', 'desktop-chat')
    stale = [str(d / n).replace(str(env.home), '~') for d in (env.home / '.local/bin', env.at('/usr') / 'local/bin') for n in names if (d / n).exists()]
    wc_lib = env.home / '.local/lib/wc-suite'
    if wc_lib.is_dir():
        stale.append('~/.local/lib/wc-suite')
    if not stale:
        return [finding('ok', 'package', 'no older copies shadow the installed package')]
    return [finding('WARN', 'package', f'{len(stale)} older copies shadow /usr/bin: ' + ', '.join(stale[:4]) + (' ...' if len(stale) > 4 else ''),
                    'sudo whitecube-migrate (dry run), then sudo whitecube-migrate --apply')]


def folder_handler(env):
    """The default app for inode/directory per the mimeapps.list search order, and its .desktop file."""
    lists = [env.home / '.config/mimeapps.list', env.at('/etc/xdg/mimeapps.list'),
             env.home / '.local/share/applications/mimeapps.list', env.at('/usr/share/applications/mimeapps.list')]
    for path in lists:
        try:
            lines = path.read_text(errors='replace').splitlines()
        except OSError:
            continue
        section = ''
        for line in lines:
            line = line.strip()
            if line.startswith('['):
                section = line
            elif section == '[Default Applications]' and line.startswith('inode/directory='):
                for name in filter(None, line.split('=', 1)[1].split(';')):
                    for folder in (env.home / '.local/share/applications', env.at('/usr/share/applications')):
                        if (folder / name).is_file():
                            return name, folder / name
                    return name, None
    return None, None


def check_folder_handler(env):
    """Apps open folders through xdg-open/GIO; a missing default sends 'Open folder' nowhere."""
    name, desktop = folder_handler(env)
    if not name:
        return [finding('WARN', 'folders', 'no default app for folders (inode/directory)',
                        'xdg-mime default thunar.desktop inode/directory')]
    if desktop is None:
        return [finding('WARN', 'folders', f'the default folder app {name} is not installed',
                        'xdg-mime default thunar.desktop inode/directory')]
    command = ''
    for line in desktop.read_text(errors='replace').splitlines():
        if line.startswith('Exec='):
            raw = line[5:].strip()
            try:
                tokens = shlex.split(raw)
            except ValueError:
                tokens = raw.split()
            if tokens and tokens[0] in ('env', '/usr/bin/env'):
                tokens = tokens[1:]
                while tokens and '=' in tokens[0] and not tokens[0].startswith(('/', '-')):
                    tokens = tokens[1:]
            command = tokens[0] if tokens else ''
            break
    found = command and (env.at(command).is_file() if command.startswith('/') else
                         any((d / command).is_file() for d in (env.at('/usr/bin'), env.at('/usr') / 'local/bin', env.at('/bin'))))
    if not found:
        return [finding('WARN', 'folders', f'{name} runs {command or "nothing"}, which is not installed',
                        f'reinstall it, or pick another: xdg-mime default APP.desktop inode/directory')]
    return [finding('ok', 'folders', f'folders open with {name}')]


def check_audio(env):
    """Verify kernel sound device permissions and configured audio backend availability."""
    out = []
    snd = env.at('/dev/snd')
    cards = sorted(snd.glob('controlC[0-9]*')) if snd.is_dir() else []
    if not cards:
        out.append(finding('info', 'audio devices', 'no /dev/snd control device detected'))
    else:
        blocked = [c.name for c in cards if not os.access(c, os.R_OK | os.W_OK)]
        if blocked:
            out.append(finding('WARN', 'audio devices',
                               'permission denied on ' + ', '.join(blocked),
                               'sudo usermod -aG audio "$USER"   (then log out and back in)'))
        else:
            out.append(finding('ok', 'audio devices', f'{len(cards)} card(s) accessible by this account'))
    backend = 'alsa'
    for cfg in (env.at('/etc/whitecube/config'), env.home / '.config/whitecube/config'):
        try:
            for line in cfg.read_text(encoding='utf-8', errors='replace').splitlines():
                stripped = line.strip()
                if stripped.startswith('#'):
                    continue
                k, sep, v = stripped.partition('=')
                if sep and k.strip() == 'audio':
                    val = v.partition('#')[0].strip().lower()
                    if val in ('alsa', 'pipewire'):
                        backend = val
        except OSError:
            pass
    if backend == 'pipewire':
        ok = env.at('/usr/bin/pipewire').is_file() and os.access(env.at('/usr/bin/pipewire'), os.X_OK)
        out.append(finding('ok' if ok else 'WARN', 'audio backend',
                           'pipewire configured and installed' if ok else 'audio=pipewire configured, but /usr/bin/pipewire is missing',
                           '' if ok else 'sudo apt install pipewire wireplumber   (or set audio=alsa in config)'))
    else:
        candidates = (env.at('/usr/bin/cube-audio'), env.home / '.local/bin/cube-audio', env.project / 'build/cube-audio')
        ok = any(p.is_file() and os.access(p, os.X_OK) for p in candidates)
        out.append(finding('ok' if ok else 'WARN', 'audio backend',
                           'native ALSA backend (cube-audio) available' if ok else 'audio=alsa configured, but cube-audio is missing',
                           '' if ok else 'rebuild Whitecube or reinstall whitecube-desktop'))
    return out


def check_browser(env):
    """Verify Cube Browser binaries and Landlock/worker sandbox prerequisites."""
    candidates = [env.at('/usr/bin/whitecube-browser')]
    if env.root == Path('/'):
        candidates.extend([
            env.home / '.local/bin/cube-browser',
            env.project / 'build/cube-browser/cube-browser',
            env.project / 'apps/cube-browser/build/cube-browser',
        ])
    browser = next((p for p in candidates if p.is_file() or p.is_symlink()), None)
    if browser is None:
        return [finding('info', 'browser', 'cube-browser is not installed or built in this environment',
                        'build apps/cube-browser or install whitecube-desktop')]
    if env.root != Path('/'):
        libexec = env.at('/usr/libexec/whitecube/cube-browser')
        workers_ok = all((libexec / name).is_file() and os.access(libexec / name, os.X_OK)
                         for name in ('cube-browser', 'cube-renderd', 'cube-netd'))
        if not workers_ok:
            return [finding('FAIL', 'browser', 'staged cube-browser workers missing or not executable',
                            'rebuild apps/cube-browser and re-run packaging/install-tree.sh')]
        return [finding('ok', 'browser', 'staged cube-browser and sandboxed workers present')]
    if not os.access(browser, os.X_OK):
        return [finding('WARN', 'browser', f'{browser} is not executable', f'chmod 0755 {browser}')]
    try:
        proc = subprocess.run([str(browser), '--check', '--json'], capture_output=True, text=True, timeout=5)
        data = json.loads(proc.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        return [finding('WARN', 'browser', f'could not query cube-browser diagnostics: {error}',
                        f'{browser} --check')]
    if data.get('ok'):
        return [finding('ok', 'browser',
                        f'cube-browser {data.get("version", "?")} ready (Landlock ABI {data.get("landlock_abi", "?")})')]
    issues = [name for name, ok in data.get('workers', {}).items() if not ok]
    if not data.get('ca_bundle'):
        issues.append('ca-certificates')
    if data.get('landlock_abi', -1) < 3:
        issues.append(f'landlock-abi={data.get("landlock_abi")}')
    return [finding('FAIL', 'browser',
                    'cube-browser check failed: ' + (', '.join(issues) or 'unknown issue'),
                    f'{browser} --check')]


def check_editor(env):
    """Report cube-editor launcher, runtime module, and ISO workflow readiness."""
    share_dir = env.at('/usr/share/whitecube/cube-editor')
    runtime_files = ('app.py', 'engine.py', 'worker.py', 'kernel.py', 'diagnostics.py')
    if env.root != Path('/'):
        launcher = env.at('/usr/bin/cube-editor')
        if not (launcher.is_file() or launcher.is_symlink()) and not share_dir.exists():
            return [finding('info', 'editor', 'cube-editor is not installed in this root',
                            'install whitecube-desktop')]
        missing = [name for name in runtime_files if not (share_dir / name).is_file()]
        if not (launcher.is_file() or launcher.is_symlink()) or not os.access(launcher, os.X_OK) or missing:
            detail = 'missing ' + ', '.join(missing) if missing else f'{launcher} missing or not executable'
            return [finding('FAIL', 'editor', f'staged cube-editor incomplete ({detail})',
                            're-run packaging/install-tree.sh')]
        return [finding('ok', 'editor', 'staged cube-editor launcher and runtime present')]
    candidates = [
        env.at('/usr/bin/cube-editor'),
        env.home / '.local/bin/cube-editor',
        env.project / 'bin/cube-editor',
    ]
    editor = next((p for p in candidates if p.is_file() or p.is_symlink()), None)
    if editor is None:
        return [finding('info', 'editor', 'cube-editor is not installed or checked out in this environment',
                        'install whitecube-desktop')]
    if not os.access(editor, os.X_OK):
        return [finding('WARN', 'editor', f'{editor} is not executable', f'chmod 0755 {editor}')]
    try:
        proc = subprocess.run([str(editor), '--cli', 'doctor'], capture_output=True, text=True, timeout=10)
        data = json.loads(proc.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        return [finding('WARN', 'editor', f'could not query cube-editor doctor: {error}',
                        f'{editor} --cli doctor')]
    if not isinstance(data, dict) or data.get('format') != 'cube-editor-diagnostics':
        return [finding('WARN', 'editor', 'cube-editor doctor returned unexpected JSON', f'{editor} --cli doctor')]
    checks = data.get('checks', [])
    failed = [c.get('id', '?') for c in checks if c.get('status') == 'fail']
    warns = [c.get('id', '?') for c in checks if c.get('status') == 'warning']
    if data.get('ready') and not failed:
        note = f' (optional warnings: {", ".join(warns)})' if warns else ''
        return [finding('ok', 'editor', f'cube-editor workstation checks ready{note}')]
    return [finding('FAIL', 'editor',
                    'cube-editor doctor failed: ' + (', '.join(failed) or 'unknown issue'),
                    f'{editor} --cli doctor')]


def check_trainer(env):
    """Report cube-train / whitecube-train launchers, runtime modules, and readiness."""
    share_dir = env.at('/usr/share/whitecube/cube-train')
    runtime_files = ('app.py', 'cli.py', 'engine.py', 'diagnostics.py', 'worker.py', 'pipeline/train_supervisor.py')
    if env.root != Path('/'):
        cube_train = env.at('/usr/bin/cube-train')
        cli_bin = env.at('/usr/bin/whitecube-train')
        has_any = any(p.is_file() or p.is_symlink() for p in (cube_train, cli_bin)) or share_dir.exists()
        if not has_any:
            return [finding('info', 'trainer', 'cube-train is not installed in this root',
                            'install whitecube-desktop')]
        missing = [name for name in runtime_files if not (share_dir / name).is_file()]
        bad_bins = [str(p) for p in (cube_train, cli_bin) if not (p.is_file() or p.is_symlink()) or not os.access(p, os.X_OK)]
        if bad_bins or missing:
            detail = 'missing ' + ', '.join(missing) if missing else 'missing/unexecutable ' + ', '.join(bad_bins)
            return [finding('FAIL', 'trainer', f'staged cube-train incomplete ({detail})',
                            're-run packaging/install-tree.sh')]
        return [finding('ok', 'trainer', 'staged cube-train launchers and pipeline present')]
    candidates = [
        env.at('/usr/bin/whitecube-train'),
        env.home / '.local/bin/whitecube-train',
        env.project / 'bin/whitecube-train',
    ]
    trainer_cli = next((p for p in candidates if p.is_file() or p.is_symlink()), None)
    if trainer_cli is None:
        return [finding('info', 'trainer', 'cube-train is not installed or checked out in this environment',
                        'install whitecube-desktop')]
    if not os.access(trainer_cli, os.X_OK):
        return [finding('WARN', 'trainer', f'{trainer_cli} is not executable', f'chmod 0755 {trainer_cli}')]
    try:
        proc = subprocess.run([str(trainer_cli), '--doctor', '--json'], capture_output=True, text=True, timeout=10)
        data = json.loads(proc.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        return [finding('WARN', 'trainer', f'could not query whitecube-train doctor: {error}',
                        f'{trainer_cli} --doctor')]
    if not isinstance(data, dict) or 'checks' not in data or 'version' not in data:
        return [finding('WARN', 'trainer', 'whitecube-train --doctor returned unexpected JSON',
                        f'{trainer_cli} --doctor')]
    checks = {item.get('id'): item for item in data.get('checks', []) if isinstance(item, dict)}
    hard_errors = [cid for cid in ('desktop', 'output') if checks.get(cid, {}).get('status') == 'error']
    if hard_errors:
        return [finding('FAIL', 'trainer', 'whitecube-train readiness failed: ' + ', '.join(hard_errors),
                        f'{trainer_cli} --doctor')]
    warns = [item.get('id', '?') for item in data.get('checks', [])
             if isinstance(item, dict) and item.get('status') in ('warning', 'error')]
    note = f' (pending setup: {", ".join(warns)})' if warns else ''
    return [finding('ok', 'trainer', f'whitecube-train {data["version"]} diagnostics reachable{note}')]


def check_vm(env):
    """Report cube-strap / whitecube-vm launchers, runtime modules, and QEMU/OVMF readiness."""
    share_dir = env.at('/usr/share/whitecube/cube-strap')
    runtime_files = ('app.py', 'strap.py', 'deb-strap.sh')
    if env.root != Path('/'):
        cube_strap = env.at('/usr/bin/cube-strap')
        vm_cli = env.at('/usr/bin/whitecube-vm')
        builder = env.at('/usr/libexec/whitecube/cube-strap-build')
        bins = (cube_strap, vm_cli, builder)
        has_any = any(p.is_file() or p.is_symlink() for p in bins) or share_dir.exists()
        if not has_any:
            return [finding('info', 'vm', 'cube-strap is not installed in this root',
                            'install whitecube-desktop')]
        missing = [name for name in runtime_files if not (share_dir / name).is_file()]
        bad_bins = [str(p) for p in bins if not (p.is_file() or p.is_symlink()) or not os.access(p, os.X_OK)]
        if bad_bins or missing:
            detail = 'missing ' + ', '.join(missing) if missing else 'missing/unexecutable ' + ', '.join(bad_bins)
            return [finding('FAIL', 'vm', f'staged cube-strap incomplete ({detail})',
                            're-run packaging/install-tree.sh')]
        return [finding('ok', 'vm', 'staged cube-strap / whitecube-vm launchers and runtime present')]
    candidates = [
        env.at('/usr/bin/whitecube-vm'),
        env.home / '.local/bin/whitecube-vm',
        env.project / 'bin/whitecube-vm',
    ]
    vm_cli = next((p for p in candidates if p.is_file() or p.is_symlink()), None)
    if vm_cli is None:
        return [finding('info', 'vm', 'whitecube-vm is not installed or checked out in this environment',
                        'install whitecube-desktop')]
    if not os.access(vm_cli, os.X_OK):
        return [finding('WARN', 'vm', f'{vm_cli} is not executable', 'ensure executable permissions on whitecube-vm')]
    try:
        proc = subprocess.run([str(vm_cli), 'check', '--json'], capture_output=True, text=True, timeout=5)
        data = json.loads(proc.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        return [finding('WARN', 'vm', f'could not query whitecube-vm check: {error}',
                        f'{vm_cli} check')]
    if not isinstance(data, dict) or 'ready' not in data:
        return [finding('WARN', 'vm', 'whitecube-vm check returned unexpected JSON', f'{vm_cli} check')]
    if data.get('ready'):
        accel = 'KVM enabled' if data.get('kvm') else 'software emulation'
        return [finding('ok', 'vm', f'whitecube-vm QEMU/OVMF ready ({accel})')]
    missing_pkgs = [item.get('package', item.get('component', '?')) for item in data.get('missing', []) if isinstance(item, dict)]
    pkg_hint = 'sudo apt install ' + ' '.join(missing_pkgs) if missing_pkgs else f'{vm_cli} check'
    return [finding('WARN', 'vm',
                    'whitecube-vm missing runtime dependencies: ' + (', '.join(missing_pkgs) or 'qemu/ovmf'),
                    pkg_hint)]


def check_chrootables(env):
    """Report cube-chrootables launcher, runtime modules, and chrootable-manager readiness."""
    share_dir = env.at('/usr/share/whitecube/chrootables')
    runtime_files = (
        'app.py', 'backend.py', 'broker.py', 'assets/demo.json',
        'chrootables/__init__.py', 'chrootables/app.py', 'chrootables/authenticate.py',
        'chrootables/backend.py', 'chrootables/broker.py', 'chrootables/capture.py',
        'chrootables/client.py', 'chrootables/paths.py', 'chrootables/style.py',
        'chrootables/terminal.py',
    )
    if env.root != Path('/'):
        launcher = env.at('/usr/bin/cube-chrootables')
        cli_bin = env.at('/usr/bin/whitecube-chrootable-manager')
        helper = env.at('/usr/libexec/whitecube/chrootable-manager')
        bins = (launcher, cli_bin, helper)
        has_any = any(p.is_file() or p.is_symlink() for p in bins) or share_dir.exists()
        if not has_any:
            return [finding('info', 'chrootables', 'cube-chrootables is not installed in this root',
                            'install whitecube-desktop')]
        missing = [name for name in runtime_files if not (share_dir / name).is_file()]
        bad_bins = [str(p) for p in bins if not (p.is_file() or p.is_symlink()) or not os.access(p, os.X_OK)]
        if bad_bins or missing:
            detail = 'missing ' + ', '.join(missing) if missing else 'missing/unexecutable ' + ', '.join(bad_bins)
            return [finding('FAIL', 'chrootables', f'staged cube-chrootables incomplete ({detail})',
                            're-run packaging/install-tree.sh')]
        return [finding('ok', 'chrootables', 'staged cube-chrootables launcher, helper, and runtime present')]
    candidates = [
        env.at('/usr/bin/whitecube-chrootable-manager'),
        env.home / '.local/bin/whitecube-chrootable-manager',
        env.project / 'apps/chrootables/chrootable-manager',
    ]
    mgr = next((p for p in candidates if p.is_file() or p.is_symlink()), None)
    if mgr is None:
        return [finding('info', 'chrootables', 'whitecube-chrootable-manager is not installed or checked out in this environment',
                        'install whitecube-desktop')]
    if not os.access(mgr, os.X_OK):
        return [finding('WARN', 'chrootables', f'{mgr} is not executable', 'ensure executable permissions on chrootable-manager')]
    try:
        proc = subprocess.run([str(mgr), '--doctor', '--json'], capture_output=True, text=True, timeout=10)
        data = json.loads(proc.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        return [finding('WARN', 'chrootables', f'could not query whitecube-chrootable-manager --doctor: {error}',
                        f'{mgr} --doctor')]
    if not isinstance(data, dict) or data.get('schema_version') != 1 or not isinstance(data.get('checks'), list):
        return [finding('WARN', 'chrootables', 'whitecube-chrootable-manager --doctor returned unexpected JSON', f'{mgr} --doctor')]
    errors = [c.get('id', '?') for c in data['checks'] if isinstance(c, dict) and c.get('status') == 'error']
    warns = [c.get('id', '?') for c in data['checks'] if isinstance(c, dict) and c.get('status') == 'warning']
    if data.get('ready') and not errors:
        note = f' (optional warnings: {", ".join(warns)})' if warns else ''
        return [finding('ok', 'chrootables', f'whitecube-chrootable-manager {data.get("version", "?")} host readiness ok{note}')]
    return [finding('WARN', 'chrootables',
                    'whitecube-chrootable-manager pending host checks: ' + (', '.join(errors) or 'unknown issue'),
                    f'{mgr} --doctor')]


