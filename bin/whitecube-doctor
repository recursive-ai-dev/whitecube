#!/usr/bin/python3 -I
"""whitecube-doctor: read-only health report for the Whitecube desktop. Changes nothing, needs no root.

  whitecube-doctor            human-readable report; exit status 1 if anything FAILs
  whitecube-doctor --json     the same findings as JSON
  whitecube-doctor --project DIR   compare installed files with the sources in DIR
  whitecube-doctor --check package --strict   fail on package warnings too
  whitecube-doctor --list-checks    list the selectable check groups

Each finding is ok / info / WARN / FAIL with the command that would fix it. It looks at the facts that
caused real trouble here: the firewall's output policy, competing network managers, the Wi-Fi
controller's state, wpa_supplicant leftovers, installed copies that lag the source, and over-broad
passwordless sudo.
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shlex
import stat
import subprocess
import sys
import time

LEVELS = ('ok', 'info', 'WARN', 'FAIL')
CHECK_GROUPS = ('package', 'network', 'drift', 'security', 'libraries', 'session', 'folders')


def sha(path):
    try:
        return hashlib.sha256(Path(path).read_bytes()).hexdigest()
    except OSError:
        return None


def finding(level, name, detail='', fix=''):
    return {'level': level, 'name': name, 'detail': detail, 'fix': fix}


class Env:
    def __init__(self, project, root=Path('/'), home=None):
        self.project, self.root = Path(project), Path(root)
        self.home = Path(home) if home else Path.home()

    @property
    def packaged(self):
        return any(self.at(name).exists() for name in
                   ('/usr/bin/whitecube-compositor', '/usr/share/wayland-sessions/whitecube.desktop',
                    '/var/lib/dpkg/info/whitecube-desktop.list'))

    def at(self, absolute):
        return self.root / str(absolute).lstrip('/')


def load_cube_net(env):
    for candidate in (env.project / 'net/cube-net', env.at('/usr/bin/cube-net')):
        if candidate.is_file():
            loader = importlib.machinery.SourceFileLoader('cube_net_for_doctor', str(candidate))
            spec = importlib.util.spec_from_loader('cube_net_for_doctor', loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            return module
    return None


# ---- checks: each returns a list of findings

def check_firewall(env):
    ufw = env.at('/etc/default/ufw')
    conf = env.at('/etc/ufw/ufw.conf')
    try:
        text = ufw.read_text()
    except OSError:
        return [finding('info', 'firewall', 'ufw is not configured here')]
    policy = re.search(r'^\s*DEFAULT_OUTPUT_POLICY\s*=\s*["\']?(\w+)', text, re.M)
    enabled = re.search(r'^\s*ENABLED\s*=\s*(\w+)', conf.read_text() if conf.is_file() else '', re.M)
    on = bool(enabled and enabled.group(1).lower() == 'yes')
    output = policy.group(1).upper() if policy else 'unknown'
    if on and output in ('DROP', 'REJECT'):
        return [finding('FAIL', 'firewall output policy', f'ufw is on and outgoing is {output}: DNS, web, NTP and DHCP renewals are blocked',
                        'sudo ufw default allow outgoing')]
    if output in ('DROP', 'REJECT'):
        return [finding('WARN', 'firewall output policy', f'ufw is off but would drop outgoing ({output}) the moment it is enabled',
                        'sudo ufw default allow outgoing   (before enabling ufw)')]
    return [finding('ok', 'firewall output policy', f'ufw {"on" if on else "off"}, outgoing {output}')]


def check_network(env, net):
    out = []
    if net is None:
        return [finding('WARN', 'wifi controller', 'cube-net is not installed and not in the source tree')]
    status_file = env.at('/run/whitecube-net/status.json')
    try:
        raw = json.loads(status_file.read_text())
        age = time.time() - float(raw.get('updated_epoch', 0))
    except (OSError, ValueError, TypeError):
        return [finding('WARN', 'wifi controller', 'no status published: the whitecube-network service is not running',
                        'sudo systemctl status whitecube-network.service')]
    if age > 15:
        return [finding('FAIL', 'wifi controller', f'status is {int(age)} s old: the service is stuck or stopped',
                        'journalctl -u whitecube-network.service -b | tail -40')]
    state = raw.get('association_state')
    code = None
    try:
        data = net.status(env.root.resolve() if env.root != Path('/') else Path('/'))
        code = data.get('diagnostic_code')
    except Exception:  # a doctor must not crash on the thing it diagnoses
        pass
    level = 'ok' if state == 'COMPLETED' and raw.get('dns_ok') is not False and raw.get('connectivity_ok') is not False else 'WARN'
    out.append(finding(level, 'wifi controller', f'{state}, signal {raw.get("signal_dbm")} dBm, ip {raw.get("ipv4_address")}'
                       + (f', diagnosis {code}' if code else ''), '' if level == 'ok' else 'cube-net status   (diagnostic_summary says what is wrong)'))
    return out


def check_competitors(env, net):
    if net is None:
        return []
    found = net.competing_processes('', env.at('/proc'))
    rivals = [name for name in found if name != 'dhcpcd']
    if rivals:
        return [finding('WARN', 'competing network managers', 'running: ' + ', '.join(rivals) + '; cube-net refuses to start next to them',
                        'stop them before restarting whitecube-network.service')]
    return [finding('ok', 'competing network managers', 'none running')]


def check_wpa_leftovers(env):
    present = [name for name in ('wpa_supplicant', 'wpa_cli') if env.at(f'/usr/sbin/{name}').is_file()]
    if present:
        return [finding('info', 'wpa_supplicant', 'still installed but unused since cube-net revision 3; remove once the built-in station has proven itself',
                        'sudo apt purge wpasupplicant && sudo apt autoremove')]
    return [finding('ok', 'wpa_supplicant', 'not installed (the built-in station is the only Wi-Fi supplicant)')]


def install_map(env):
    p, h = env.project, env.home
    if env.packaged:
        # Packaged installations deliberately use different compositor/unit paths.
        # Config and skel files are user choices, not stale program copies.
        pairs = [('net/cube-net', '/usr/bin/cube-net'),
                 ('net/cube-net-dns', '/usr/libexec/whitecube/cube-net-dns'),
                 ('net/whitecube-network.service', '/usr/lib/systemd/system/whitecube-network.service'),
                 ('libexec/cube-settings-helper', '/usr/libexec/whitecube/cube-settings-helper'),
                 ('build/whitecube', '/usr/bin/whitecube-compositor')]
        pairs += [('build/' + name, '/usr/bin/' + name)
                  for name in ('cube-ca', 'cube-settings', 'cube-status')]
        pairs += [('bin/' + name, '/usr/bin/' + name)
                  for name in ('cube-privacy', 'whitecube-session', 'whitecube-doctor')]
        return [(p / src, env.at(dst),
                 'rebuild the Debian package from the source tree, then install the printed .deb with sudo apt install')
                for src, dst in pairs]
    pairs = [('net/cube-net', '/usr/bin/cube-net'), ('net/cube-net-dns', '/usr/libexec/whitecube/cube-net-dns'),
             ('net/dhcpcd.conf', '/etc/whitecube/network/dhcpcd.conf'),
             ('net/whitecube-network.service', '/etc/systemd/system/whitecube-network.service'),
             ('libexec/cube-settings-helper', '/usr/libexec/whitecube/cube-settings-helper')]
    result = [(p / src, env.at(dst), f'sudo bash {p}/net/apply.sh --apply') for src, dst in pairs]
    for name in ('whitecube', 'cube-settings', 'cube-status'):
        result.append((p / 'build' / name, h / '.local/bin' / name, f'{p}/BUILD.sh && python3 {p}/tools/INSTALL-USER.py --apply'))
    for name in ('cube-privacy', 'whitecube-session'):
        result.append((p / 'bin' / name, h / '.local/bin' / name, f'python3 {p}/tools/INSTALL-USER.py --apply'))
    result.append((p / 'data/foot.ini', h / '.config/foot/foot.ini', f'cp {p}/data/foot.ini ~/.config/foot/foot.ini'))
    return result


def check_drift(env):
    stale, missing, fixes = [], [], []
    compared = 0
    for source, installed, fix in install_map(env):
        mine = sha(source)
        if mine is None:
            continue                                        # not built yet: nothing to compare against
        compared += 1
        theirs = sha(installed)
        if theirs is None:
            missing.append(installed.name)
        elif theirs != mine:
            stale.append(installed.name)
        else:
            continue
        if fix not in fixes:
            fixes.append(fix)
    if not compared:
        return [finding('info', 'installed copies', 'source tree unavailable; source comparison skipped',
                        'whitecube-doctor --project /path/to/whitecube --check drift')]
    if not stale and not missing:
        return [finding('ok', 'installed copies', 'every installed file matches the source')]
    detail = '; '.join(part for part in (('differs from source: ' + ', '.join(stale)) if stale else '',
                                         ('not installed: ' + ', '.join(missing)) if missing else '') if part)
    return [finding('WARN', 'installed copies', detail + ' (installs need your sudo; the doctor never installs)', ' ; '.join(fixes))]


def check_sudoers(env):
    candidates = [env.at('/etc/sudoers.d/whitecube-settings')]
    if not env.packaged:
        candidates.append(env.project / 'data/sudoers/whitecube-settings')
    for candidate in candidates:
        try:
            text = candidate.read_text()
        except OSError:
            continue
        broad = re.findall(r'^%(\w+)\s+ALL=\(root\)\s+NOPASSWD:', text, re.M)
        if broad:
            return [finding('info', 'passwordless sudo', f'group %{broad[0]} may run the settings helper actions in CUBE_FREE without a password; '
                            'any process running as you can use them (add a Wi-Fi network, power off)',
                            f'review {env.project}/data/sudoers/whitecube-settings.hardened')]
        return [finding('ok', 'passwordless sudo', 'no group-wide NOPASSWD rule')]
    return [finding('info', 'passwordless sudo', 'sudoers rule file not found')]


def check_xfree(env):
    """libX11/libxcb in the installed desktop binaries means the distro cairo is in use (policy: X-free)."""
    linked = []
    uninspected = []
    for name in ('whitecube-compositor' if env.packaged else 'whitecube', 'cube-ca', 'cube-settings', 'cube-status'):
        binary = env.at('/usr/bin/' + name) if env.packaged else env.home / '.local/bin' / name
        if not binary.is_file():
            continue
        try:
            done = subprocess.run(['/usr/bin/ldd', str(binary)], capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            uninspected.append(name)
            continue
        if re.search(r'libX11|libxcb', done.stdout):
            linked.append(name)
        elif done.returncode:
            uninspected.append(name)
    out = []
    if linked:
        out.append(finding('WARN', 'x11 libraries', 'linked into ' + ', '.join(linked) + ' through the distro cairo',
                        ('reinstall the Whitecube Debian package and check /etc/ld.so.conf.d/whitecube.conf' if env.packaged else
                         f'{env.project}/tools/build-xfree-cairo.sh   (then the sudo cp it prints; no rebuild needed)')))
    if uninspected:
        out.append(finding('WARN', 'x11 libraries', 'could not inspect ' + ', '.join(uninspected),
                           'run whitecube-doctor --check package to inspect installed runtime files'))
    return out or [finding('ok', 'x11 libraries', 'none linked into the installed desktop binaries')]


def check_session(env):
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    wayland = os.environ.get('XDG_SESSION_TYPE') == 'wayland'
    out = []
    if os.environ.get('DISPLAY'):
        out.append(finding('WARN', 'x11', 'DISPLAY is set; the desktop is Wayland-only', 'unset DISPLAY'))
    if not runtime:
        out.append(finding('FAIL' if wayland else 'info', 'session',
                           'XDG_RUNTIME_DIR is not set' + (' in a Wayland session' if wayland else ' (not in a desktop session)'),
                           'start Whitecube through whitecube-session' if wayland else ''))
        return out
    path = Path(runtime)
    try:
        attrs = path.lstat()
    except OSError as error:
        out.append(finding('FAIL', 'runtime directory', f'{runtime}: {error.strerror}',
                           'log out and start Whitecube through whitecube-session'))
        return out
    if not path.is_absolute() or not stat.S_ISDIR(attrs.st_mode) or attrs.st_uid != os.getuid() or stat.S_IMODE(attrs.st_mode) != 0o700:
        out.append(finding('FAIL', 'runtime directory',
                           f'{runtime} must be a real absolute directory (no symlinks) owned by this account with mode 0700',
                           'log out and start Whitecube through whitecube-session'))
        return out
    out.append(finding('ok', 'runtime directory', 'private runtime directory owned by this account'))
    display = os.environ.get('WAYLAND_DISPLAY')
    if display:
        socket = Path(display) if os.path.isabs(display) else path / display
        try:
            is_socket = stat.S_ISSOCK(socket.stat().st_mode)
        except OSError:
            is_socket = False
        out.append(finding('ok' if is_socket else 'WARN', 'Wayland display',
                           f'{display}: ' + ('socket exists' if is_socket else 'no Wayland socket; the compositor may have stopped'),
                           '' if is_socket else 'inspect ~/.local/state/whitecube/session.log'))
    elif wayland:
        out.append(finding('WARN', 'Wayland display', 'WAYLAND_DISPLAY is not set in this Wayland session',
                           'open a terminal inside the Whitecube session and rerun whitecube-doctor'))
    return out


def check_package(env):
    """Report broken startup paths before the user attempts their next login."""
    if not env.packaged:
        return [finding('info', 'package files', 'Whitecube Debian package is not installed')]
    executables = ('/usr/bin/whitecube-compositor', '/usr/bin/whitecube-session',
                   '/usr/bin/cube-status', '/usr/bin/cube-settings', '/usr/bin/cube-ca',
                   '/usr/bin/whitecube-terminal', '/usr/bin/desktop-chat',
                   '/usr/libexec/whitecube/cube-settings-helper',
                   '/usr/lib/whitecube/desktop-chat-runtime/electron')
    data = ('/usr/share/wayland-sessions/whitecube.desktop',
            '/usr/share/whitecube/schemas/gschemas.compiled', '/etc/whitecube/config',
            '/usr/share/whitecube/desktop-chat/main.js')
    broken = [name for name in executables if not env.at(name).is_file() or not os.access(env.at(name), os.X_OK)]
    broken += [name for name in data if not env.at(name).is_file()]
    remedy = 'sudo apt install --reinstall whitecube-desktop'
    out = [finding('FAIL' if broken else 'ok', 'package files',
                   'missing or unusable: ' + ', '.join(broken) if broken else 'desktop startup files and Chat runtime are present',
                   remedy if broken else '')]
    # ldd is bounded and only runs on the installed, known desktop binaries.
    missing = []
    runtime_binaries = [(name, '/usr/bin/' + name)
                        for name in ('whitecube-compositor', 'cube-status', 'cube-settings', 'cube-ca')]
    runtime_binaries.append(('desktop-chat', '/usr/lib/whitecube/desktop-chat-runtime/electron'))
    for name, path in runtime_binaries:
        binary = env.at(path)
        if not binary.is_file():
            continue
        try:
            done = subprocess.run(['/usr/bin/ldd', str(binary)], capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError) as error:
            out.append(finding('WARN', 'runtime libraries', f'could not inspect {name}: {type(error).__name__}'))
            continue
        libraries = re.findall(r'^\s*(\S+)\s+=>\s+not found', done.stdout, re.M)
        missing.extend(name + ': ' + lib for lib in libraries)
        if done.returncode and not libraries:
            out.append(finding('WARN', 'runtime libraries',
                               f'could not inspect {name}: ldd exited with status {done.returncode}', remedy))
    if missing:
        out.append(finding('FAIL', 'runtime libraries', '; '.join(missing),
                           'sudo apt --fix-broken install; then reinstall whitecube-desktop'))
    return out


def check_shadowing(env):
    """Once the package is installed, older per-user or /usr/local copies would still win on PATH."""
    if not env.at('/usr/bin/whitecube-compositor').exists():
        return []
    names = ('whitecube', 'cube-status', 'cube-settings', 'cube-ca', 'cube-net', 'whitecube-session', 'whitecube-terminal', 'desktop-chat')
    stale = [str(d / n).replace(str(env.home), '~') for d in (env.home / '.local/bin', env.at('/usr') / 'local/bin') for n in names if (d / n).exists()]
    if not stale:
        return [finding('ok', 'package', 'no older copies shadow the installed package')]
    return [finding('WARN', 'package', f'{len(stale)} older copies shadow /usr/bin: ' + ', '.join(stale[:4]) + (' ...' if len(stale) > 4 else ''),
                    'sudo whitecube-migrate (dry run), then sudo whitecube-migrate --apply')]


def folder_handler(env):
    """The default app for inode/directory per the mimeapps.list search order, and its .desktop file."""
    lists = [env.home / '.config/mimeapps.list', env.at('/etc/xdg/mimeapps.list'),
             env.home / '.local/share/applications/mimeapps.list', env.at('/usr/share/applications/mimeapps.list')]
    for path in lists:
        try:
            lines = path.read_text(errors='replace').splitlines()
        except OSError:
            continue
        section = ''
        for line in lines:
            line = line.strip()
            if line.startswith('['):
                section = line
            elif section == '[Default Applications]' and line.startswith('inode/directory='):
                for name in filter(None, line.split('=', 1)[1].split(';')):
                    for folder in (env.home / '.local/share/applications', env.at('/usr/share/applications')):
                        if (folder / name).is_file():
                            return name, folder / name
                    return name, None
    return None, None


def check_folder_handler(env):
    """Apps open folders through xdg-open/GIO; a missing default sends 'Open folder' nowhere."""
    name, desktop = folder_handler(env)
    if not name:
        return [finding('WARN', 'folders', 'no default app for folders (inode/directory)',
                        'xdg-mime default thunar.desktop inode/directory')]
    if desktop is None:
        return [finding('WARN', 'folders', f'the default folder app {name} is not installed',
                        'xdg-mime default thunar.desktop inode/directory')]
    command = ''
    for line in desktop.read_text(errors='replace').splitlines():
        if line.startswith('Exec='):
            raw = line[5:].strip()
            try:
                tokens = shlex.split(raw)
            except ValueError:
                tokens = raw.split()
            if tokens and tokens[0] in ('env', '/usr/bin/env'):
                tokens = tokens[1:]
                while tokens and '=' in tokens[0] and not tokens[0].startswith(('/', '-')):
                    tokens = tokens[1:]
            command = tokens[0] if tokens else ''
            break
    found = command and (env.at(command).is_file() if command.startswith('/') else
                         any((d / command).is_file() for d in (env.at('/usr/bin'), env.at('/usr') / 'local/bin', env.at('/bin'))))
    if not found:
        return [finding('WARN', 'folders', f'{name} runs {command or "nothing"}, which is not installed',
                        f'reinstall it, or pick another: xdg-mime default APP.desktop inode/directory')]
    return [finding('ok', 'folders', f'folders open with {name}')]


def run_checks(env, selected=None):
    selected = set(selected or CHECK_GROUPS)
    results = []
    net = None
    if 'network' in selected:
        try:
            net = load_cube_net(env)
        except Exception as error:
            results.append(finding('WARN', 'wifi controller', f'cannot load cube-net: {type(error).__name__}: {error}'))
    groups = {
        'package': (lambda: check_package(env), lambda: check_shadowing(env)),
        'network': (lambda: check_firewall(env), lambda: check_network(env, net),
                    lambda: check_competitors(env, net), lambda: check_wpa_leftovers(env)),
        'drift': (lambda: check_drift(env),),
        'security': (lambda: check_sudoers(env),),
        'libraries': (lambda: check_xfree(env),),
        'session': (lambda: check_session(env),),
        'folders': (lambda: check_folder_handler(env),),
    }
    for name, checks in groups.items():
        if name not in selected:
            continue
        for check in checks:
            try:
                results.extend(check())
            except Exception as error:  # one broken check must not hide the others
                results.append(finding('WARN', 'doctor', f'{name} check crashed: {type(error).__name__}: {error}'))
    return results


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--project', type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument('--check', action='append', choices=CHECK_GROUPS, help='run only this group; repeat to select several')
    parser.add_argument('--list-checks', action='store_true', help='list check groups and exit')
    parser.add_argument('--strict', action='store_true', help='exit 1 on WARN as well as FAIL')
    args = parser.parse_args(argv)
    if args.list_checks:
        print(json.dumps(list(CHECK_GROUPS)) if args.json else '\n'.join(CHECK_GROUPS))
        return 0
    results = run_checks(Env(args.project), args.check)
    if args.json:
        print(json.dumps(results, indent=2))
    else:
        for item in results:
            print(f'{item["level"]:<4} {item["name"]}: {item["detail"]}')
            if item['fix'] and item['level'] != 'ok':
                print(f'     fix: {item["fix"]}')
        counts = {level: sum(item['level'] == level for item in results) for level in LEVELS}
        print(f"\n{counts['FAIL']} failed, {counts['WARN']} warnings, {counts['ok']} passed, {counts['info']} informational")
    failing = ('FAIL', 'WARN') if args.strict else ('FAIL',)
    return 1 if any(item['level'] in failing for item in results) else 0


if __name__ == '__main__':
    sys.exit(main())
