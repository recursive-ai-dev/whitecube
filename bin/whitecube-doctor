        note = f' (optional warnings: {", ".join(warns)})' if warns else ''
        return [finding('ok', 'prompts', f'cube-prompts {data.get("version", "?")} SQLite {data.get("sqlite_version", "?")} ready{note}')]
    return [finding('FAIL', 'prompts',
                    'cube-prompts check failed: ' + (', '.join(errors) or 'unknown issue'),
                    f'{prompts_bin} --cli doctor')]


def check_chat(env):
    """Report desktop-chat launcher, runtime files, and headless CLI diagnostics."""
    share_dir = env.at('/usr/share/whitecube/desktop-chat')
    runtime_dir = env.at('/usr/lib/whitecube/desktop-chat-runtime')
    runtime_files = (
        'desktop-chat.sh',
        'main.js',
        'src/cli.js',
        'src/config.js',
        'src/history.js',
        'src/tools.js',
    )
    if env.root != Path('/'):
        launcher = env.at('/usr/bin/desktop-chat')
        has_any = (launcher.is_file() or launcher.is_symlink()) or share_dir.exists() or runtime_dir.exists()
        if not has_any:
            return [finding('info', 'chat', 'desktop-chat is not installed in this root',
                            'install whitecube-desktop')]
        missing = [name for name in runtime_files if not (share_dir / name).is_file()]
        electron_bin = runtime_dir / 'electron'
        if not electron_bin.is_file() or not os.access(electron_bin, os.X_OK):
            missing.append('desktop-chat-runtime/electron')
        if not (launcher.is_file() or launcher.is_symlink()) or not os.access(launcher, os.X_OK) or missing:
            detail = 'missing ' + ', '.join(missing) if missing else f'{launcher} missing or not executable'
            return [finding('FAIL', 'chat', f'staged desktop-chat incomplete ({detail})',
                            're-run packaging/install-tree.sh')]
        return [finding('ok', 'chat', 'staged desktop-chat launcher, runtime, and Electron bundle present')]

    candidates = [
        env.at('/usr/bin/desktop-chat'),
        env.home / '.local/bin/desktop-chat',
        env.project / 'apps/desktop-chat/desktop-chat.sh',
    ]
    chat_bin = next((p for p in candidates if p.is_file() or p.is_symlink()), None)
    if chat_bin is None:
        return [finding('info', 'chat', 'desktop-chat is not installed or checked out in this environment',
                        'install whitecube-desktop')]
    if not os.access(chat_bin, os.X_OK):
        return [finding('WARN', 'chat', f'{chat_bin} is not executable', 'ensure executable permissions on desktop-chat')]
    sub_env = dict(os.environ)
    sub_env['HOME'] = str(env.home)
    try:
        proc = subprocess.run([str(chat_bin), '--cli', 'doctor', '--json'], capture_output=True, text=True, timeout=5, env=sub_env)
        data = json.loads(proc.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        return [finding('WARN', 'chat', f'could not query desktop-chat --cli doctor: {error}',
                        f'{chat_bin} --cli doctor')]
    if not isinstance(data, dict) or 'config' not in data or 'conversations' not in data:
        return [finding('WARN', 'chat', 'desktop-chat --cli doctor returned unexpected JSON', f'{chat_bin} --cli doctor')]
    if not data.get('ok'):
        detail = data.get('config', {}).get('error') or data.get('conversations', {}).get('error') or 'configuration/history error'
        return [finding('FAIL', 'chat', f'desktop-chat check failed: {detail}', f'{chat_bin} --cli doctor')]
    conv_count = data.get('conversations', {}).get('count', 0)
    ckpt_count = data.get('checkpoints', {}).get('count', 0)
    return [finding('ok', 'chat',
                    f'desktop-chat {data.get("version", "?")} ready ({conv_count} conversations, {ckpt_count} checkpoints)')]


def check_suite(env):
    """Report wc-suite wrappers, shell completions, and cube-apps utilities readiness."""
    if env.root != Path('/'):
        staged_execs = (
            '/usr/bin/wc-help',
            '/usr/bin/wc-doctor',
            '/usr/bin/wc-ls',
            '/usr/bin/cube-hash',
            '/usr/bin/cube-lock',
            '/usr/bin/cube-pdf',
            '/usr/bin/cube-rename',
        )
        staged_files = (
            '/usr/lib/wc-suite/wc_suite.py',
            '/usr/share/bash-completion/completions/wc-help',
            '/usr/share/zsh/vendor-completions/_wc',
            '/usr/share/whitecube/cube-apps/cube_theme.py',
            '/usr/share/whitecube/cube-apps/cube_hash.py',
        )
        present_any = any(
            (env.at(p).is_file() or env.at(p).is_symlink())
            for p in (*staged_execs, *staged_files)
        )
        if not present_any:
            return [finding('info', 'suite', 'wc-suite and cube-apps are not installed in this root',
                            'install whitecube-desktop')]
        missing = [
            p for p in staged_execs
            if not (env.at(p).is_file() or env.at(p).is_symlink()) or not os.access(env.at(p), os.X_OK)
        ] + [
            p for p in staged_files
            if not env.at(p).is_file()
        ]
        if missing:
            return [finding('FAIL', 'suite', f'staged wc-suite / cube-apps incomplete (missing {", ".join(missing)})',
                            're-run packaging/install-tree.sh')]
        return [finding('ok', 'suite', 'staged wc-suite wrappers, completions, and cube-apps utilities present')]

    wc_doctor = next(
        (p for p in (env.at('/usr/bin/wc-doctor'), env.home / '.local/bin/wc-doctor') if p.is_file() and os.access(p, os.X_OK)),
        None,
    )
    if wc_doctor is not None:
        cmd = [str(wc_doctor), '--json']
    elif (env.project / 'apps/wc-suite/wc_suite.py').is_file():
        cmd = [sys.executable, '-I', str(env.project / 'apps/wc-suite/wc_suite.py'), 'doctor', '--json']
    else:
        return [finding('info', 'suite', 'wc-suite is not installed or checked out in this environment',
                        'install whitecube-desktop')]
    sub_env = dict(os.environ)
    sub_env['HOME'] = str(env.home)
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=5, env=sub_env)
        data = json.loads(proc.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        return [finding('WARN', 'suite', f'could not query wc-doctor --json: {error}', 'wc-doctor')]
    if not isinstance(data, dict) or 'version' not in data or 'tools' not in data:
        return [finding('WARN', 'suite', 'wc-doctor --json returned unexpected output', 'wc-doctor')]
    missing_wrappers = data.get('missing_wrappers') or []
    cube_ready = all(
        (env.at(f'/usr/bin/{name}').is_file() and os.access(env.at(f'/usr/bin/{name}'), os.X_OK))
        or (env.home / '.local/bin' / name).is_file()
        or (env.project / 'apps/cube-apps' / f'{name.replace("-", "_")}.py').is_file()
        for name in ('cube-hash', 'cube-lock', 'cube-pdf', 'cube-rename')
    )
    if missing_wrappers and wc_doctor is not None:
        return [finding('WARN', 'suite', f'wc-suite {data.get("version")} missing wrappers: {", ".join(missing_wrappers)}',
                        'reinstall whitecube-desktop or wc-suite')]
    note = '' if cube_ready else ' (cube-apps launchers unavailable)'
    return [finding('ok', 'suite', f'wc-suite {data.get("version")} ready ({len(data.get("tools", {}))} tool groups){note}')]


def run_checks(env, selected=None):
    selected = set(selected or CHECK_GROUPS)
    results = []
    net = None
    if 'network' in selected:
        try:
            net = load_cube_net(env)
        except Exception as error:
            results.append(finding('WARN', 'wifi controller', f'cannot load cube-net: {type(error).__name__}: {error}'))
    groups = {
        'package': (lambda: check_package(env), lambda: check_shadowing(env)),
        'network': (lambda: check_firewall(env), lambda: check_network(env, net), lambda: check_dns_lease(env),
                    lambda: check_lockdown(env), lambda: check_competitors(env, net), lambda: check_wpa_leftovers(env)),
        'drift': (lambda: check_drift(env),),
        'security': (lambda: check_sudoers(env),),
        'libraries': (lambda: check_xfree(env),),
        'session': (lambda: check_session(env),),
        'folders': (lambda: check_folder_handler(env),),
        'audio': (lambda: check_audio(env),),
        'browser': (lambda: check_browser(env),),
        'editor': (lambda: check_editor(env),),
        'trainer': (lambda: check_trainer(env),),
        'vm': (lambda: check_vm(env),),
        'chrootables': (lambda: check_chrootables(env),),
        'prompts': (lambda: check_prompts(env),),
        'chat': (lambda: check_chat(env),),
        'suite': (lambda: check_suite(env),),
    }
    for name, checks in groups.items():
        if name not in selected:
            continue
        for check in checks:
            try:
                results.extend(check())
            except Exception as error:  # one broken check must not hide the others
                results.append(finding('WARN', 'doctor', f'{name} check crashed: {type(error).__name__}: {error}'))
    return results


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--project', type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument('--check', action='append', choices=CHECK_GROUPS, help='run only this group; repeat to select several')
    parser.add_argument('--list-checks', action='store_true', help='list check groups and exit')
    parser.add_argument('--strict', action='store_true', help='exit 1 on WARN as well as FAIL')
    parser.add_argument('-v', '--version', action='version', version=f'whitecube-doctor {WHITECUBE_VERSION}')
    args = parser.parse_args(argv)
    if args.list_checks:
        print(json.dumps(list(CHECK_GROUPS)) if args.json else '\n'.join(CHECK_GROUPS))
        return 0
    results = run_checks(Env(args.project), args.check)
    if args.json:
        print(json.dumps(results, indent=2))
    else:
        for item in results:
            print(f'{item["level"]:<4} {item["name"]}: {item["detail"]}')
            if item['fix'] and item['level'] != 'ok':
                print(f'     fix: {item["fix"]}')
        counts = {level: sum(item['level'] == level for item in results) for level in LEVELS}
        print(f"\n{counts['FAIL']} failed, {counts['WARN']} warnings, {counts['ok']} passed, {counts['info']} informational")
    failing = ('FAIL', 'WARN') if args.strict else ('FAIL',)
    return 1 if any(item['level'] in failing for item in results) else 0


if __name__ == '__main__':
    sys.exit(main())
