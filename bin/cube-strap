#!/usr/bin/python3 -I
"""Launch Cube Strap, the Debian whitecube builder."""
import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
for directory in (root / 'apps/cube-strap', root / 'share/whitecube/cube-strap'):
    if (directory / 'app.py').is_file():
        os.environ['GDK_BACKEND'] = 'wayland'
        os.execv('/usr/bin/python3', ['python3', '-I', str(directory / 'app.py'), *sys.argv[1:]])
print('cube-strap: application files are missing; reinstall whitecube-desktop', file=sys.stderr)
raise SystemExit(1)
