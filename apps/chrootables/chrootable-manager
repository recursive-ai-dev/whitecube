ui_import() {
    local archive choice name size lifecycle bytes; local -a entries=()
    for archive in "$EXPORT_DIR/"*.tar.gz; do
        [[ -f $archive && ! -L $archive ]] || continue
        entries+=("${archive##*/}" "$(human_bytes "$(stat -c%s -- "$archive")")")
    done
    entries+=(/path "Enter the full path of another archive")
    choice=$(ui --cancel-button Back --menu "Import a workspace from a root filesystem archive.\nExports of this store are listed; .tar, .tar.gz, .tar.xz and .tar.zst all work." \
        "$UI_HEIGHT" "$UI_WIDTH" "$((UI_HEIGHT - 10))" "${entries[@]}" 3>&1 1>&2 2>&3) || return 0
    if [[ $choice == /path ]]; then
        archive=$(ui --inputbox "Full path of the archive:" 10 "$UI_WIDTH" 3>&1 1>&2 2>&3) || return 0
    else archive="$EXPORT_DIR/$choice"; fi
    [[ -f $archive && -r $archive ]] || { ui_message "Archive not found or unreadable:\n$archive"; return; }
    # Suggest the exported workspace's name: NAME-YYYYmmdd-HHMMSS-TOKEN.tar.gz.
    name=${archive##*/}; name=${name%%.tar*}
    [[ ! $name =~ -[0-9]{8}-[0-9]{6}-[A-Za-z0-9]+$ ]] || name=${name%-*-*-*}
    name=${name//[^A-Za-z0-9._-]/-}
    while [[ $name == [._-]* ]]; do name=${name:1}; done
    name=${name:-imported}
    name=$(ui --inputbox "Name for the imported workspace:" 10 "$UI_WIDTH" "$(unique_name "$name")" 3>&1 1>&2 2>&3) || return 0
    valid_name "$name" || { ui_message "Invalid name. Start with a letter or digit; use at most 64 characters."; return; }
    [[ ! -e $IMAGE_DIR/$name.img ]] || { ui_message "A workspace named '$name' already exists. Choose another name."; return; }
    bytes=$(stat -c%s -- "$archive") || bytes=0
    size=$(( (bytes * 4 / 1048576 + 1023) / 1024 * 1024 )); (( size >= 2048 )) || size=2048; (( size <= MAX_SIZE_MIB )) || size=$MAX_SIZE_MIB
    size=$(ui --inputbox "Image capacity in MiB. It must hold the unpacked files, often several times the archive size." 10 "$UI_WIDTH" "$size" 3>&1 1>&2 2>&3) || return 0
    valid_size_mib "$size" || { ui_message "Enter a whole number from 1 to $MAX_SIZE_MIB MiB."; return; }
    lifecycle=$(choose_lifecycle) || return 0
    ui_run import_image "$name" "$archive" "$size" "$lifecycle"
    [[ ! -f $IMAGE_DIR/$name.img ]] || image_action_menu "$IMAGE_DIR/$name.img"
}
ui_cleanup() {
