            network-kit) profile=network; lifecycle=ephemeral; size=2048 ;;
        esac
        truncate -s "${size}M" "$IMAGE_DIR/$name.img" || return
        write_metadata "$IMAGE_DIR/$name.img" "$lifecycle" stable "$(dpkg --print-architecture)" "$size" "$(timestamp)" never "$profile" || return
    done
    install -d -m 0700 "$SNAPSHOT_DIR/build-lab" || return
    truncate -s 4096M "$SNAPSHOT_DIR/build-lab/clean-base.img" || return
    copy_metadata "$IMAGE_DIR/build-lab.img" "$SNAPSHOT_DIR/build-lab/clean-base.img" || return
    metadata_set "$SNAPSHOT_DIR/build-lab/clean-base.img" snapshot_at "$(timestamp)" || return
    if [[ ${1:-} == --dashboard ]]; then
        printf 'DEMO / sample workspaces / no mounts or downloads\n'
        dashboard
    else ui_init && main_menu; fi
)

usage() {
    printf '%s\n' "Chrootable Manager $APP_VERSION - Debian environment workbench" '
Usage: chrootable-manager [COMMAND]
No command opens the terminal dashboard (root required).

Explore (no root required when the store is readable)
  --dashboard                      Workspace overview and storage usage
  --list [--json]                   Inventory; TSV by default
  --inspect NAME [--json]           Image details and metadata
  --profiles                       Available creation profiles
  --capabilities --json             Versioned profiles, releases and limits
  --operations [--json]             Operation IDs, stages and interrupted work
  --snapshots NAME                  List recovery points, even after deletion
  --activity                       Recent operation history
  --logs NAME                      Last completed operation log (200 lines)
  --doctor [--json]                Read-only host readiness and storage checks
  --demo [--dashboard]              Explore sample workspaces without root
  --help | --version

Create and use (root required)
  --create NAME SIZE_MIB persistent|ephemeral [PROFILE]
  --import NAME ARCHIVE.tar.gz [SIZE_MIB] [persistent|ephemeral] [PROFILE]
                                   Rehydrate a .tar.gz export into a workspace.
                                   An empty SIZE_MIB fits capacity to the archive
  --archive-sync SUITE [PROFILE...]
                                   Download everything creates of SUITE need
                                   (all profiles by default) so they work
                                   offline; rerun to refresh
  --enter NAME [--share HOST_DIR] [--read-only] [--restricted-dev]
                                   Open a root shell
  --enter-isolated NAME [--share HOST_DIR] [--read-only] [--restricted-dev]
                                   Open a shell without host network access
  --exec NAME [--isolated] [--share HOST_DIR] [--read-only] [--restricted-dev] -- COMMAND [ARG...]
  --try NAME [--isolated] [--share HOST_DIR] [--read-only] [--restricted-dev] [-- COMMAND [ARG...]]
                                   Disposable session, regardless of image mode
  --clone NAME NEW_NAME             Independent copy (reflink when available)
  --mode NAME persistent|ephemeral  Change the default session lifecycle
  --resize NAME SIZE_MIB            Expand only; no shrinking
  --export NAME                    Export a .tar.gz; print its path

Recovery and maintenance (root required)
  --snapshot NAME LABEL            Save an offline recovery point
  --restore NAME LABEL --yes        Save current state, then restore snapshot
  --drop-snapshot NAME LABEL --yes  Permanently delete one snapshot
  --repair NAME --yes              Forced ext4 repair
  --delete NAME --yes              Delete image; keep snapshots and exports
  --delete-export FILENAME --yes   Delete a retained .tar.gz export archive
  --prune-logs [KEEP_COUNT] --yes  Remove old completed logs (default: keep 20)
  --setup                          Install missing host dependencies
  --recover-operation ID --yes      Finish an interrupted staged publication
  --discard-operation ID --yes      Abandon interrupted work and remove its staged
                                   files, or set aside a damaged operation record

Profiles: minimal (default), build, python, network, rust, go, web.
Sizes are MiB, from 512 to 1048576 (1 TiB). Images are sparse; capacity is not
reserved. Create, expansion and copies check free space before starting.
Shared folders appear at /shared for that session. HOST_DIR must be an existing
absolute directory other than /. Add --read-only to prevent ordinary writes.
Host folder changes persist, including in disposable sessions.

Examples
  sudo chrootable-manager --create compiler 4096 persistent build
  sudo chrootable-manager --snapshot compiler clean
  sudo chrootable-manager --try compiler -- bash -lc "apt-get update"
  sudo chrootable-manager --exec compiler -- gcc --version
  sudo chrootable-manager --enter compiler --share /path/to/project
  sudo chrootable-manager --restore compiler clean --yes

Configuration
  sudo CHROOTABLE_HOME=/srv/chrootables chrootable-manager
  CHROOTABLE_DEBIAN_SUITE=stable
  CHROOTABLE_DEBIAN_MIRROR=https://deb.debian.org/debian
  CHROOTABLE_AUTO_INSTALL=0         Fail instead of installing missing tools

These are host-root development environments, not security sandboxes.
Ephemeral sessions discard image writes but still expose host devices and any
writable shared folder. Guest root can undo read-only mounts. Add
--restricted-dev to give a session a minimal /dev without host device nodes.'
}
usage_error() { fail "Invalid arguments. Run $0 --help for usage." || true; return 2; }
validate_session_arguments() {
    local operation=$1 isolated_seen=0 share_seen=0 read_only_seen=0 restricted_seen=0
    SESSION_NETWORK=shared SESSION_SHARE= SESSION_READ_ONLY=0 SESSION_RESTRICTED_DEV=0 SESSION_COMMAND=()
    [[ $operation != --enter-isolated ]] || SESSION_NETWORK=isolated
    shift 2
    while (( $# )); do
        case $1 in
            --isolated)
                [[ $operation == --exec || $operation == --try ]] && (( isolated_seen == 0 )) || return 1
                isolated_seen=1; SESSION_NETWORK=isolated; shift ;;
            --share)
                (( share_seen == 0 && $# >= 2 )) || return 1
                canonicalize_shared_folder "$2" SESSION_SHARE || return
                share_seen=1; shift 2 ;;
            --read-only)
                (( read_only_seen == 0 )) || return 1
                read_only_seen=1; SESSION_READ_ONLY=1; shift ;;
            --restricted-dev)
                (( restricted_seen == 0 )) || return 1
                restricted_seen=1; SESSION_RESTRICTED_DEV=1; shift ;;
            --)
                [[ $operation == --exec || $operation == --try ]] && (( $# >= 2 )) || return 1
                shift; SESSION_COMMAND=("$@"); break ;;
            *) return 1 ;;
        esac
    done
    (( read_only_seen == 0 || share_seen == 1 )) || return 1
    [[ $operation != --exec ]] || (( ${#SESSION_COMMAND[@]} > 0 ))
}
validate_cli() {
    case ${1:-} in
        --help|-h|--version|--dashboard|--profiles|--activity|--setup) [[ $# == 1 ]] ;;
        --capabilities) [[ $# == 2 && $2 == --json ]] ;;
        --operations) [[ $# == 1 || ( $# == 2 && $2 == --json ) ]] ;;
        --recover-operation|--discard-operation) [[ $# == 3 && $3 == --yes ]] && valid_operation_id "$2" ;;
        --doctor) [[ $# == 1 || ( $# == 2 && $2 == --json ) ]] ;;
        --list) [[ $# == 1 || ( $# == 2 && $2 == --json ) ]] ;;
        --demo) [[ $# == 1 || ( $# == 2 && $2 == --dashboard ) ]] ;;
        --inspect) [[ $# == 2 || ( $# == 3 && $3 == --json ) ]] && valid_name "$2" ;;
        --snapshots|--logs|--export) [[ $# == 2 ]] && valid_name "$2" ;;
        --create) [[ $# == 4 || $# == 5 ]] && valid_name "$2" && valid_size_mib "$3" && valid_lifecycle "$4" && valid_profile "${5:-minimal}" ;;
        --import) [[ $# -ge 3 && $# -le 6 ]] && valid_name "$2" && [[ -n $3 && $3 == /* && $3 != *$'\n'* && $3 != *$'\r'* ]] && { [[ -z ${4:-} ]] || valid_size_mib "$4"; } && valid_lifecycle "${5:-persistent}" && valid_profile "${6:-minimal}" ;;
        --archive-sync) [[ $# -ge 2 ]] && valid_suite "$2" && valid_profiles "${@:3}" ;;
        --clone|--snapshot) [[ $# == 3 ]] && valid_name "$2" && valid_name "$3" ;;
        --mode) [[ $# == 3 ]] && valid_name "$2" && valid_lifecycle "$3" ;;
        --resize) [[ $# == 3 ]] && valid_name "$2" && valid_size_mib "$3" ;;
        --restore|--drop-snapshot) [[ $# == 4 && $4 == --yes ]] && valid_name "$2" && valid_name "$3" ;;
        --repair|--delete) [[ $# == 3 && $3 == --yes ]] && valid_name "$2" ;;
        --delete-export) [[ $# == 3 && $3 == --yes ]] && valid_export_name "$2" ;;
        --prune-logs) ( [[ $# == 2 && $2 == --yes ]] ) || ( [[ $# == 3 && $3 == --yes ]] && valid_keep_count "$2" ) ;;
        --enter|--enter-isolated|--exec|--try) [[ $# -ge 2 ]] && valid_name "$2" && validate_session_arguments "$@" ;;
        *) return 1 ;;
    esac
}
run_cli() {
    local image operation=$1 lifecycle
    case $operation in
        --help|-h) usage ;; --version) printf '%s\n' "$APP_VERSION" ;;
        --profiles) list_profiles ;; --capabilities) capabilities ;; --operations) list_operations "${2:+json}" ;;
        --doctor) doctor "${2:+json}" ;; --demo) run_demo "${2:-}" ;;
        --dashboard) dashboard ;; --list) list_images "${2:+json}" ;;
        --activity) activity ;; --logs) show_logs "$2" ;; --snapshots) list_snapshots "$2" ;;
        --setup) info "All host dependencies are available." ;;
        --recover-operation) recover_operation "$2" ;;
        --discard-operation) discard_operation "$2" ;;
        --prune-logs) if [[ $2 == --yes ]]; then prune_logs 20; else prune_logs "$2"; fi ;;
        --delete-export) delete_export "$2" ;;
        --archive-sync) shift; archive_sync "$@" ;;
        --create) create_image "$2" "$3" "$4" "${5:-minimal}" ;;
        --import) import_image "$2" "$3" "${4:-}" "${5:-persistent}" "${6:-minimal}" ;;
        --restore) restore_image "$2" "$3" ;;
        --drop-snapshot) drop_snapshot "$2" "$3" ;;
        *)
            image=$(resolve_image "$2") || return
            case $operation in
                --inspect) if [[ ${3:-} == --json ]]; then image_json "$image"; printf '\n'; else image_details "$image"; fi ;;
                --clone) clone_image "$image" "$3" ;; --resize) resize_image "$image" "$3" ;;
                --repair) repair_image "$image" ;; --delete) delete_image "$image" ;; --export) export_image "$image" ;;
                --snapshot) snapshot_image "$image" "$3" ;; --mode) set_lifecycle "$image" "$3" ;;
                --enter|--enter-isolated|--exec|--try)
                    validate_session_arguments "$@" || { usage_error; return 2; }
                    lifecycle=$(image_lifecycle "$image")
                    [[ $operation != --try ]] || lifecycle=ephemeral
                    enter_chrootable "$image" "$lifecycle" "$SESSION_NETWORK" "$SESSION_SHARE" "$SESSION_READ_ONLY" "${SESSION_COMMAND[@]}" ;;
            esac ;;
    esac
}
main() {
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export PATH
    umask 077
    SCRIPT_PATH=$(readlink -f -- "$SCRIPT_PATH") || return
    if [[ ${1:-} == --worker ]]; then
        [[ $# -ge 5 ]] || return 2
        shift; worker_main "$@"; return
    fi
    if (( $# == 0 )); then
        NON_INTERACTIVE=0
        require_root && check_prerequisites && init_store && ui_init && main_menu
        return
    fi
    validate_cli "$@" || { usage_error; return 2; }
    # Operations run in subshells that clean up on signals. The desktop signals the
    # whole process group, so stay alive to report the true exit status: a bash trap
    # runs only after the foreground subshell has finished.
    trap ':' TERM
    case $1 in
        --help|-h|--version|--profiles|--capabilities|--doctor|--demo) ;;
        --dashboard|--list|--inspect|--activity|--logs|--snapshots|--operations) check_readable_store || return ;;
        --setup)
            NON_INTERACTIVE=0
            require_root && init_store && begin_operation setup host || return
            CHROOTABLE_DEP_LOG="$OP_LOG" check_prerequisites || return ;;
        --recover-operation|--discard-operation|--prune-logs|--delete-export) require_root && init_store || return ;;
        *)
            require_root && check_prerequisites && init_store || return ;;
    esac
    run_cli "$@"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
