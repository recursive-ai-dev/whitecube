ui_message() { ui --msgbox "$1" "$UI_HEIGHT" "$UI_WIDTH" --scrolltext; }
ui_view() {
    local title=$1 content=$2 temporary status=0
    temporary=$(mktemp /tmp/chrootable-view.XXXXXX) || return
    printf '%s\n\n%s\n' "$title" "$content" >"$temporary"
    ui --textbox "$temporary" "$UI_HEIGHT" "$UI_WIDTH" --scrolltext || status=$?
