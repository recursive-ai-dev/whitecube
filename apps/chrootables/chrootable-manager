    text=$(usage_text)
    printf '%s\n' "${text//chrootable-manager/$command}"
}
# Points at the command's own usage line, not only at --help.
usage_error() {
    local line
    fail "Invalid arguments. Run $0 --help for usage." || true
    if [[ ${1:-} == --* ]]; then
        while IFS= read -r line; do
            if [[ $line == "  $1 "* ]]; then printf 'Usage: %s %s\n' "$0" "${line#  }" >&2; fi
        done < <(usage)
    fi
    return 2
}
validate_activity_arguments() {
