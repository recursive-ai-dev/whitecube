# -- Offline package archive -----------------------------------------------
#
# --archive-sync downloads everything a create needs into
# $ARCHIVE_DIR/<suite>-<arch>: a debootstrap --make-tarball of the minbase
# system, the Debian-signed apt lists it was resolved against, and the profile
# debs. Creates for that suite then run without a network. apt verifies each
# deb against the copied lists, so no store-local signing key is needed.

archive_path() { printf '%s/%s-%s' "$ARCHIVE_DIR" "$1" "$2"; }
archive_has_profile() {
    local archive=$1 profile=$2
    [[ ${CHROOTABLE_ARCHIVE:-1} != 0 && -s $archive/base.tgz && -s $archive/mirror ]] || return 1
    [[ $profile == minimal ]] || grep -qx -- "$profile" "$archive/profiles" 2>/dev/null
}
archive_sync() (
    # Rebuilds the suite's archive as a whole so the lists, base tarball and
    # debs always come from a single resolution.
    local suite=$1 arch archive profile sync_lock swap_lock old stale newest=
    shift
    local -a profiles=("$@")
    require_root || return
    valid_suite "$suite" || { fail "Invalid Debian suite: $suite"; return 1; }
    valid_mirror "$DEBIAN_MIRROR" || { fail "Debian mirror must be an https:// URL: $DEBIAN_MIRROR"; return 1; }
    (( ${#profiles[@]} )) || profiles=(build python network rust go web)
    for profile in "${profiles[@]}"; do
        valid_profile "$profile" || { fail "Unknown profile: $profile. See --profiles."; return 1; }
    done
    init_store || return
    [[ ! -L $ARCHIVE_DIR ]] || { fail "Store subdirectories must not be symlinks: $ARCHIVE_DIR"; return 1; }
    [[ -d $ARCHIVE_DIR ]] || install -d -m 0700 "$ARCHIVE_DIR" || return
    arch=$(dpkg --print-architecture) || return
    archive=$(archive_path "$suite" "$arch")
    exec {sync_lock}>>"$ARCHIVE_DIR/.sync.lock" || return
    flock -n "$sync_lock" || { fail "Another offline archive sync is running."; return 1; }
    begin_operation archive "$suite" || return
    # Holding the sync lock, any staging or previous directory for this archive
    # was abandoned by a crash. Put back an archive lost between the two renames.
    for stale in "$ARCHIVE_DIR/.$suite-$arch."*.old; do
        [[ -d $stale && ! -L $stale ]] || continue
        [[ -n $newest && ! $stale -nt $newest ]] || newest=$stale
    done
    if [[ -n $newest && ! -e $archive ]]; then mv -T -- "$newest" "$archive" || return; fi
    for stale in "$ARCHIVE_DIR/.$suite-$arch."*; do
        [[ -d $stale && ! -L $stale ]] || continue
        rm -rf --one-file-system -- "$stale" || return
    done
    make_workdir || return
    ARCHIVE_STAGING=$(mktemp -d "$ARCHIVE_DIR/.$suite-$arch.XXXXXX") || return
    OP_PENDING=${ARCHIVE_STAGING#"$STORE_DIR/"}; operation_stage downloading-archive || return
    info "Downloading Debian $suite ($arch) packages for: minimal ${profiles[*]}. Log: $OP_LOG"
    mkdir -p "$ARCHIVE_STAGING/scratch" "$ARCHIVE_STAGING/debs" "$ARCHIVE_STAGING/lists" || return
    # apt downloads as _apt, which must be able to traverse the scratch root.
    chmod 0755 "$ARCHIVE_STAGING/scratch" || return
    run_worker archive "$ARCHIVE_STAGING/scratch" "$WORK" "$suite" "$arch" "$ARCHIVE_STAGING" "${profiles[@]}" >>"$OP_LOG" 2>&1 || return
    rm -rf --one-file-system -- "$ARCHIVE_STAGING/scratch" || return
    printf '%s\n' "$DEBIAN_MIRROR" >"$ARCHIVE_STAGING/mirror" || return
    printf '%s\n' "${profiles[@]}" >"$ARCHIVE_STAGING/profiles" || return
    # Creates hold this lock shared while they read the archive, so the swap
    # waits for them and a create never sees a half-replaced archive.
    exec {swap_lock}>>"$ARCHIVE_DIR/.lock" || return
    flock -x "$swap_lock" || return
    old="$ARCHIVE_STAGING.old"
    protect_from_signals
    if [[ -e $archive ]]; then
        mv -T -- "$archive" "$old" || return
    fi
    if ! mv -T -- "$ARCHIVE_STAGING" "$archive"; then
        if [[ -e $old ]]; then mv -T -- "$old" "$archive" || true; fi
        return 1
    fi
    allow_signals
    exec {swap_lock}>&-
    ARCHIVE_STAGING=$old
    rm -rf --one-file-system -- "$ARCHIVE_STAGING" || return
    ARCHIVE_STAGING=
    info "Archive ready: $archive ($(du -sh -- "$archive" | cut -f1)). Creates for $suite now work offline."
)
archive_worker() {
    # Runs inside run_worker's namespaces; WORKER_ROOT is a bind of the scratch
    # directory so worker_cleanup unmounts everything beneath it.
    local scratch=$1 suite=$2 arch=$3 staging=$4 profile
    shift 4
    local -a package_list=()
    mount --bind "$scratch" "$WORKER_ROOT" || return
    SHA_SIZE=256 debootstrap --force-check-gpg --keyring=/usr/share/keyrings/debian-archive-keyring.gpg \
        --variant=minbase --arch="$arch" --make-tarball="$staging/base.tgz" \
        "$suite" "$staging/tarball-work" "$DEBIAN_MIRROR" || return
    rm -rf --one-file-system -- "$staging/tarball-work" || return
    # Unpack the tarball just written: this proves it bootstraps, and resolves
    # profile dependencies against exactly the base a create will have.
    debootstrap --variant=minbase --arch="$arch" --unpack-tarball="$staging/base.tgz" "$suite" "$WORKER_ROOT" || return
    printf 'deb %s %s main\n' "$DEBIAN_MIRROR" "$suite" >"$WORKER_ROOT/etc/apt/sources.list" || return
    mount_session_devices || return
    setup_resolv_conf "$work" "$WORKER_ROOT"
    chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get update || return
    for profile in "$@"; do
        read -r -a package_list <<<"$(profile_packages "$profile")"
        (( ${#package_list[@]} )) || continue
        chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get \
            --download-only -y --no-install-recommends install "${package_list[@]}" || {
            fail "Downloading profile $profile failed."; return 1;
        }
    done
    find "$WORKER_ROOT/var/cache/apt/archives" -maxdepth 1 -type f -name '*.deb' \
        -exec cp -p -t "$staging/debs" -- {} + || return
    find "$WORKER_ROOT/var/lib/apt/lists" -maxdepth 1 -type f ! -name lock \
        -exec cp -p -t "$staging/lists" -- {} + || return
}
archive_install_profile() {
    # Offline profile install: Debian-signed lists from the archive, debs read
    # through an overlay so apt's lock and partial files never touch the store.
    local archive=$1 mirror
    shift
    mirror=$(<"$archive/mirror") || return
    valid_mirror "$mirror" || { fail "Archive records an invalid mirror."; return 1; }
    # Lists are only used when sources.list names the mirror they came from.
    printf 'deb %s %s main\n' "$mirror" "$DEBIAN_SUITE" >"$WORKER_ROOT/etc/apt/sources.list" || return
    find "$archive/lists" -maxdepth 1 -type f -exec cp -p -t "$WORKER_ROOT/var/lib/apt/lists" -- {} + || return
    mkdir -p "$WORKER_OVERLAY/upper" "$WORKER_OVERLAY/work" || return
    mount -t overlay overlay -o "lowerdir=$archive/debs,upperdir=$WORKER_OVERLAY/upper,workdir=$WORKER_OVERLAY/work" \
        "$WORKER_ROOT/var/cache/apt/archives" || return
    chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get \
        --no-download -y --no-install-recommends install "$@" || return
    umount "$WORKER_ROOT/var/cache/apt/archives" || return
    printf 'deb %s %s main\n' "$DEBIAN_MIRROR" "$DEBIAN_SUITE" >"$WORKER_ROOT/etc/apt/sources.list"
}

allocate_image() {
    local target=$1 size_mib=$2
    if truncate -s "${size_mib}M" "$target" >>"$OP_LOG" 2>&1; then
        return 0
    fi
    dd if=/dev/zero of="$target" bs=1M count="$size_mib" status=none conv=fsync >>"$OP_LOG" 2>&1
}

create_image() (
    local name=$1 size=$2 lifecycle=$3 profile=${4:-minimal} image descriptor arch archive_lock
    unused_image "$name" || return
    valid_size_mib "$size" || { fail "Size must be a whole number from 512 to 1048576 MiB."; return 1; }
    valid_lifecycle "$lifecycle" || { fail "Lifecycle must be persistent or ephemeral."; return 1; }
    valid_profile "$profile" || { fail "Unknown profile: $profile. See --profiles."; return 1; }
    valid_suite "$DEBIAN_SUITE" || { fail "Invalid Debian suite: $DEBIAN_SUITE"; return 1; }
    valid_mirror "$DEBIAN_MIRROR" || { fail "Debian mirror must be an https:// URL: $DEBIAN_MIRROR"; return 1; }
    image="$IMAGE_DIR/$name.img"
    lock_image "$image" descriptor || return
    unused_image "$name" || return
    preflight_free_space "$((size * 1048576))" || return
    if [[ -d $ARCHIVE_DIR && ! -L $ARCHIVE_DIR ]]; then
        exec {archive_lock}>>"$ARCHIVE_DIR/.lock" || return
        flock -s "$archive_lock" || return
    fi
    begin_operation create "$name" || return
    PENDING=$(mktemp "$IMAGE_DIR/.$name.XXXXXX.partial") || return
    OP_PENDING=${PENDING#"$STORE_DIR/"}; operation_stage allocating || return
    make_workdir || return
    arch=$(dpkg --print-architecture) || return
    info "Creating $name / Debian $DEBIAN_SUITE / $profile / $size MiB. Log: $OP_LOG"
    allocate_image "$PENDING" "$size" || return
    operation_stage formatting || return
    mkfs.ext4 -F -L "${name:0:16}" "$PENDING" >>"$OP_LOG" 2>&1 || return
    operation_stage bootstrapping || return
    run_worker create "$PENDING" "$WORK" "$name" "$arch" "$profile" >>"$OP_LOG" 2>&1 || return
    write_metadata "$PENDING" "$lifecycle" "$DEBIAN_SUITE" "$arch" "$size" "$(timestamp)" never "$profile" || return
    publish_image "$PENDING" "$image" || return
    PENDING=
    info "Created '$name'. Enter with: sudo $0 --enter $name"
)
clone_image() (
    local source=$1 name=$2 descriptor destination_lock destination source_name
    unused_image "$name" || return
    lock_image "$source" descriptor || return
