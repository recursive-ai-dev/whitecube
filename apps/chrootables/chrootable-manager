        [[ $(snapshot_count "$name") != 0 ]] || continue
        entries+=("$name" "$(snapshot_count "$name") snapshots")
    done
    if (( ${#entries[@]} == 0 )); then ui_message "No snapshots yet.\n\nOpen a workspace and choose Snapshots to save your first recovery point."; return; fi
    choice=$(ui --cancel-button Back --menu "Recovery library\nIncludes snapshots of deleted workspaces." "$UI_HEIGHT" "$UI_WIDTH" "$((UI_HEIGHT - 10))" "${entries[@]}" 3>&1 1>&2 2>&3) || return 0
