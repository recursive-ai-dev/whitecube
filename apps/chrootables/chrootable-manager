    [[ ! -e $IMAGE_DIR/$name.img ]] || { ui_message "A workspace named '$name' already exists. Choose another name."; return; }
    suggested=$(profile_field "$profile" 1); minimum=$(profile_field "$profile" 2)
    size=$(ui --inputbox "Image capacity in MiB. Suggested for $profile: $suggested MiB (minimum $minimum).\nThe image is fully allocated when created." 11 "$UI_WIDTH" "$suggested" 3>&1 1>&2 2>&3) || return 0
