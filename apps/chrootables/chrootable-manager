#!/usr/bin/env bash
# Whitecube adaptation: use a generic shared-folder example in help.
# Debian image workspaces. Self-contained for easy installation.
set -Eeuo pipefail

APP_NAME="Chrootable Manager"
APP_VERSION=1.2.1
SCRIPT_PATH=${BASH_SOURCE[0]}
STORE_DIR=${CHROOTABLE_HOME:-/var/lib/chrootable-manager}
DEBIAN_SUITE=${CHROOTABLE_DEBIAN_SUITE:-stable}
DEBIAN_MIRROR=${CHROOTABLE_DEBIAN_MIRROR:-https://deb.debian.org/debian}
NON_INTERACTIVE=1
DEMO=0
REQUIRED_COMMANDS=(awk basename chmod chroot cp cut date dd debootstrap df dpkg du e2fsck find flock gpgv
    grep gzip hostname install ip ln losetup mkdir mkfs.ext4 mknod mktemp mount mountpoint mv readlink
    resize2fs rm rmdir sha256sum sleep sort stat sync tail tar touch truncate umount unshare wget whiptail xz)

configure_paths() {
    IMAGE_DIR="$STORE_DIR/images"
    LOG_DIR="$STORE_DIR/logs"
    EXPORT_DIR="$STORE_DIR/exports"
    SNAPSHOT_DIR="$STORE_DIR/snapshots"
    ARCHIVE_DIR="$STORE_DIR/archive"
    OPERATIONS_DIR="$STORE_DIR/operations"
}
configure_paths

fail() { printf 'Error: %s\n' "$*" >&2; return 1; }
info() { printf '%s\n' "$*" >&2; }
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }
valid_size_mib() {
    [[ $1 =~ ^[1-9][0-9]*$ ]] && (( ${#1} <= 7 )) && (( $1 >= 512 && $1 <= 1048576 ))
}
valid_operation_id() { [[ $1 =~ ^[a-f0-9]{32}$ ]]; }
valid_keep_count() { [[ $1 =~ ^[0-9]+$ ]] && (( ${#1} <= 5 && 10#$1 <= 10000 )); }
valid_export_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,199}\.tar\.gz$ ]]; }
valid_lifecycle() { [[ $1 == persistent || $1 == ephemeral ]]; }
valid_profile() { [[ $1 == minimal || $1 == build || $1 == python || $1 == network || $1 == rust || $1 == go || $1 == web ]]; }
valid_profiles() {
    local profile
    for profile in "$@"; do
        valid_profile "$profile" || return 1
    done
    return 0
}
valid_suite() { [[ $1 =~ ^[a-z0-9][a-z0-9.-]{0,31}$ ]]; }
valid_mirror() { [[ $1 =~ ^https://[A-Za-z0-9._-]+(:[0-9]+)?(/[A-Za-z0-9._/-]*)?$ ]]; }
timestamp() { date --iso-8601=seconds; }
image_size_mib() { local bytes; bytes=$(stat -c%s -- "$1") || return; printf '%s\n' "$((bytes / 1048576))"; }
allocated_bytes() { local blocks; blocks=$(stat -c%b -- "$1") || return; printf '%s\n' "$((blocks * 512))"; }
human_bytes() { awk -v bytes="$1" 'BEGIN {split("B KiB MiB GiB TiB", u); i=1; while(bytes>=1024 && i<5){bytes/=1024; i++} printf "%.1f %s", bytes, u[i]}'; }

resolve_image() {
    valid_name "$1" || { fail "Invalid name: $1. Use 1-64 letters, digits, dots, underscores or hyphens; start with a letter or digit."; return 1; }
    local image="$IMAGE_DIR/$1.img"
    [[ -f $image && ! -L $image ]] || { fail "Chrootable not found (or is a symlink): $1"; return 1; }
    printf '%s\n' "$image"
}
unused_image() {
    valid_name "$1" || { fail "Invalid name: $1"; return 1; }
    [[ ! -e $IMAGE_DIR/$1.img && ! -L $IMAGE_DIR/$1.img ]] || { fail "A chrootable named '$1' already exists."; return 1; }
}
metadata_value() {
    local value= image=$1 key=$2 fallback=${3:-unknown} mkey mval
    if [[ -f $image.meta && ! -L $image.meta ]]; then
        while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
            if [[ $mkey == "$key" ]]; then value=$mval; break; fi
        done <"$image.meta" || return
    fi
    printf '%s\n' "${value:-$fallback}"
}
image_lifecycle() {
    local lifecycle=persistent
    if [[ -f $1.meta ]]; then lifecycle=$(metadata_value "$1" lifecycle persistent)
    elif [[ -f $1.mode && ! -L $1.mode ]]; then read -r lifecycle <"$1.mode" || true; fi
    valid_lifecycle "$lifecycle" || lifecycle=persistent
    printf '%s\n' "$lifecycle"
}
write_metadata() {
    local image=$1 temporary value
    for value in "${@:2}"; do
        [[ $value != *$'\n'* && $value != *$'\r'* ]] || return 1
    done
    temporary=$(mktemp "$image.meta.XXXXXX") || return
    if ! printf 'format=2\nlifecycle=%s\nsuite=%s\narchitecture=%s\nsize_mib=%s\ncreated_at=%s\nlast_used_at=%s\nprofile=%s\norigin=%s\n' \
        "$2" "$3" "$4" "$5" "$6" "$7" "${8:-minimal}" "${9:-none}" >"$temporary" ||
        ! mv -T -- "$temporary" "$image.meta"; then
        rm -f -- "$temporary"; return 1
    fi
}
metadata_set() {
    local image=$1 key=$2 value=$3 temporary line
    [[ $key =~ ^[a-z_]+$ && $value != *$'\n'* && $value != *$'\r'* ]] || return 1
    # Upgrade legacy .mode files before creating .meta, preserving their mode.
    if [[ ! -f $image.meta && -f $image ]]; then
        write_metadata "$image" "$(image_lifecycle "$image")" unknown unknown "$(image_size_mib "$image")" unknown never || return
    fi
    temporary=$(mktemp "$image.meta.XXXXXX") || return
    if [[ -f $image.meta && ! -L $image.meta ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
            [[ ${line%%=*} == "$key" ]] || printf '%s\n' "$line"
        done <"$image.meta" >"$temporary" || { rm -f -- "$temporary"; return 1; }
    fi
    printf '%s=%s\n' "$key" "$value" >>"$temporary" && mv -T -- "$temporary" "$image.meta" || { rm -f -- "$temporary"; return 1; }
}
copy_metadata() {
    local source=$1 destination=$2 lifecycle=persistent suite=unknown architecture=unknown
    local created_at=unknown last_used_at=never profile=minimal origin=none mkey mval size_mib
    if [[ -f $source.meta && ! -L $source.meta ]]; then
        while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
            case $mkey in
                lifecycle) [[ -z $mval ]] || lifecycle=$mval ;;
                suite) [[ -z $mval ]] || suite=$mval ;;
                architecture) [[ -z $mval ]] || architecture=$mval ;;
                created_at) [[ -z $mval ]] || created_at=$mval ;;
                last_used_at) [[ -z $mval ]] || last_used_at=$mval ;;
                profile) [[ -z $mval ]] || profile=$mval ;;
                origin) [[ -z $mval ]] || origin=$mval ;;
            esac
        done <"$source.meta"
    elif [[ -f $source.mode && ! -L $source.mode ]]; then
        read -r lifecycle <"$source.mode" || true
    fi
    valid_lifecycle "$lifecycle" || lifecycle=persistent
    size_mib=$(image_size_mib "$source") || return
    write_metadata "$destination" "$lifecycle" "$suite" "$architecture" "$size_mib" \
        "${3:-$created_at}" "${4:-$last_used_at}" "$profile" "${5:-$origin}"
}

# Keep lock files after deletion: unlinking one would allow two processes to
# lock different inodes for the same name. Descriptors close on process exit.
lock_image() {
    local image=$1 new_fd
    [[ ! -L $image.lock ]] || { fail "Refusing a symlink lock: $image.lock"; return 1; }
    exec {new_fd}>>"$image.lock" || return
    if ! flock -n "$new_fd"; then
        exec {new_fd}>&-
        fail "This chrootable is already in use: $(basename "$image" .img)"; return 1
    fi
    if ! check_pending_publications "$image"; then
        exec {new_fd}>&-
        return 1
    fi
    printf -v "$2" '%s' "$new_fd"
}
image_status() {
    local descriptor
    if [[ -f $1.lock && ! -L $1.lock ]]; then
        if ! exec {descriptor}<"$1.lock"; then printf 'unknown'; return; fi
        if flock -n "$descriptor"; then printf 'ready'; else printf 'busy'; fi
        exec {descriptor}>&-
    else printf 'ready'; fi
}
assert_offline() {
    local devices
    [[ -f $1 && ! -L $1 ]] || { fail "Image disappeared or became a symlink: $1"; return 1; }
    devices=$(losetup -j "$1") || { fail "Could not check loop devices."; return 1; }
    [[ -z $devices ]] || { fail "Image is attached to a loop device. Unmount/detach it before continuing: $1"; return 1; }
}
snapshot_count() {
    local file count=0
    for file in "$SNAPSHOT_DIR/$1/"*.img; do [[ -f $file && ! -L $file ]] && count=$((count + 1)); done
    printf '%s' "$count"
}
export_count() {
    local file rest count=0
    # Match the generated NAME-DATE-TIME-TOKEN form so "foo" never claims the
    # exports of "foo-bar".
    for file in "$EXPORT_DIR/$1-"*.tar.gz "$EXPORT_DIR/$1.tar.gz"; do
        [[ -f $file && ! -L $file ]] || continue
        rest=${file##*/}; rest=${rest#"$1"}
        [[ $rest == .tar.gz || $rest =~ ^-[0-9]{8}-[0-9]{6}(-[A-Za-z0-9]{6})?\.tar\.gz$ ]] && count=$((count + 1))
    done
    printf '%s' "$count"
}

package_for_command() {
    if command -v dnf >/dev/null 2>&1; then
        case $1 in
            whiptail) printf newt; return ;;
            ip) printf iproute; return ;;
            awk) printf gawk; return ;;
            gpgv) printf gnupg2; return ;;
            xz) printf xz; return ;;
        esac
    elif command -v pacman >/dev/null 2>&1; then
        case $1 in
            whiptail) printf libnewt; return ;;
            ip) printf iproute2; return ;;
            awk) printf gawk; return ;;
            gpgv) printf gnupg; return ;;
            hostname) printf inetutils; return ;;
            xz) printf xz; return ;;
        esac
    elif command -v zypper >/dev/null 2>&1; then
        case $1 in
            whiptail) printf newt; return ;;
            ip) printf iproute2; return ;;
            awk) printf gawk; return ;;
            gpgv) printf gpg2; return ;;
            hostname) printf hostname; return ;;
            xz) printf xz; return ;;
        esac
    fi
    case $1 in
        whiptail|debootstrap|dpkg|grep|hostname|tar|gzip|gpgv|wget) printf '%s' "$1" ;;
        xz) printf xz-utils ;;
        mkfs.ext4|e2fsck|resize2fs) printf e2fsprogs ;;
        mount|umount|mountpoint|unshare|flock|losetup) printf util-linux ;;
        find) printf findutils ;;
        ip) printf iproute2 ;;
        awk) printf mawk ;;
        *) printf coreutils ;;
    esac
}
require_root() { [[ $EUID -eq 0 ]] || { fail "This operation needs root. Run with sudo."; return 1; }; }
check_prerequisites() {
    local command package existing; local -a packages=()
    require_root || return
    for command in "${REQUIRED_COMMANDS[@]}"; do
        [[ $command != whiptail || $NON_INTERACTIVE -eq 0 ]] || continue
        command -v "$command" >/dev/null 2>&1 && continue
        package=$(package_for_command "$command"); existing=" ${packages[*]} "
        [[ $existing == *" $package "* ]] || packages+=("$package")
    done
    if [[ ! -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then
        if command -v dnf >/dev/null 2>&1; then packages+=(debian-keyring)
        else packages+=(debian-archive-keyring); fi
    fi
    if (( ${#packages[@]} )); then
        [[ ${CHROOTABLE_AUTO_INSTALL:-1} != 0 ]] || { fail "Missing packages: ${packages[*]}. Install them or run --setup with CHROOTABLE_AUTO_INSTALL=1."; return 1; }
        local dep_log=${CHROOTABLE_DEP_LOG:-/var/log/chrootable-manager-dependencies.log}
        [[ ! -L $dep_log ]] || { fail "Refusing a symlink dependency log: $dep_log"; return 1; }
        info "Installing dependencies: ${packages[*]} (log: $dep_log)"
        if command -v dnf >/dev/null 2>&1; then
            dnf install -y --setopt=install_weak_deps=False "${packages[@]}" >>"$dep_log" 2>&1 || {
                fail "Dependency installation failed. See $dep_log"; return 1;
            }
        elif command -v apt-get >/dev/null 2>&1; then
            apt-get update >>"$dep_log" 2>&1 &&
                DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}" >>"$dep_log" 2>&1 || {
                fail "Dependency installation failed. See $dep_log"; return 1;
            }
        elif command -v pacman >/dev/null 2>&1; then
            pacman -Sy --noconfirm --needed "${packages[@]}" >>"$dep_log" 2>&1 || {
                fail "Dependency installation failed. See $dep_log"; return 1;
            }
        elif command -v zypper >/dev/null 2>&1; then
            zypper --non-interactive refresh >>"$dep_log" 2>&1 &&
                zypper --non-interactive install "${packages[@]}" >>"$dep_log" 2>&1 || {
                fail "Dependency installation failed. See $dep_log"; return 1;
            }
        else
            fail "Install these packages first: ${packages[*]}"; return 1
        fi
    fi
}
# A protected parent does not make an existing writable child safe. Use the same
# rules for mutations and read-only diagnostics; missing directories are allowed
# because init_store creates the required ones only after all checks pass.
store_directory_check() {
    local directory=$1 expected_owner=$2 owner permissions
    [[ ! -L $directory ]] || { printf 'Store directories must not be symlinks: %s' "$directory"; return 1; }
    [[ -e $directory ]] || return 0
    [[ -d $directory ]] || { printf 'Store path must be a directory: %s' "$directory"; return 1; }
    if ! read -r owner permissions < <(stat -c '%u %a' -- "$directory" 2>/dev/null); then
        printf 'Cannot inspect store directory ownership and permissions: %s' "$directory"; return 1
    fi
    [[ $owner =~ ^[0-9]+$ && $permissions =~ ^[0-7]{1,4}$ ]] || {
        printf 'Invalid ownership or permission information for store directory: %s' "$directory"; return 1;
    }
    [[ $owner == "$expected_owner" ]] && (( (8#$permissions & 0022) == 0 )) || {
        printf 'Store directory must be owned by UID %s and not writable by group/others: %s' "$expected_owner" "$directory"; return 1;
    }
}
init_store() {
    local directory issue
    [[ $STORE_DIR == /* && $STORE_DIR != / ]] || { fail "CHROOTABLE_HOME must be an absolute directory other than /."; return 1; }
    [[ ! -L $STORE_DIR ]] || { fail "The store must not be a symlink: $STORE_DIR"; return 1; }
    STORE_DIR=$(readlink -m -- "$STORE_DIR") || return
    [[ $STORE_DIR != / ]] || { fail "The store cannot be /."; return 1; }
    configure_paths
    for directory in "$STORE_DIR" "$IMAGE_DIR" "$LOG_DIR" "$EXPORT_DIR" "$SNAPSHOT_DIR" "$OPERATIONS_DIR" "$ARCHIVE_DIR"; do
        issue=$(store_directory_check "$directory" "$EUID") || { fail "$issue"; return 1; }
    done
    for directory in "$STORE_DIR" "$IMAGE_DIR" "$LOG_DIR" "$EXPORT_DIR" "$SNAPSHOT_DIR" "$OPERATIONS_DIR"; do
        [[ -d $directory ]] || install -d -m 0700 "$directory" || return
    done
}
check_readable_store() {
    [[ ! -e $STORE_DIR || ( -r $STORE_DIR && -x $STORE_DIR ) ]] || { fail "Store is not readable. Run with sudo to view $STORE_DIR"; return 1; }
}

record_event() {
    local descriptor bytes temporary max_bytes=${CHROOTABLE_ACTIVITY_MAX_BYTES:-1048576} keep_lines=${CHROOTABLE_ACTIVITY_KEEP_LINES:-500}
    exec {descriptor}>>"$STORE_DIR/.activity.lock" || return
    flock "$descriptor" || return
    printf '%s\t%s\t%s\t%s\t%s\n' "$(timestamp)" "$1" "$2" "$3" "$4" >>"$STORE_DIR/activity.tsv"
    if [[ -f $STORE_DIR/activity.tsv && ! -L $STORE_DIR/activity.tsv && $max_bytes =~ ^[0-9]+$ && $keep_lines =~ ^[1-9][0-9]*$ ]]; then
        bytes=$(stat -c%s -- "$STORE_DIR/activity.tsv" 2>/dev/null || printf 0)
        if [[ $bytes =~ ^[0-9]+$ ]] && (( bytes > max_bytes )); then
            temporary=$(mktemp "$STORE_DIR/.activity.tsv.XXXXXX") &&
                tail -n "$keep_lines" "$STORE_DIR/activity.tsv" >"$temporary" &&
                mv -T -- "$temporary" "$STORE_DIR/activity.tsv" || rm -f -- "${temporary:-}"
        fi
    fi
    exec {descriptor}>&-
}
# State files contain constrained identifiers and store-relative paths. Never source
# them: even a damaged record must not become executable shell input.
read_operation_state() {
    local path=$1 field value
    local -n result=$2
    result=()
    [[ -f $path && ! -L $path ]] || return 1
    while IFS='=' read -r field value || [[ -n $field || -n $value ]]; do
        [[ $field =~ ^[a-z_]+$ ]] || return 1
        [[ -z ${result[$field]+present} ]] || return 1
        case $field in
            format|id|pid|process_start|status|stage|action|name|pending|destination|image_inode|image_size|meta_inode|meta_size)
                result[$field]=$value ;;
            *) return 1 ;;
        esac
    done <"$path"
    [[ ${result[format]:-} == 1 && ${path##*/} == "${result[id]:-}.state" ]] && valid_operation_id "${result[id]:-}" &&
        [[ ${result[pid]:-} =~ ^[1-9][0-9]*$ && ${result[process_start]:-} =~ ^[0-9]+$ &&
           ${result[status]:-} =~ ^(running|completed|failed|interrupted|recovered)$ &&
           ${result[stage]:-} =~ ^[a-z][a-z0-9-]{0,47}$ &&
           ${result[action]:-} =~ ^[a-z][a-z0-9-]{0,31}$ ]] && valid_name "${result[name]:-}"
}
process_start_time() {
    local line
    local -a fields=()
    [[ -r /proc/$1/stat ]] || return 1
    IFS= read -r line <"/proc/$1/stat" || return
    # A process name can contain spaces and parentheses; fields follow the final ).
    read -r -a fields <<<"${line##*) }"
    [[ ${fields[19]:-} =~ ^[0-9]+$ ]] || return 1
    printf '%s' "${fields[19]}"
}
operation_is_alive() {
    local -n operation_state=$1
    local current
    current=$(process_start_time "${operation_state[pid]}") || return 1
    [[ $current == "${operation_state[process_start]}" ]]
}
durable_sync() { sync -f -- "$1"; }
write_operation_state() {
    [[ -n ${OP_ID:-} ]] || return 0
    local temporary
    temporary=$(mktemp "$OPERATIONS_DIR/.$OP_ID.XXXXXX") || return
    if ! printf 'format=1\nid=%s\npid=%s\nprocess_start=%s\nstatus=%s\nstage=%s\naction=%s\nname=%s\npending=%s\ndestination=%s\nimage_inode=%s\nimage_size=%s\nmeta_inode=%s\nmeta_size=%s\n' \
        "$OP_ID" "$OP_PID" "$OP_PROCESS_START" "$OP_STATUS" "$OP_STAGE" "$OPERATION" "$OP_NAME" \
        "${OP_PENDING:-}" "${OP_DESTINATION:-}" "${OP_IMAGE_INODE:-}" "${OP_IMAGE_SIZE:-}" \
        "${OP_META_INODE:-}" "${OP_META_SIZE:-}" >"$temporary" ||
        ! durable_sync "$temporary" || ! mv -T -- "$temporary" "$OPERATIONS_DIR/$OP_ID.state"; then
        rm -f -- "$temporary"
        return 1
    fi
    durable_sync "$OPERATIONS_DIR"
}
operation_stage() {
    [[ -n ${OP_ID:-} ]] || return 0
    OP_STAGE=$1
    write_operation_state || return
    [[ -n ${CHROOTABLE_OPERATION_ID:-} || ${CHROOTABLE_EVENTS:-0} == 1 ]] || return 0
    {
        printf 'CHROOTABLE_EVENT {"id":'; json_string "$OP_ID"
        printf ',"stage":'; json_string "$OP_STAGE"
        printf ',"log":'; json_string "$OP_LOG"
        printf '}\n'
    } >&2
}
check_pending_publications() {
    local image=$1 record target
    local -A state=()
    [[ ! -L $OPERATIONS_DIR ]] || { fail "Operation records must not be symlinks."; return 1; }
    for record in "$OPERATIONS_DIR/"*.state; do
        [[ -f $record && ! -L $record ]] || continue
        read_operation_state "$record" state || { target=${record##*/}; fail "Invalid operation record: $record. Inspect the store, then set it aside with: $0 --discard-operation ${target%.state} --yes"; return 1; }
        [[ ${state[id]} != "${RECOVERING_OPERATION:-}" ]] || continue
        [[ ${state[stage]} == publish-* && ${state[status]} != completed && ${state[status]} != recovered ]] || continue
        target=${state[destination]:-}
        if [[ $target == "images/${image##*/}" ]]; then
            fail "Interrupted publication ${state[id]} must be recovered first: $0 --recover-operation ${state[id]} --yes (or abandon it with --discard-operation)"
            return 1
        fi
        if [[ $target == snapshots/* ]]; then
            target=${target#snapshots/}; target=${target%%/*}
            if [[ $image == "$IMAGE_DIR/$target.img" ]]; then
                fail "Interrupted publication ${state[id]} must be recovered first: $0 --recover-operation ${state[id]} --yes"
                return 1
            fi
        fi
    done
}
begin_operation() {
    OPERATION=$1; OP_NAME=$2; PENDING=; WORK=; OP_PENDING=; OP_DESTINATION=
    OP_IMAGE_INODE=; OP_IMAGE_SIZE=; OP_META_INODE=; OP_META_SIZE=
    OP_ID=${CHROOTABLE_OPERATION_ID:-}
    if [[ -z $OP_ID ]]; then
        IFS= read -r OP_ID </proc/sys/kernel/random/uuid || return
        OP_ID=${OP_ID//-/}
    fi
    valid_operation_id "$OP_ID" || { fail "CHROOTABLE_OPERATION_ID must be 32 lowercase hexadecimal characters."; return 1; }
    [[ ! -L $OPERATIONS_DIR ]] || { fail "Operation records must not be symlinks."; return 1; }
    [[ -d $OPERATIONS_DIR ]] || install -d -m 0700 "$OPERATIONS_DIR" || return
    OP_LOG="$LOG_DIR/$OP_ID.log"
    ( set -o noclobber; : >"$OP_LOG" ) 2>/dev/null || { fail "Operation ID already has a log: $OP_ID"; return 1; }
    [[ ! -e $OPERATIONS_DIR/$OP_ID.state && ! -L $OPERATIONS_DIR/$OP_ID.state ]] || { fail "Operation ID already exists: $OP_ID"; return 1; }
    OP_PID=$BASHPID
    OP_PROCESS_START=$(process_start_time "$OP_PID") || return
    OP_STATUS=running; OP_STAGE=starting
    printf '%s  %s  %s\n' "$(timestamp)" "$1" "$2" >>"$OP_LOG"
    trap finish_operation EXIT
    allow_signals
    operation_stage starting
}
allow_signals() {
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}
# Stopping these steps midway would damage data rather than abandon work. Ignored
# signals are inherited, so child processes such as resize2fs are covered too.
protect_from_signals() { trap '' HUP INT TERM; }
finish_operation() {
    local status=$?
    protect_from_signals
    # Publication is a recoverable two-file transaction. Retain both the staged
    # image and its record after a failure; explicit recovery can finish it.
    if [[ ${OP_STAGE:-} == publish-* && $status != 0 ]]; then
        OP_STATUS=interrupted
        write_operation_state || true
    else
        if [[ -n ${PENDING:-} ]]; then rm -f -- "$PENDING" "$PENDING.meta" || true; fi
        OP_PENDING=; OP_DESTINATION=
        if (( status == 0 )); then OP_STATUS=completed; OP_STAGE=completed
        else OP_STATUS=failed; OP_STAGE=failed; fi
        operation_stage "$OP_STAGE" || true
    fi
    if [[ -n ${ARCHIVE_STAGING:-} ]]; then rm -rf --one-file-system -- "$ARCHIVE_STAGING" || true; fi
    if [[ -n ${WORK:-} ]]; then
        rm -f -- "$WORK/started" "$WORK/resolv.conf" "$WORK/resolv.conf.tmp" "$WORK/import.info" || true
        rmdir "$WORK/root" "$WORK/lower" "$WORK/overlay" "$WORK" 2>/dev/null || true
    fi
    if (( status == 0 )); then
        printf 'Completed: %s\n' "$(timestamp)" >>"$OP_LOG"
        record_event "$OPERATION" "$OP_NAME" ok "$OP_LOG" || true
    else
        printf 'Failed with status %s: %s\n' "$status" "$(timestamp)" >>"$OP_LOG"
        record_event "$OPERATION" "$OP_NAME" failed "$OP_LOG" || true
        info "Operation failed (status $status). Log: $OP_LOG"
    fi
    auto_prune_history || true
    return "$status"
}
make_workdir() { WORK=$(mktemp -d /run/chrootable-manager.XXXXXX); }
run_worker() { unshare --mount --uts --ipc --pid --fork --kill-child "$SCRIPT_PATH" --worker "$@"; }
publish_image() {
    local status=0
    # Once this starts the only outcomes are published or explicitly recoverable.
    protect_from_signals
    publish_image_steps "$@" || status=$?
    allow_signals
    return "$status"
}
publish_image_steps() {
    local pending=$1 destination=$2
    OP_PENDING=${pending#"$STORE_DIR/"}
    OP_DESTINATION=${destination#"$STORE_DIR/"}
    read -r OP_IMAGE_INODE OP_IMAGE_SIZE < <(stat -c '%i %s' -- "$pending") || return
    read -r OP_META_INODE OP_META_SIZE < <(stat -c '%i %s' -- "$pending.meta") || return
    durable_sync "$pending" && durable_sync "$pending.meta" || return
    operation_stage publish-prepared || return
    mv -T -- "$pending.meta" "$destination.meta" || return
    durable_sync "$destination.meta" && durable_sync "${destination%/*}" || return
    operation_stage publish-metadata || return
    mv -T -- "$pending" "$destination" || return
    durable_sync "${destination%/*}" || return
    OP_PENDING=; OP_DESTINATION=
    operation_stage published
}
matches_publication_file() {
    local path=$1 expected_inode=$2 expected_size=$3 inode bytes
    [[ $expected_inode =~ ^[1-9][0-9]*$ && $expected_size =~ ^[0-9]+$ && -f $path && ! -L $path ]] || return 1
    read -r inode bytes < <(stat -c '%i %s' -- "$path") || return
    [[ $inode == "$expected_inode" && $bytes == "$expected_size" ]]
}
publication_paths_valid() {
    local pending=$1 destination=$2 folder base
    [[ $pending != /* && $destination != /* && ${pending%/*} == "${destination%/*}" ]] || return 1
    base=${pending##*/}
    [[ $base =~ ^\.[A-Za-z0-9][A-Za-z0-9._-]{0,63}\.[A-Za-z0-9]{6}\.partial$ ]] || return 1
    case $destination in
        images/*.img)
            base=${destination#images/}; base=${base%.img}; valid_name "$base" || return ;;
        snapshots/*/*.img)
            folder=${destination#snapshots/}; folder=${folder%%/*}
            base=${destination##*/}; base=${base%.img}
            valid_name "$folder" && valid_name "$base" || return
            [[ $destination == "snapshots/$folder/$base.img" && ! -L $SNAPSHOT_DIR/$folder ]] || return 1 ;;
        *) return 1 ;;
    esac
    [[ ! -L $STORE_DIR/$pending && ! -L $STORE_DIR/$pending.meta &&
       ! -L $STORE_DIR/$destination && ! -L $STORE_DIR/$destination.meta ]]
}
recover_operation() (
    local identifier=$1 record pending destination lock_name descriptor
    local -A state=()
    # This resumes another operation's record, so emit no events under the caller's ID.
    unset CHROOTABLE_OPERATION_ID
    valid_operation_id "$identifier" || { fail "Invalid operation ID."; return 1; }
    record="$OPERATIONS_DIR/$identifier.state"
    read_operation_state "$record" state && [[ ${state[id]} == "$identifier" ]] || { fail "Operation record is missing or invalid."; return 1; }
    ! operation_is_alive state || { fail "This operation is still running. Wait for it to finish."; return 1; }
    [[ ${state[status]} != completed && ${state[status]} != recovered && ${state[stage]} == publish-* ]] || {
        fail "No staged publication can be safely completed. Inspect $LOG_DIR/$identifier.log; partial data has been retained."
        return 1
    }
    pending=${state[pending]:-}; destination=${state[destination]:-}
    publication_paths_valid "$pending" "$destination" || { fail "Unsafe publication paths in operation record. Nothing was changed."; return 1; }
    if [[ $destination == images/* ]]; then lock_name=${destination#images/}; lock_name=${lock_name%.img}
    else lock_name=${destination#snapshots/}; lock_name=${lock_name%%/*}; fi
    RECOVERING_OPERATION=$identifier
    lock_image "$IMAGE_DIR/$lock_name.img" descriptor || return
    # Re-read under the destination lock before changing any staged files.
    read_operation_state "$record" state && [[ ${state[pending]:-} == "$pending" && ${state[destination]:-} == "$destination" && ${state[stage]} == publish-* ]] || {
        fail "Operation changed while acquiring its lock. Refresh and try again."; return 1;
    }
    OP_ID=$identifier; OP_PID=$BASHPID; OP_PROCESS_START=$(process_start_time "$OP_PID") || return
    OPERATION=${state[action]}; OP_NAME=${state[name]}; OP_STATUS=interrupted; OP_STAGE=${state[stage]}
    OP_PENDING=$pending; OP_DESTINATION=$destination; OP_LOG="$LOG_DIR/$identifier.log"
    OP_IMAGE_INODE=${state[image_inode]:-}; OP_IMAGE_SIZE=${state[image_size]:-}
    OP_META_INODE=${state[meta_inode]:-}; OP_META_SIZE=${state[meta_size]:-}
    pending="$STORE_DIR/$pending"; destination="$STORE_DIR/$destination"
    if [[ -e $destination ]]; then assert_offline "$destination" || return; fi
    if [[ -f $pending ]]; then
        matches_publication_file "$pending" "$OP_IMAGE_INODE" "$OP_IMAGE_SIZE" || {
            fail "The staged image no longer matches its operation record. Nothing was changed."; return 1;
        }
        assert_offline "$pending" || return
        if [[ -f $pending.meta ]]; then
            matches_publication_file "$pending.meta" "$OP_META_INODE" "$OP_META_SIZE" || {
                fail "The staged metadata no longer matches its operation record. Nothing was changed."; return 1;
            }
            mv -T -- "$pending.meta" "$destination.meta" || return
            durable_sync "$destination.meta" && durable_sync "${destination%/*}" || return
            operation_stage publish-metadata || return
        else
            matches_publication_file "$destination.meta" "$OP_META_INODE" "$OP_META_SIZE" || {
                fail "The staged metadata is missing or changed. Nothing was published."; return 1;
            }
        fi
        mv -T -- "$pending" "$destination" || return
        durable_sync "${destination%/*}" || return
    else
        matches_publication_file "$destination" "$OP_IMAGE_INODE" "$OP_IMAGE_SIZE" &&
            matches_publication_file "$destination.meta" "$OP_META_INODE" "$OP_META_SIZE" && [[ ! -e $pending.meta ]] || {
            fail "Publication files are missing or inconsistent. Nothing was changed."; return 1;
        }
    fi
    OP_PENDING=; OP_DESTINATION=; OP_STATUS=recovered
    operation_stage recovered || return
    record_event recover "$OP_NAME" ok "$OP_LOG" || return
    info "Recovered publication $identifier. Image and metadata are consistent."
)
staged_path_valid() {
    local path=$1 folder base=${1##*/}
    case $path in
        images/*|exports/*)
            [[ ${path%/*} == images || ${path%/*} == exports ]] || return 1
            [[ $base =~ ^\.[A-Za-z0-9][A-Za-z0-9._-]{0,63}\.[A-Za-z0-9]{6}\.partial$ ]] ;;
        snapshots/*/*)
            folder=${path#snapshots/}; folder=${folder%%/*}
            [[ $path == "snapshots/$folder/$base" ]] && valid_name "$folder" &&
                [[ ! -L $SNAPSHOT_DIR/$folder && $base =~ ^\.[A-Za-z0-9][A-Za-z0-9._-]{0,63}\.[A-Za-z0-9]{6}\.partial$ ]] ;;
        archive/*)
            [[ ${path%/*} == archive && $base =~ ^\.[a-z0-9][a-z0-9.-]{0,31}-[a-z0-9]+\.[A-Za-z0-9]{6}$ ]] ;;
        *) return 1 ;;
    esac
}
discard_operation() (
    local identifier=$1 record pending destination descriptor lock_name
    local -A state=()
    unset CHROOTABLE_OPERATION_ID
    valid_operation_id "$identifier" || { fail "Invalid operation ID."; return 1; }
    record="$OPERATIONS_DIR/$identifier.state"
    [[ -f $record && ! -L $record ]] || { fail "Operation record is missing."; return 1; }
    if ! read_operation_state "$record" state; then
        # A damaged record cannot name its files, but it must not block the store.
        mv -T -- "$record" "$record.invalid" || return
        record_event discard-operation store ok "" || return
        info "Set aside the damaged record as $record.invalid. Check $STORE_DIR for leftover .partial files."
        return 0
    fi
    [[ ${state[id]} == "$identifier" ]] || { fail "Operation record is invalid."; return 1; }
    ! operation_is_alive state || { fail "This operation is still running. Wait for it to finish."; return 1; }
    [[ ${state[status]} == running || ${state[status]} == interrupted ]] || {
        fail "Operation $identifier already finished as ${state[status]}. Nothing needs discarding."; return 1;
    }
    pending=${state[pending]:-}; destination=${state[destination]:-}
    if [[ -n $pending ]]; then
        staged_path_valid "$pending" || { fail "Unsafe staged path in operation record. Nothing was changed."; return 1; }
        [[ ! -L $STORE_DIR/$pending && ! -L $STORE_DIR/$pending.meta ]] || { fail "Refusing a symlinked staged path. Nothing was changed."; return 1; }
    fi
    if [[ -n $destination || ${state[stage]} == publish-* ]]; then
        publication_paths_valid "$pending" "$destination" || {
            fail "Unsafe publication paths in operation record. Nothing was changed."; return 1;
        }
    fi
    if [[ ${state[action]} != archive ]]; then
        if [[ $destination == images/* ]]; then lock_name=${destination#images/}; lock_name=${lock_name%.img}
        elif [[ $destination == snapshots/* ]]; then lock_name=${destination#snapshots/}; lock_name=${lock_name%%/*}
        else lock_name=${state[name]}; fi
        RECOVERING_OPERATION=$identifier
        lock_image "$IMAGE_DIR/$lock_name.img" descriptor || return
    fi
    # Metadata may already be published. Only roll back while both staged files
    # still exist; otherwise the image and metadata would be left mismatched.
    if [[ ${state[stage]} == publish-* ]]; then
        [[ ${state[stage]} == publish-prepared && -n $pending &&
           -f $STORE_DIR/$pending && -f $STORE_DIR/$pending.meta ]] || {
            fail "This publication may already have replaced metadata. Retain its record and finish it instead: $0 --recover-operation $identifier --yes"
            return 1
        }
    fi
    if [[ -n $pending ]]; then
        pending="$STORE_DIR/$pending"
        if [[ -d $pending ]]; then rm -rf --one-file-system -- "$pending" || return
        else
            if [[ -e $pending ]]; then assert_offline "$pending" || return; fi
            rm -f -- "$pending" "$pending.meta" || return
        fi
    fi
    OP_ID=$identifier; OP_PID=$BASHPID; OP_PROCESS_START=$(process_start_time "$OP_PID") || return
    OPERATION=${state[action]}; OP_NAME=${state[name]}; OP_STATUS=failed; OP_STAGE=discarded
    OP_PENDING=; OP_DESTINATION=; OP_IMAGE_INODE=; OP_IMAGE_SIZE=; OP_META_INODE=; OP_META_SIZE=
    OP_LOG="$LOG_DIR/$identifier.log"
    operation_stage discarded || return
    record_event discard-operation "$OP_NAME" ok "$OP_LOG" || return
    info "Discarded interrupted ${state[action]} $identifier and removed its staged files."
)
list_operations() {
    local record comma= status active recoverable discardable
    local -A state=()
    [[ ${1:-text} != json ]] || printf '['
    for record in "$OPERATIONS_DIR/"*.state; do
        [[ -f $record && ! -L $record ]] || continue
        read_operation_state "$record" state || { info "Invalid operation record: $record. Remove it with --discard-operation."; continue; }
        active=false; operation_is_alive state && active=true
        status=${state[status]}
        [[ $status != running || $active == true ]] || status=interrupted
        recoverable=false; discardable=false
        if [[ $active == false && $status == interrupted ]]; then
            discardable=true
            [[ ${state[stage]} != publish-* ]] || recoverable=true
        fi
        if [[ ${1:-text} == json ]]; then
            printf '%s{"id":' "$comma"; json_string "${state[id]}"
            printf ',"action":'; json_string "${state[action]}"
            printf ',"name":'; json_string "${state[name]}"
            printf ',"status":'; json_string "$status"
            printf ',"stage":'; json_string "${state[stage]}"
            printf ',"log":'; json_string "$LOG_DIR/${state[id]}.log"
            printf ',"active":%s,"recoverable":%s,"discardable":%s}' "$active" "$recoverable" "$discardable"; comma=,
        else
            printf '%s\t%s\t%s\t%s\t%s\n' "${state[id]}" "${state[action]}" "${state[name]}" "$status" "${state[stage]}"
        fi
    done
    [[ ${1:-text} != json ]] || printf ']\n'
}
preflight_free_space() {
    local required=$1 available
    [[ $required =~ ^[0-9]+$ ]] || { fail "Could not determine required copy capacity."; return 1; }
    { read -r _; read -r _ _ _ available _; } < <(LC_ALL=C df -PB1 -- "$STORE_DIR") || return
    [[ $available =~ ^[0-9]+$ ]] || { fail "Could not determine available store space."; return 1; }
    (( available >= required )) || { fail "Not enough free space: need $required bytes, have $available. Sparse capacity is not reserved."; return 1; }
}

profile_packages() {
    case $1 in
        minimal) printf '' ;;
        build) printf 'build-essential git ca-certificates curl pkg-config' ;;
        python) printf 'python3 python3-venv python3-pip git ca-certificates curl' ;;
        network) printf 'iproute2 iputils-ping dnsutils curl ca-certificates openssh-client' ;;
        rust) printf 'rustc cargo git ca-certificates curl pkg-config' ;;
        go) printf 'golang-go git ca-certificates curl' ;;
        web) printf 'nodejs npm git ca-certificates curl' ;;
        *) return 1 ;;
    esac
}
recommended_size_mib() {
