setup_resolv_conf() {
    local work=$1 root=$2 source_file="" target
    local dest="$work/resolv.conf"

    if [[ -f /run/systemd/resolve/resolv.conf && -r /run/systemd/resolve/resolv.conf ]]; then
        source_file="/run/systemd/resolve/resolv.conf"
    elif [[ -f /etc/resolv.conf && -r /etc/resolv.conf ]]; then
        source_file="/etc/resolv.conf"
    fi

    if [[ -n $source_file && -f $source_file ]]; then
        cp -L "$source_file" "$dest" 2>/dev/null || true
    fi

    if [[ -f $dest ]] && grep -qE '^[[:space:]]*nameserver[[:space:]]+127\.' "$dest" 2>/dev/null; then
        awk '!/^[[:space:]]*nameserver[[:space:]]+127\./' "$dest" >"$dest.tmp" 2>/dev/null && mv -f -- "$dest.tmp" "$dest" || true
        if ! grep -qE '^[[:space:]]*nameserver[[:space:]]+' "$dest" 2>/dev/null; then
            printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >>"$dest"
        fi
    elif [[ ! -f $dest || ! -s $dest ]]; then
        printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >"$dest"
    fi

    # The manager uses umask 077, but apt downloads as the unprivileged _apt
    # account. Its resolver must stay readable after being bound into the guest.
    chmod 0644 "$dest" || return

    if [[ -d $root/etc ]]; then
        target=$(guest_resolve "$root" /etc/resolv.conf) || return 0
        mkdir -p -- "${target%/*}" 2>/dev/null || true
        [[ -e $target || -L $target ]] || : >"$target" 2>/dev/null || true
        [[ -f $target && ! -L $target ]] || return 0
        mount --bind "$dest" "$target" 2>/dev/null || true
        mount --make-rslave "$target" 2>/dev/null || true
    fi
}
mount_session_filesystems() {
    guest_mountpoint proc && guest_mountpoint run || return
    mount -t proc proc "$WORKER_ROOT/proc" || return
    mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$WORKER_ROOT/run"
}
mount_session_devices() {
    mount_session_filesystems || return
    guest_mountpoint dev || return
    mount --rbind /dev "$WORKER_ROOT/dev" || return
    mount --make-rslave "$WORKER_ROOT/dev" || return
    if mkdir -p "$WORKER_ROOT/dev/pts" 2>/dev/null; then
        mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 devpts "$WORKER_ROOT/dev/pts" 2>/dev/null &&
            mount --bind "$WORKER_ROOT/dev/pts/ptmx" "$WORKER_ROOT/dev/ptmx" 2>/dev/null || true
    fi
}
mount_restricted_devices() {
    # Opt-in reduced /dev: a fresh tmpfs with only the character devices a
    # Debian shell needs. No host device nodes are exposed. /proc and /run are
    # still needed: /dev/fd and /dev/stdin below resolve through /proc.
    local dev="$WORKER_ROOT/dev"
    mount_session_filesystems || return
    guest_mountpoint dev || return
    mount -t tmpfs -o mode=0755,nosuid tmpfs "$dev" || return
    # Create mountpoints inside the new tmpfs, after it hides the guest /dev.
    mkdir -p "$dev/pts" "$dev/shm" || return
    mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 devpts "$dev/pts" || return
    mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs "$dev/shm" || return
    ln -s pts/ptmx "$dev/ptmx" || return
    ln -s /proc/self/fd "$dev/fd" && ln -s /proc/self/fd/0 "$dev/stdin" &&
        ln -s /proc/self/fd/1 "$dev/stdout" && ln -s /proc/self/fd/2 "$dev/stderr" || return
    mknod -m 666 "$dev/null" c 1 3 && mknod -m 666 "$dev/zero" c 1 5 &&
        mknod -m 666 "$dev/full" c 1 7 && mknod -m 444 "$dev/random" c 1 8 &&
        mknod -m 666 "$dev/urandom" c 1 9 && mknod -m 666 "$dev/tty" c 5 0 || return
}
canonicalize_shared_folder() {
    local original=$1 resolved
    [[ $original == /* ]] || { fail "Shared folder must be an absolute host directory."; return 1; }
    [[ $original != *$'\n'* && $original != *$'\r'* ]] || { fail "Shared folder paths cannot contain line breaks."; return 1; }
    # NUL termination prevents line breaks from being silently trimmed.
    IFS= read -r -d '' resolved < <(readlink -ez -- "$original") || { fail "Shared folder does not exist: $original"; return 1; }
    [[ $resolved != / && -d $resolved ]] || { fail "Shared folder must be an existing directory other than /."; return 1; }
    [[ $resolved != *$'\n'* && $resolved != *$'\r'* ]] || { fail "Shared folder paths cannot contain line breaks."; return 1; }
    printf -v "$2" '%s' "$resolved"
}
mount_shared_folder() {
    local source=$1 read_only=$2 target="$WORKER_ROOT/shared"
    [[ -n $source ]] || return 0
    canonicalize_shared_folder "$source" source || return
    # /shared is a direct child of the image root: never follow a guest symlink
    # into the host namespace or replace a file already stored in the image.
    [[ ! -L $target && ( ! -e $target || -d $target ) ]] || { fail "Guest /shared must be a directory, not a symlink or file."; return 1; }
    WORKER_SHARE_CREATED=0
    if [[ ! -d $target ]]; then
        mkdir -- "$target" || return
        WORKER_SHARE_CREATED=1
    fi
    WORKER_SHARE_TARGET=$target
    # A plain bind excludes submounts within the source folder.
    mount --bind -- "$source" "$target" || return
    if [[ $read_only == 1 ]]; then mount -o remount,bind,ro -- "$target" || return; fi
}
# Report what the imported filesystem says about itself, read as the guest would.
record_import_details() {
    local work=$1 path line suite= architecture=
    path=$(guest_resolve "$WORKER_ROOT" /etc/os-release) || return
    if [[ -f $path ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
            if [[ $line == VERSION_CODENAME=* ]]; then
                suite=${line#*=}; suite=${suite//\"/}; suite=${suite//\'/}
            fi
        done <"$path"
    fi
    path=$(guest_resolve "$WORKER_ROOT" /var/lib/dpkg/arch) || return
    if [[ -f $path ]]; then IFS= read -r architecture <"$path" || true; fi
    if [[ -n $architecture && $architecture != "$(dpkg --print-architecture)" ]]; then
        info "Warning: this archive is for $architecture; sessions on this host may not run its programs."
    fi
    printf 'suite=%s\narchitecture=%s\n' "$suite" "$architecture" >"$work/import.info"
}
worker_main() (
    local kind=$1 image=$2 work=$3
    shift 3
    require_root || return
    WORKER_ROOT="$work/root"; WORKER_LOWER="$work/lower"; WORKER_OVERLAY="$work/overlay"
    WORKER_SHARE_TARGET=; WORKER_SHARE_CREATED=0
    trap worker_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    mount --make-rprivate / || return
    mkdir -p "$WORKER_ROOT" || return
    case $kind in
        create)
            local name=$1 arch=$2 profile=$3 packages archive offline=0
            valid_suite "$DEBIAN_SUITE" && valid_mirror "$DEBIAN_MIRROR" || { fail "Invalid Debian suite or mirror."; return 1; }
            archive=$(archive_path "$DEBIAN_SUITE" "$arch")
            mount -o loop "$image" "$WORKER_ROOT" || return
            if archive_has_profile "$archive" minimal; then
                info "Bootstrapping from the offline archive: $archive"
                debootstrap --variant=minbase --arch="$arch" --unpack-tarball="$archive/base.tgz" "$DEBIAN_SUITE" "$WORKER_ROOT" || return
                ! archive_has_profile "$archive" "$profile" || offline=1
            else
                SHA_SIZE=256 debootstrap --force-check-gpg --keyring=/usr/share/keyrings/debian-archive-keyring.gpg --variant=minbase --arch="$arch" "$DEBIAN_SUITE" "$WORKER_ROOT" "$DEBIAN_MIRROR" || return
            fi
            printf 'deb %s %s main\n' "$DEBIAN_MIRROR" "$DEBIAN_SUITE" >"$WORKER_ROOT/etc/apt/sources.list" || return
            printf '%s\n' "$name" >"$WORKER_ROOT/etc/hostname" || return
            printf '127.0.0.1 localhost\n127.0.1.1 %s\n::1 localhost ip6-localhost ip6-loopback\n' "$name" >"$WORKER_ROOT/etc/hosts" || return
            packages=$(profile_packages "$profile") || return
            if [[ -n $packages ]]; then
                local -a package_list=()
                read -r -a package_list <<<"$packages"
                if (( offline )); then
                    info "Installing the $profile profile from the offline archive."
                    mount_session_devices || return
                    mkdir -p "$WORKER_OVERLAY" || return
                    mount -t tmpfs -o mode=0700,nosuid,nodev tmpfs "$WORKER_OVERLAY" || return
                    archive_install_profile "$archive" "${package_list[@]}" || return
                else
                    mount_session_devices || return
                    setup_resolv_conf "$work" "$WORKER_ROOT"
                    chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get update || return
                    chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${package_list[@]}" || return
                fi
            fi
            chroot "$WORKER_ROOT" apt-get clean || return
            ;;
        archive) archive_worker "$image" "$@" || return ;;
        export)
            mount -o loop,ro,noload "$image" "$WORKER_ROOT" || return
            tar --numeric-owner --acls --xattrs --xattrs-include='*' --one-file-system -C "$WORKER_ROOT" -czf "$1" . || return
            ;;
        import)
            local name=$1 archive=$2
            mount -o loop "$image" "$WORKER_ROOT" || return
            # Extraction otherwise restores only user.* xattrs, losing file capabilities.
            tar --numeric-owner --acls --xattrs --xattrs-include='*' --no-overwrite-dir -p -C "$WORKER_ROOT" -xzf "$archive" || return
            # Sessions exec /usr/bin/env inside the image, so it must exist.
            [[ -L $WORKER_ROOT/usr/bin/env || -f $WORKER_ROOT/usr/bin/env ]] || { fail "Archive is not a Linux root filesystem: /usr/bin/env is missing."; return 1; }
            if [[ -d $WORKER_ROOT/etc && ! -L $WORKER_ROOT/etc && ! -L $WORKER_ROOT/etc/hostname ]]; then
                printf '%s\n' "$name" >"$WORKER_ROOT/etc/hostname" || return
            fi
            record_import_details "$work" || return
            ;;
        enter)
            local name=$1 lifecycle=$2 network=$3 share=$4 read_only=$5
            shift 5
            if [[ $lifecycle == ephemeral ]]; then
                mkdir -p "$WORKER_LOWER" "$WORKER_OVERLAY" || return
                mount -o loop,ro,noload "$image" "$WORKER_LOWER" || return
                mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$WORKER_OVERLAY" || return
                mkdir -p "$WORKER_OVERLAY/upper" "$WORKER_OVERLAY/work" || return
                mount -t overlay overlay -o "lowerdir=$WORKER_LOWER,upperdir=$WORKER_OVERLAY/upper,workdir=$WORKER_OVERLAY/work" "$WORKER_ROOT" || return
            else
                mount -o loop "$image" "$WORKER_ROOT" || return
            fi
            if [[ ${CHROOTABLE_RESTRICTED_DEV:-0} == 1 ]]; then
                mount_restricted_devices || return
            else
                mount_session_devices || return
            fi
            if [[ $network == isolated ]]; then
                ip link set lo up 2>/dev/null || ifconfig lo up 2>/dev/null || true
            else
                setup_resolv_conf "$work" "$WORKER_ROOT"
            fi
            mount_shared_folder "$share" "$read_only" || return
            hostname "$name" || return
            printf 'started\n' >"$work/started" || return
            # Scripts get exactly the command's stdout; the banner is shell-only.
            if (( $# == 0 )); then
                info "[$name] $lifecycle session | network: $network"
                [[ $lifecycle != ephemeral ]] || info "Image filesystem changes in this session disappear on exit."
                if [[ -n $share ]]; then
                    info "Host folder: $share -> /shared"
                    if [[ $read_only == 1 ]]; then info "/shared is read-only."; else info "Changes in /shared are saved on the host, including in disposable sessions."; fi
                fi
                set -- /bin/bash --login
            fi
            cd "$WORKER_ROOT" || return
            chroot "$WORKER_ROOT" /usr/bin/env -i HOME=/root USER=root LOGNAME=root \
                LANG="${LANG:-C.UTF-8}" TERM="${TERM:-xterm}" \
                PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
                CHROOTABLE_NAME="$name" CHROOTABLE_LIFECYCLE="$lifecycle" CHROOTABLE_NETWORK="$network" \
                "$@" || return
            cd / || return
            ;;
        *) fail "Unknown worker operation."; return 2 ;;
    esac
)

# JSON output needs no Python/jq dependency and never evaluates metadata.
json_string() {
    local value=$1 character number i
    if [[ $value != *[\"\\$'\001'-$'\037']* ]]; then
        printf '"%s"' "$value"
        return
    fi
    printf '"'
    for ((i=0; i<${#value}; i++)); do
        character=${value:i:1}
        case $character in
            '"') printf '\\"' ;; \\) printf '\\\\' ;;
            *) printf -v number '%d' "'$character"
               if (( number < 32 )); then printf '\\u%04x' "$number"; else printf '%s' "$character"; fi ;;
        esac
    done
    printf '"'
}
image_json() {
    local image=$1 bytes=${2:-} blocks=${3:-} name key value comma= status=ready lifecycle=persistent suite=unknown architecture=unknown
    local profile=minimal created_at=unknown last_used_at=never origin=unknown mkey mval snaps=0 file
    name=${image##*/}; name=${name%.img}
    # The desktop probes locks in-process after its initial JSON inventory, just
    # as it does on cached polls. Only list_images supplies this internal switch.
    if [[ ${4:-1} == 0 ]]; then
        status=unknown
    elif [[ -f $image.lock && ! -L $image.lock ]]; then
        status=$(image_status "$image")
    fi
    if [[ -f $image.meta && ! -L $image.meta ]]; then
        while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
            case $mkey in
                lifecycle) [[ -z $mval ]] || lifecycle=$mval ;;
                suite) [[ -z $mval ]] || suite=$mval ;;
                architecture) [[ -z $mval ]] || architecture=$mval ;;
                profile) [[ -z $mval ]] || profile=$mval ;;
                created_at) [[ -z $mval ]] || created_at=$mval ;;
                last_used_at) [[ -z $mval ]] || last_used_at=$mval ;;
                origin) [[ -z $mval ]] || origin=$mval ;;
            esac
        done <"$image.meta"
    elif [[ -f $image.mode && ! -L $image.mode ]]; then
        read -r lifecycle <"$image.mode" || true
    fi
    valid_lifecycle "$lifecycle" || lifecycle=persistent
    if [[ -z $bytes || -z $blocks ]]; then
        read -r bytes blocks < <(stat -c '%s %b' -- "$image") || return
    fi
    for file in "$SNAPSHOT_DIR/$name/"*.img; do [[ -f $file && ! -L $file ]] && snaps=$((snaps + 1)); done
    printf '{'
    for key in name path status lifecycle suite architecture profile created_at last_used_at origin; do
        case $key in
            name) value=$name ;; path) value=$image ;; status) value=$status ;;
            lifecycle) value=$lifecycle ;; suite) value=$suite ;; architecture) value=$architecture ;;
            profile) value=$profile ;; created_at) value=$created_at ;; last_used_at) value=$last_used_at ;;
            origin) value=$origin ;;
        esac
        printf '%s"%s":' "$comma" "$key"; json_string "$value"; comma=,
    done
    printf ',"size_mib":%s,"allocated_bytes":%s,"snapshots":%s}' "$((bytes / 1048576))" "$((blocks * 512))" "$snaps"
}
list_images() {
    local format=${1:-text} image name comma= idx=0 bytes blocks stat_output
    local -a valid_images=() stat_lines=()
    for image in "$IMAGE_DIR/"*.img; do
        [[ -f $image && ! -L $image ]] || continue
        name=${image##*/}; name=${name%.img}
        valid_name "$name" || continue
        valid_images+=("$image")
    done
    if (( ${#valid_images[@]} )); then
        stat_output=$(stat -c '%s %b' -- "${valid_images[@]}") || return
        mapfile -t stat_lines <<<"$stat_output"
    fi
    [[ $format != json ]] || printf '['
    for image in "${valid_images[@]}"; do
        name=${image##*/}; name=${name%.img}
        read -r bytes blocks <<<"${stat_lines[$idx]:-0 0}"
        idx=$((idx + 1))
        if [[ $format == json ]]; then printf '%s' "$comma"; image_json "$image" "$bytes" "$blocks" "${CHROOTABLE_LIST_PROBE_LOCKS:-1}"; comma=,
        else printf '%s\t%s\t%s MiB\n' "$name" "$(image_lifecycle "$image")" "$((bytes / 1048576))"; fi
    done
    [[ $format != json ]] || printf ']\n'
    return 0
}
image_details() {
    local image=$1 name status=ready lifecycle=persistent suite=unknown architecture=unknown
    local profile=minimal created_at='unknown (legacy image)' last_used_at=never origin=none mkey mval bytes=0 blocks=0 record target
    local -A op_state=()
    name=${image##*/}; name=${name%.img}
    if [[ -f $image.lock && ! -L $image.lock ]]; then status=$(image_status "$image"); fi
    if [[ -f $image.meta && ! -L $image.meta ]]; then
        while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
            case $mkey in
                lifecycle) [[ -z $mval ]] || lifecycle=$mval ;;
                suite) [[ -z $mval ]] || suite=$mval ;;
                architecture) [[ -z $mval ]] || architecture=$mval ;;
                profile) [[ -z $mval ]] || profile=$mval ;;
                created_at) [[ -z $mval ]] || created_at=$mval ;;
                last_used_at) [[ -z $mval ]] || last_used_at=$mval ;;
                origin) [[ -z $mval ]] || origin=$mval ;;
            esac
        done <"$image.meta"
    elif [[ -f $image.mode && ! -L $image.mode ]]; then
        read -r lifecycle <"$image.mode" || true
    fi
    valid_lifecycle "$lifecycle" || lifecycle=persistent
    read -r bytes blocks < <(stat -c '%s %b' -- "$image") || return
    printf '%s  /  %s  /  %s\n' "$name" "$status" "$lifecycle"
    printf '\nDebian %-14s Architecture %s\nProfile %-13s Snapshots    %s\n' \
        "$suite" "$architecture" "$profile" "$(snapshot_count "$name")"
    printf 'Capacity %s MiB   Allocated %s\nOrigin   %-13s Exports      %s\nCreated  %s\nLast run %s\nImage    %s\n' \
        "$((bytes / 1048576))" "$(human_bytes "$((blocks * 512))")" \
        "$origin" "$(export_count "$name")" \
        "$created_at" "$last_used_at" "$image"
    if [[ -d $OPERATIONS_DIR && ! -L $OPERATIONS_DIR && -r $OPERATIONS_DIR && -x $OPERATIONS_DIR ]]; then
        for record in "$OPERATIONS_DIR/"*.state; do
            [[ -f $record && ! -L $record ]] || continue
            read_operation_state "$record" op_state || continue
            [[ ${op_state[stage]} == publish-* && ${op_state[status]} != completed && ${op_state[status]} != recovered ]] || continue
            ! operation_is_alive op_state || continue
            target=${op_state[destination]:-}
            if [[ $target == "images/$name.img" || $target == "snapshots/$name/"* ]]; then
                printf 'Pending  Interrupted %s (%s) — recover with: sudo %s --recover-operation %s --yes\n' \
                    "${op_state[action]}" "${op_state[id]}" "$0" "${op_state[id]}"
            fi
        done
    fi
}
workspace_summary() {
    local image total=0 persistent=0 ephemeral=0 busy=0 bytes=0 snapshots=0 free=unknown lifecycle mkey mval blocks stat_output
    local -a valid_images=() stat_lines=()
    local idx=0
    for image in "$IMAGE_DIR/"*.img; do
        [[ -f $image && ! -L $image ]] || continue
        valid_images+=("$image")
    done
    if (( ${#valid_images[@]} )); then
        stat_output=$(stat -c '%b' -- "${valid_images[@]}") || return
        mapfile -t stat_lines <<<"$stat_output"
    fi
    for image in "${valid_images[@]}"; do
        blocks=${stat_lines[$idx]:-0}; idx=$((idx + 1))
        total=$((total + 1)); bytes=$((bytes + blocks * 512))
        lifecycle=persistent
        if [[ -f $image.meta && ! -L $image.meta ]]; then
            while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
                [[ $mkey == lifecycle && -n $mval ]] && { lifecycle=$mval; break; }
            done <"$image.meta"
        elif [[ -f $image.mode && ! -L $image.mode ]]; then
            read -r lifecycle <"$image.mode" || true
        fi
        valid_lifecycle "$lifecycle" || lifecycle=persistent
        if [[ $lifecycle == ephemeral ]]; then ephemeral=$((ephemeral + 1)); else persistent=$((persistent + 1)); fi
        if [[ -f $image.lock && ! -L $image.lock ]] && [[ $(image_status "$image") == busy ]]; then
            busy=$((busy + 1))
        fi
    done
    for image in "$SNAPSHOT_DIR/"*/*.img; do [[ ! -f $image || -L $image ]] || snapshots=$((snapshots + 1)); done
    if [[ -d $STORE_DIR ]]; then { read -r _; read -r _ _ _ free _; } < <(df -Ph "$STORE_DIR") || free=unknown; fi
    printf '%s workspaces   %s persistent   %s disposable   %s busy\n' "$total" "$persistent" "$ephemeral" "$busy"
    printf '%s in images   %s host free   %s snapshots\n' "$(human_bytes "$bytes")" "$free" "$snapshots"
}
dashboard() {
    local image name status lifecycle profile mkey mval snaps file bytes blocks stat_output idx=0 accent= reset=
    local total=0 persistent=0 ephemeral=0 busy=0 allocated=0 snapshots=0 free=unknown row
    local -a valid_images=() stat_lines=() rows=()
    if [[ -t 1 && -z ${NO_COLOR:-} ]]; then accent=$'\033[1;36m'; reset=$'\033[0m'; fi
    printf '\n%sCHROOTABLE%s  /  Debian environment workbench  /  %s\n\n' "$accent" "$reset" "$APP_VERSION"
    for image in "$IMAGE_DIR/"*.img; do
        [[ -f $image && ! -L $image ]] || continue
        valid_images+=("$image")
    done
    if (( ${#valid_images[@]} )); then
        stat_output=$(stat -c '%s %b' -- "${valid_images[@]}") || return
        mapfile -t stat_lines <<<"$stat_output"
    fi
    for image in "${valid_images[@]}"; do
        name=${image##*/}; name=${name%.img}
        read -r bytes blocks <<<"${stat_lines[$idx]:-0 0}"; idx=$((idx + 1))
        total=$((total + 1)); allocated=$((allocated + blocks * 512))
        status=ready
        if [[ -f $image.lock && ! -L $image.lock ]]; then
            status=$(image_status "$image")
            [[ $status != busy ]] || busy=$((busy + 1))
        fi
        lifecycle=persistent; profile=minimal
        if [[ -f $image.meta && ! -L $image.meta ]]; then
            while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
                case $mkey in
                    lifecycle) [[ -z $mval ]] || lifecycle=$mval ;;
                    profile) [[ -z $mval ]] || profile=$mval ;;
                esac
            done <"$image.meta"
        elif [[ -f $image.mode && ! -L $image.mode ]]; then
            read -r lifecycle <"$image.mode" || true
        fi
        valid_lifecycle "$lifecycle" || lifecycle=persistent
        if [[ $lifecycle == ephemeral ]]; then ephemeral=$((ephemeral + 1)); else persistent=$((persistent + 1)); fi
        snaps=0
        for file in "$SNAPSHOT_DIR/$name/"*.img; do [[ -f $file && ! -L $file ]] && snaps=$((snaps + 1)); done
        printf -v row '%-24s %-7s %-11s %-10s %-9s %s' "$name" "$status" "$lifecycle" "$profile" "$((bytes / 1048576))M" "$snaps"
        rows+=("$row")
    done
    for file in "$SNAPSHOT_DIR/"*/*.img; do [[ ! -f $file || -L $file ]] || snapshots=$((snapshots + 1)); done
    if [[ -d $STORE_DIR ]]; then { read -r _; read -r _ _ _ free _; } < <(df -Ph "$STORE_DIR") || free=unknown; fi
    printf '%s workspaces   %s persistent   %s disposable   %s busy\n' "$total" "$persistent" "$ephemeral" "$busy"
    printf '%s in images   %s host free   %s snapshots\n' "$(human_bytes "$allocated")" "$free" "$snapshots"
    printf '\n%-24s %-7s %-11s %-10s %-9s %s\n' WORKSPACE STATE MODE PROFILE CAPACITY SNAPSHOTS
    if (( ${#rows[@]} )); then printf '%s\n' "${rows[@]}"; fi
    printf '\nStore: %s\n' "$STORE_DIR"
    if [[ -f $STORE_DIR/activity.tsv ]]; then printf '\nRecent activity\n'; activity 5; fi
    printf '\nCreate: --create NAME 4096 persistent build\nExplore: --help | --profiles | --doctor | --demo\n\n'
}
activity() {
    local count=${1:-20} c1 c2 c3 c4 c5
    if [[ -f $STORE_DIR/activity.tsv ]]; then
        while IFS=$'\t' read -r c1 c2 c3 c4 c5; do
            printf '%s  %-14s %-20s %s\n' "$c1" "$c2" "$c3" "$c4"
        done < <(tail -n "$count" "$STORE_DIR/activity.tsv")
    else printf 'No operations recorded yet. Create a workspace to get started.\n'; fi
}
show_logs() {
    local name=$1 log latest= entry_time entry_action entry_name entry_status entry_log has_journal=0
    local -A valid_logs=()
    valid_name "$name" || { fail "Invalid image name."; return 1; }
    if [[ -f $STORE_DIR/activity.tsv ]]; then
        has_journal=1
        while IFS=$'\t' read -r entry_time entry_action entry_name entry_status entry_log; do
            [[ $entry_name == "$name" && -n $entry_log ]] && valid_logs[$entry_log]=1
        done <"$STORE_DIR/activity.tsv"
    fi
    # New operation-ID logs are associated by the journal, not filename prefix.
    # Legacy stores without a journal retain the original name-prefix fallback.
    local -a candidates=()
    if (( has_journal )); then
        for log in "${!valid_logs[@]}"; do
            [[ ${log%/*} == "$LOG_DIR" ]] && candidates+=("$log")
        done
    else
        candidates=("$LOG_DIR/$name-"*.log)
    fi
    for log in "${candidates[@]}"; do
        [[ -f $log && ! -L $log ]] || continue
        # Use the journal to avoid treating logs for "foo-bar" as logs for "foo".
        (( ! has_journal )) || [[ -n ${valid_logs[$log]:-} ]] || continue
        [[ -n $latest && ! $log -nt $latest ]] || latest=$log
    done
    [[ -n $latest ]] || { printf 'No completed operation logs for %s yet.\n' "$name"; return; }
    printf 'Log: %s\n\n' "$latest"
    tail -n 200 "$latest"
}
# Bash dynamic scope keeps the collected checks local to each doctor invocation.
doctor_check() {
    health_ids+=("$1"); health_statuses+=("$2")
    health_messages+=("$3"); health_remedies+=("${4:-}")
    case $2 in
        error) health_errors=$((health_errors + 1)) ;;
        warning) health_warnings=$((health_warnings + 1)) ;;
    esac
}
doctor_report() {
    local i status
    printf 'CHROOTABLE / Host health\n\n'
    printf 'Host: %s / %s\nVersion: %s\nStore: %s\n\n' "$health_host" "$health_arch" "$APP_VERSION" "$STORE_DIR"
    for i in "${!health_ids[@]}"; do
        case ${health_statuses[$i]} in
            ok) status=OK ;; error) status=MISSING ;; warning) status=WARN ;; *) status=INFO ;;
        esac
        printf '[%s] %s\n' "$status" "${health_messages[$i]}"
        [[ -z ${health_remedies[$i]} ]] || printf '       %s\n' "${health_remedies[$i]}"
    done
    printf '\n%s blocking issue(s), %s warning(s).\n' "$health_errors" "$health_warnings"
    printf 'Mount permissions are not tested by this read-only check.\n'
}
doctor() {
    local command fs namespace owner permissions probe disk header line i comma= report record remedy issue
    local -A operation=()
    local health_host health_arch health_errors=0 health_warnings=0
    local free_bytes=0 total_bytes=0 storage_available=false
    local -a health_ids=() health_statuses=() health_messages=() health_remedies=()
    health_host=$(uname -s); health_arch=$(uname -m)
    for command in "${REQUIRED_COMMANDS[@]}"; do
        if command -v "$command" >/dev/null 2>&1; then
            doctor_check "command:$command" ok "Host command: $command"
        else
            doctor_check "command:$command" error "Missing host command: $command" "Install $(package_for_command "$command"), or run sudo $0 --setup."
        fi
    done
    if [[ -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then
        doctor_check archive-keys ok 'Debian archive signing keys are available.'
    else
        doctor_check archive-keys error 'Debian archive signing keys are unavailable.' "Run sudo $0 --setup."
    fi
    for fs in ext4 overlay; do
        if command -v awk >/dev/null && awk -v fs="$fs" '$NF==fs {found=1} END {exit !found}' /proc/filesystems; then
            doctor_check "filesystem:$fs" ok "Kernel filesystem: $fs"
        else
            doctor_check "filesystem:$fs" warning "$fs is not loaded; it may be available as a kernel module." "Check that your kernel provides $fs support."
        fi
    done
    for namespace in mnt uts ipc pid net; do
        if [[ -e /proc/self/ns/$namespace ]]; then
            doctor_check "namespace:$namespace" ok "Namespace: $namespace"
        else
            doctor_check "namespace:$namespace" error "Missing namespace: $namespace" 'Use a Linux host with mount, UTS, IPC, PID and network namespace support.'
        fi
    done
    if [[ -e /dev/loop-control ]]; then
        doctor_check loop-control ok 'Loop device control exists.'
    else
        doctor_check loop-control warning '/dev/loop-control is unavailable; image mounts may be blocked.' 'Check the loop kernel module and host/container device access.'
    fi
    if [[ $STORE_DIR != /* || $STORE_DIR == / ]]; then
        doctor_check store-path error 'The store must be an absolute directory other than /.' 'Set CHROOTABLE_HOME to a dedicated directory.'
    elif [[ -L $STORE_DIR ]]; then
        doctor_check store-path error 'The workspace store is a symbolic link.' 'Choose the real store directory instead of a symlink.'
    elif [[ -e $STORE_DIR && ! -d $STORE_DIR ]]; then
        doctor_check store-path error 'The workspace store exists but is not a directory.' 'Choose a dedicated directory for the workspace store.'
    elif [[ -d $STORE_DIR ]]; then
        if read -r owner permissions < <(stat -c '%u %a' -- "$STORE_DIR" 2>/dev/null); then
            if [[ $owner != 0 ]] || (( (8#$permissions & 0022) != 0 )); then
                doctor_check store-permissions error 'The store must be owned by root and not writable by group or others.' 'Choose a protected root-owned store before performing administrator operations.'
            else
                doctor_check store-permissions ok 'Store ownership and permissions are suitable for administrator operations.'
            fi
        else
            doctor_check store-permissions info 'Store ownership could not be inspected without administrator access.'
        fi
        if [[ -r $STORE_DIR && -x $STORE_DIR ]]; then
            doctor_check store-access ok 'Store is readable.'
        else
            doctor_check store-access info 'Store needs administrator access.' 'Unlock the store in the desktop to view and modify workspaces.'
        fi
        for probe in images logs exports snapshots operations archive; do
            if ! issue=$(store_directory_check "$STORE_DIR/$probe" 0); then
                doctor_check "store:$probe" error "$issue" 'Use a real root-owned directory without group/other write access before performing administrator operations.'
            fi
        done
        if [[ -d $OPERATIONS_DIR && ! -L $OPERATIONS_DIR && -r $OPERATIONS_DIR && -x $OPERATIONS_DIR ]]; then
            for record in "$OPERATIONS_DIR/"*.state; do
                [[ -f $record && ! -L $record ]] || continue
                if ! read_operation_state "$record" operation; then
                    doctor_check "operation:${record##*/}" error "An operation record is invalid: ${record##*/}" 'Inspect the protected operations directory before making changes.'
                elif [[ ${operation[status]} == running || ${operation[status]} == interrupted ]]; then
                    if ! operation_is_alive operation; then
                        remedy="Inspect $LOG_DIR/${operation[id]}.log and retained partial files before retrying."
                        if [[ ${operation[stage]} == publish-* ]]; then
                            remedy="Finish the staged publication with sudo $0 --recover-operation ${operation[id]} --yes."
                        fi
                        doctor_check "operation:${operation[id]}" warning "Interrupted ${operation[action]} for ${operation[name]} at stage ${operation[stage]}." "$remedy"
                    fi
                fi
            done
        fi
    else
        doctor_check store-access info 'Store will be created on the first write operation.'
    fi
    # Inspect the nearest existing parent without creating the store. GNU df's
    # byte output does not depend on locale or the caller's block-size settings.
    probe=$STORE_DIR
    if [[ $probe == /* ]]; then
        while [[ ! -e $probe && $probe != / ]]; do probe=${probe%/*}; [[ -n $probe ]] || probe=/; done
        if disk=$(LC_ALL=C df -B1 --output=size,avail -- "$probe" 2>/dev/null); then
            { IFS= read -r header; read -r total_bytes free_bytes; } <<<"$disk" || true
            if [[ $total_bytes =~ ^[0-9]+$ && $free_bytes =~ ^[0-9]+$ ]]; then
                storage_available=true
                if (( free_bytes < 2147483648 )); then
                    doctor_check store-capacity warning "Less than 2 GiB is available on the store filesystem ($free_bytes bytes)." 'Free space or choose a larger store; images are sparse and their capacity is not reserved.'
                else
                    doctor_check store-capacity ok "Store filesystem has $(human_bytes "$free_bytes") available."
                fi
            else
                free_bytes=0; total_bytes=0
            fi
        fi
    fi
    if [[ $storage_available == false ]]; then
        doctor_check store-capacity warning 'Available store capacity could not be determined.' 'Unlock the store and recheck host health before creating an image.'
    fi
    if [[ ${1:-} == json ]]; then
        report=$(doctor_report)
        printf '{"schema_version":1,"ready":%s,"errors":%s,"warnings":%s,"version":' "$([[ $health_errors == 0 ]] && printf true || printf false)" "$health_errors" "$health_warnings"
        json_string "$APP_VERSION"; printf ',"host":'; json_string "$health_host"
        printf ',"architecture":'; json_string "$health_arch"; printf ',"store":'; json_string "$STORE_DIR"
        printf ',"storage":{"available":%s,"free_bytes":%s,"total_bytes":%s},"checks":[' "$storage_available" "$free_bytes" "$total_bytes"
        for i in "${!health_ids[@]}"; do
            printf '%s{"id":' "$comma"; json_string "${health_ids[$i]}"
            printf ',"status":'; json_string "${health_statuses[$i]}"
            printf ',"message":'; json_string "${health_messages[$i]}"
            printf ',"remedy":'; json_string "${health_remedies[$i]}"; printf '}'
            comma=,
        done
        printf '],"output":'; json_string "$report"; printf '}\n'
    else
        doctor_report
    fi
    (( health_errors == 0 ))
}

ui_init() {
    [[ -t 0 && -t 1 ]] || { fail "The menu needs a terminal. Use --dashboard, --list, or --help for command-line output."; return 1; }
    command -v whiptail >/dev/null || { fail "Install whiptail to use the menu (sudo apt-get install whiptail)."; return 1; }
    local rows columns
    read -r rows columns < <(stty size 2>/dev/null) || { rows=24; columns=80; }
    (( rows >= 24 && columns >= 80 )) || { fail "The menu needs at least 80 columns by 24 rows. Enlarge the terminal or use --dashboard."; return 1; }
    UI_HEIGHT=$((rows - 2)); (( UI_HEIGHT <= 30 )) || UI_HEIGHT=30
    UI_WIDTH=$((columns - 2)); (( UI_WIDTH <= 104 )) || UI_WIDTH=104
    export NEWT_COLORS="${NEWT_COLORS:-root=white,black window=white,black border=cyan,black title=cyan,black roottext=cyan,black textbox=white,black acttextbox=white,black entry=white,blue label=cyan,black listbox=white,black actlistbox=black,cyan sellistbox=black,cyan actsellistbox=black,cyan button=black,cyan actbutton=black,white compactbutton=black,cyan checkbox=white,black actcheckbox=black,cyan}"
    NON_INTERACTIVE=0
}
ui() {
