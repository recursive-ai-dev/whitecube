#!/usr/bin/env bash
# Debian image workspaces. Self-contained for easy installation.
set -Eeuo pipefail

APP_NAME="Chrootable Manager"
APP_VERSION=2.2.0
SCRIPT_PATH=${BASH_SOURCE[0]}
STORE_DIR=${CHROOTABLE_HOME:-/var/lib/chrootable-manager}
DEBIAN_SUITE=${CHROOTABLE_DEBIAN_SUITE:-stable}
DEBIAN_MIRROR=${CHROOTABLE_DEBIAN_MIRROR:-http://deb.debian.org/debian}
FALLBACK_DNS=${CHROOTABLE_FALLBACK_DNS:-1.1.1.1 8.8.8.8}
EPHEMERAL_SIZE=${CHROOTABLE_EPHEMERAL_SIZE:-}
# Bootable exports add a kernel, systemd and UKI tools to a copy of the
# workspace; the copy grows by this much first. The ESP size is for --export-disk.
BOOT_EXTRA_MIB=2048
BOOT_ESP_MIB=256
BOOT_PACKAGES='linux-image-amd64 systemd-sysv systemd-resolved udev kmod systemd-ukify systemd-boot-efi'
BOOT_COMMANDS=(mkfs.vfat mmd mcopy sgdisk xorriso mksquashfs sbsign openssl tune2fs)
MAX_SIZE_MIB=1048576
NON_INTERACTIVE=1
DEMO=0
LOCK_FDS=()
REQUIRED_COMMANDS=(awk basename chroot cp date dd debootstrap df dpkg e2fsck flock
    gzip hostname install ip losetup mkdir mkfs.ext4 mktemp mount mountpoint mv readlink
    resize2fs rm rmdir sha256sum stat tail tar truncate umount unshare whiptail)

configure_paths() {
    IMAGE_DIR="$STORE_DIR/images"
    LOG_DIR="$STORE_DIR/logs"
    EXPORT_DIR="$STORE_DIR/exports"
    SNAPSHOT_DIR="$STORE_DIR/snapshots"
}
configure_paths

fail() { printf 'Error: %s\n' "$*" >&2; return 1; }
info() { printf '%s\n' "$*" >&2; }
# Workers log to the operation log; fd 3, when the parent opened it, reaches the user.
progress() { { printf '%s\n' "$*" >&3; } 2>/dev/null || true; }
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }
# Seven digits at most, so the arithmetic comparison can never overflow.
valid_size_mib() { [[ $1 =~ ^[1-9][0-9]{0,6}$ ]] && (( $1 <= MAX_SIZE_MIB )); }
valid_lifecycle() { [[ $1 == persistent || $1 == ephemeral ]]; }
valid_profile() { profile_record "$1" >/dev/null; }
valid_description() { (( ${#1} <= 200 )) && [[ $1 != *[[:cntrl:]]* ]]; }
valid_suite() { [[ $1 =~ ^[a-z][a-z0-9.+-]{0,31}$ ]]; }
valid_mirror() {
    local pattern='^(https?|file|ssh)://[^[:space:][:cntrl:]"'\''\]+$'
    [[ $1 =~ $pattern ]]
}
valid_tmpfs_size() { [[ $1 =~ ^[1-9][0-9]{0,8}[kKmMgG%]?$ ]]; }
timestamp() { date --iso-8601=seconds; }
image_size_mib() { local bytes; bytes=$(stat -c%s -- "$1") || return; printf '%s\n' "$((bytes / 1048576))"; }
allocated_bytes() { local blocks; blocks=$(stat -c%b -- "$1") || return; printf '%s\n' "$((blocks * 512))"; }
human_bytes() { awk -v bytes="$1" 'BEGIN {split("B KiB MiB GiB TiB", u); i=1; while(bytes>=1024 && i<5){bytes/=1024; i++} printf "%.1f %s", bytes, u[i]}'; }

resolve_image() {
    valid_name "$1" || { fail "Invalid name: $1. Use 1-64 letters, digits, dots, underscores or hyphens; start with a letter or digit."; return 1; }
    local image="$IMAGE_DIR/$1.img"
    [[ -f $image && ! -L $image ]] || { fail "Chrootable not found (or is a symlink): $1"; return 1; }
    printf '%s\n' "$image"
}
unused_image() {
    valid_name "$1" || { fail "Invalid name: $1"; return 1; }
    [[ ! -e $IMAGE_DIR/$1.img && ! -L $IMAGE_DIR/$1.img ]] || { fail "A chrootable named '$1' already exists."; return 1; }
}
# Plain reads instead of an awk process per key: listings ask for every column
# of every image. Unreadable metadata falls back quietly.
metadata_value() {
    local image=$1 key=$2 fallback=${3-unknown} line value=''
    if [[ -f $image.meta && ! -L $image.meta && -r $image.meta ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
            if [[ $line == "$key="* ]]; then value=${line#*=}; break; fi
        done <"$image.meta"
    fi
    printf '%s\n' "${value:-$fallback}"
}
image_lifecycle() {
    local lifecycle=persistent
    if [[ -f $1.meta && ! -L $1.meta ]]; then lifecycle=$(metadata_value "$1" lifecycle persistent)
    elif [[ -f $1.mode && ! -L $1.mode && -r $1.mode ]]; then read -r lifecycle <"$1.mode" || true; fi
    valid_lifecycle "$lifecycle" || lifecycle=persistent
    printf '%s\n' "$lifecycle"
}
write_metadata() {
    local image=$1 temporary
    temporary=$(mktemp "$image.meta.XXXXXX") || return
    if ! printf 'format=2\nlifecycle=%s\nsuite=%s\narchitecture=%s\nsize_mib=%s\ncreated_at=%s\nlast_used_at=%s\nprofile=%s\norigin=%s\n' \
        "$2" "$3" "$4" "$5" "$6" "$7" "${8:-minimal}" "${9:-none}" >"$temporary" ||
        ! mv -T -- "$temporary" "$image.meta"; then
        rm -f -- "$temporary"; return 1
    fi
}
metadata_set() {
    local image=$1 key=$2 value=$3 temporary
    [[ $key =~ ^[a-z_]+$ && $value != *$'\n'* && $value != *$'\r'* ]] || return 1
    # Upgrade legacy .mode files before creating .meta, preserving their mode.
    if [[ ! -f $image.meta && -f $image ]]; then
        write_metadata "$image" "$(image_lifecycle "$image")" unknown unknown "$(image_size_mib "$image")" unknown never || return
    fi
    temporary=$(mktemp "$image.meta.XXXXXX") || return
    if [[ -f $image.meta && ! -L $image.meta ]]; then
        awk -F= -v key="$key" '$1 != key' "$image.meta" >"$temporary" || { rm -f -- "$temporary"; return 1; }
    fi
    printf '%s=%s\n' "$key" "$value" >>"$temporary" && mv -T -- "$temporary" "$image.meta" || { rm -f -- "$temporary"; return 1; }
}
# Also carries keys outside the fixed set (release, description, keys written by
# newer versions), but not history that each copy records for itself.
copy_metadata() {
    local source=$1 destination=$2 line key
    write_metadata "$destination" "$(image_lifecycle "$source")" \
        "$(metadata_value "$source" suite unknown)" "$(metadata_value "$source" architecture unknown)" \
        "$(image_size_mib "$source")" "$(metadata_value "$source" created_at unknown)" \
        "$(metadata_value "$source" last_used_at never)" "$(metadata_value "$source" profile minimal)" \
        "$(metadata_value "$source" origin none)" || return
    [[ -f $source.meta && ! -L $source.meta && -r $source.meta ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        key=${line%%=*}
        [[ $line == *=* && $key =~ ^[a-z_]+$ ]] || continue
        case $key in
            format|lifecycle|suite|architecture|size_mib|created_at|last_used_at|profile|origin) ;;
            snapshot_at|restored_from|restored_at) ;;
            *) printf '%s\n' "$line" >>"$destination.meta" || return ;;
        esac
    done <"$source.meta"
}

# Keep lock files after deletion: unlinking one would allow two processes to
# lock different inodes for the same name. Descriptors close on process exit.
# Returns 1 while another process holds the lock, 2 if it cannot be opened.
# LOCK_FDS lets spawn_worker keep the descriptors away from guests.
try_lock_image() {
    local lock_path=$1.lock new_fd
    [[ ! -L $lock_path ]] || return 2
    exec {new_fd}>>"$lock_path" || return 2
    if ! flock -n "$new_fd"; then exec {new_fd}>&-; return 1; fi
    LOCK_FDS+=("$new_fd")
    printf -v "$2" '%s' "$new_fd"
}
lock_image() {
    local lock_status=0
    try_lock_image "$1" "$2" || lock_status=$?
    case $lock_status in
        0) ;;
        1) fail "This chrootable is already in use: $(basename "$1" .img)" ;;
        *) fail "Cannot open the lock file (missing directory or a symlink): $1.lock" ;;
    esac
}
image_status() {
    local descriptor
    if [[ -f $1.lock && ! -L $1.lock ]]; then
        if ! exec {descriptor}<"$1.lock"; then printf 'unknown'; return; fi
        if flock -n "$descriptor"; then printf 'ready'; else printf 'busy'; fi
        exec {descriptor}>&-
    else printf 'ready'; fi
}
assert_offline() {
    local devices
    [[ -f $1 && ! -L $1 ]] || { fail "Image disappeared or became a symlink: $1"; return 1; }
    devices=$(losetup -j "$1") || { fail "Could not check loop devices."; return 1; }
    [[ -z $devices ]] || { fail "Image is attached to a loop device. Unmount/detach it before continuing: $1"; return 1; }
}
snapshot_count() {
    local file count=0
    for file in "$SNAPSHOT_DIR/$1/"*.img; do [[ -f $file && ! -L $file ]] && count=$((count + 1)); done
    printf '%s' "$count"
}

package_for_command() {
    case $1 in
        whiptail|debootstrap|dpkg|hostname|tar|gzip) printf '%s' "$1" ;;
        mkfs.ext4|e2fsck|resize2fs|tune2fs) printf e2fsprogs ;;
        mkfs.vfat) printf dosfstools ;; mmd|mcopy) printf mtools ;; sgdisk) printf gdisk ;;
        mksquashfs) printf squashfs-tools ;; sbsign) printf sbsigntool ;; xorriso|openssl) printf '%s' "$1" ;;
        mount|umount|losetup) printf mount ;;
        mountpoint|unshare|flock) printf util-linux ;;
        ip) printf iproute2 ;;
        awk) printf mawk ;;
        *) printf coreutils ;;
    esac
}
require_root() { [[ $EUID -eq 0 ]] || { fail "This operation needs root. Run with sudo."; return 1; }; }
check_prerequisites() {
    require_root || return
    ensure_commands "${REQUIRED_COMMANDS[@]}"
}
ensure_commands() {
    local command package existing; local -a packages=()
    for command in "$@"; do
        [[ $command != whiptail || $NON_INTERACTIVE -eq 0 ]] || continue
        command -v "$command" >/dev/null 2>&1 && continue
        package=$(package_for_command "$command"); existing=" ${packages[*]} "
        [[ $existing == *" $package "* ]] || packages+=("$package")
    done
    if (( ${#packages[@]} )); then
        [[ ${CHROOTABLE_AUTO_INSTALL:-1} != 0 ]] || { fail "Missing packages: ${packages[*]}. Install them or run --setup with CHROOTABLE_AUTO_INSTALL=1."; return 1; }
        command -v apt-get >/dev/null || { fail "Install these packages first: ${packages[*]}"; return 1; }
        info "Installing dependencies: ${packages[*]} (log: /var/log/chrootable-manager-dependencies.log)"
        apt-get update >>/var/log/chrootable-manager-dependencies.log 2>&1 &&
            DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}" >>/var/log/chrootable-manager-dependencies.log 2>&1 || {
            fail "Dependency installation failed. See /var/log/chrootable-manager-dependencies.log"; return 1;
        }
    fi
}
# Read-only commands canonicalize too, so their paths match the ones that write
# operations recorded in the journal.
resolve_store() {
    [[ $STORE_DIR == /* && $STORE_DIR != *[[:cntrl:]]* ]] || {
        fail "CHROOTABLE_HOME must be an absolute path without control characters."; return 1;
    }
    STORE_DIR=$(readlink -m -- "$STORE_DIR") || return
    [[ $STORE_DIR != / ]] || { fail "The store cannot be /."; return 1; }
    configure_paths
}
owned_private_directory() {
    local owner permissions
    [[ -d $1 && ! -L $1 ]] || { fail "Expected a real directory, not a file or symlink: $1"; return 1; }
    owner=$(stat -c%u -- "$1") && permissions=$(stat -c%a -- "$1") || return
    [[ $owner == "$EUID" ]] && (( (8#$permissions & 0022) == 0 )) || {
        fail "Must be owned by the current user and not writable by group/others: $1"; return 1;
    }
}
# Existing directories keep their mode, so an administrator can make the store
# readable for root-free browsing; new directories start private.
init_store() {
    local directory
    resolve_store || return
    for directory in "$STORE_DIR" "$IMAGE_DIR" "$LOG_DIR" "$EXPORT_DIR" "$SNAPSHOT_DIR"; do
        if [[ -e $directory || -L $directory ]]; then owned_private_directory "$directory" || return
        else install -d -m 0700 "$directory" || return; fi
    done
}
check_readable_store() {
    local directory
    resolve_store || return
    for directory in "$STORE_DIR" "$IMAGE_DIR" "$SNAPSHOT_DIR" "$LOG_DIR" "$EXPORT_DIR"; do
        [[ ! -e $directory || ( -r $directory && -x $directory ) ]] || {
            fail "The store is not readable by this user. Run with sudo to view $STORE_DIR"; return 1;
        }
    done
}

record_event() {
    local descriptor
    exec {descriptor}>>"$STORE_DIR/.activity.lock" || return
    flock "$descriptor" || return
    printf '%s\t%s\t%s\t%s\t%s\n' "$(timestamp)" "$1" "$2" "$3" "$4" >>"$STORE_DIR/activity.tsv"
    exec {descriptor}>&-
}
begin_operation() {
    OPERATION=$1; OP_NAME=$2; PENDING=; WORK=; STAGE=; GUEST_EXITED=
    OP_LOG=$(mktemp "$LOG_DIR/$2-$1-$(date +%Y%m%d-%H%M%S)-XXXXXX.log") || return
    printf '%s  %s  %s\n' "$(timestamp)" "$1" "$2" >>"$OP_LOG"
    trap finish_operation EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
}
finish_operation() {
    local status=$?
    if [[ -n ${PENDING:-} ]]; then rm -f -- "$PENDING" "$PENDING.meta" || true; fi
    if [[ -n ${STAGE:-} ]]; then rm -rf -- "$STAGE" || true; fi
    if [[ -n ${WORK:-} ]]; then
        # Files the worker hands back; its mounts ended with its namespace.
        rm -f -- "$WORK/started" "$WORK/resolv.conf" "$WORK/release" "$WORK/codename" "$WORK/architecture" || true
        rmdir "$WORK/root" "$WORK/lower" "$WORK/overlay" "$WORK" 2>/dev/null || true
    fi
    if (( status == 0 )); then
        printf 'Completed: %s\n' "$(timestamp)" >>"$OP_LOG"
        record_event "$OPERATION" "$OP_NAME" ok "$OP_LOG" || true
    elif [[ -n ${GUEST_EXITED:-} ]]; then
        # The guest's own output explains its exit status; the log adds nothing.
        printf 'Guest exited with status %s: %s\n' "$status" "$(timestamp)" >>"$OP_LOG"
        record_event "$OPERATION" "$OP_NAME" "exit $status" "$OP_LOG" || true
    else
        printf 'Failed with status %s: %s\n' "$status" "$(timestamp)" >>"$OP_LOG"
        record_event "$OPERATION" "$OP_NAME" failed "$OP_LOG" || true
        info "Operation failed (status $status). Log: $OP_LOG"
    fi
    return "$status"
}
make_workdir() { WORK=$(mktemp -d /run/chrootable-manager.XXXXXX); }
# Workers start through $BASH, so a copy without the executable bit (or on a
# noexec mount) works. The parent keeps the image locks; guests never inherit them.
spawn_worker() (
    local lock_fd
    for lock_fd in "${LOCK_FDS[@]}"; do exec {lock_fd}>&-; done
    exec unshare "$@"
)
run_worker() { spawn_worker --mount --uts --ipc --pid --fork --kill-child "$BASH" "$SCRIPT_PATH" --worker "$@"; }
publish_image() {
    local pending=$1 destination=$2
    mv -T -- "$pending.meta" "$destination.meta" || return
    mv -T -- "$pending" "$destination" || return
}

# NAME|SUGGESTED_MIB|MINIMUM_MIB|PACKAGES|DESCRIPTION. Minimums leave room for
# debootstrap's downloads, so an undersized image fails before fetching anything.
PROFILES=(
    'minimal|2048|512||Debian minbase; a clean starting point'
    'build|4096|1536|build-essential git ca-certificates curl pkg-config|C/C++ toolchain, make, Git, curl, pkg-config'
    'python|4096|1024|python3 python3-venv python3-pip git ca-certificates curl|Python 3, venv, pip, Git, curl'
    'network|2048|768|iproute2 iputils-ping dnsutils curl ca-certificates openssh-client|iproute2, ping, DNS tools, curl, SSH client'
)
profile_record() {
    local record
    for record in "${PROFILES[@]}"; do
        [[ ${record%%|*} != "$1" ]] || { printf '%s\n' "$record"; return 0; }
    done
    return 1
}
# Fields: 1 suggested MiB, 2 minimum MiB, 3 packages, 4 description.
profile_field() {
    local record; local -a fields=()
    record=$(profile_record "$1") || return
    IFS='|' read -r -a fields <<<"$record"
    printf '%s\n' "${fields[$2]:-}"
}
profile_packages() { profile_field "$1" 3; }
list_profiles() {
    local format=${1:-text} record package comma='' separator; local -a fields=() packages=()
    if [[ $format == json ]]; then printf '['; else printf '%-10s %-10s %-9s %s\n' PROFILE SUGGESTED MINIMUM INCLUDES; fi
    for record in "${PROFILES[@]}"; do
        IFS='|' read -r -a fields <<<"$record"
        if [[ $format != json ]]; then
            printf '%-10s %-10s %-9s %s\n' "${fields[0]}" "$((fields[1] / 1024)) GiB" "${fields[2]} MiB" "${fields[4]}"
            continue
        fi
        read -r -a packages <<<"${fields[3]}"
        printf '%s{"name":' "$comma"; json_string "${fields[0]}"
        printf ',"suggested_mib":%s,"minimum_mib":%s,"description":' "${fields[1]}" "${fields[2]}"; json_string "${fields[4]}"
        printf ',"packages":['; separator=
        for package in "${packages[@]}"; do printf '%s' "$separator"; json_string "$package"; separator=,; done
        printf ']}'; comma=,
    done
    [[ $format != json ]] || printf ']\n'
}

allocate_image() {
    local target=$1 size_mib=$2
    if command -v fallocate >/dev/null 2>&1 && fallocate -l "${size_mib}M" "$target" >>"$OP_LOG" 2>&1; then
        return 0
    elif truncate -s "${size_mib}M" "$target" >>"$OP_LOG" 2>&1; then
        return 0
    fi
    dd if=/dev/zero of="$target" bs=1M count="$size_mib" status=none conv=fsync >>"$OP_LOG" 2>&1
}
# Allocates only the new tail (sparse clones stay sparse). Never dd: rewriting
# from offset 0 would erase the filesystem.
grow_image_file() {
    local target=$1 current_mib=$2 size_mib=$3
    if command -v fallocate >/dev/null 2>&1 &&
        fallocate -o "${current_mib}M" -l "$((size_mib - current_mib))M" "$target" >>"$OP_LOG" 2>&1; then
        return 0
    fi
    truncate -s "${size_mib}M" "$target" >>"$OP_LOG" 2>&1
}
require_free_space() {
    local directory=$1 bytes=$2 available
    available=$(df -PB1 -- "$directory" | awk 'NR == 2 {print $4}') || return
    [[ $available =~ ^[0-9]+$ ]] || { fail "Could not read the free space of $directory."; return 1; }
    (( available >= bytes )) || {
        fail "Not enough free space in $directory: $(human_bytes "$bytes") needed, $(human_bytes "$available") available."; return 1;
    }
}
# A reflink shares blocks and costs nothing; only a real copy needs the space.
copy_image_file() {
    local source=$1 destination=$2 needed
    cp --reflink=always -- "$source" "$destination" 2>/dev/null && return 0
    needed=$(allocated_bytes "$source") || return
    require_free_space "${destination%/*}" "$needed" || return
    info "Copying $(human_bytes "$needed") (this filesystem has no reflinks)..."
    cp --sparse=always -- "$source" "$destination" >>"$OP_LOG" 2>&1
}
host_architecture() {
    local machine
    if command -v dpkg >/dev/null 2>&1; then dpkg --print-architecture; return; fi
    machine=$(uname -m) || return
    case $machine in
        x86_64) printf 'amd64\n' ;; aarch64) printf 'arm64\n' ;; armv7l|armv8l) printf 'armhf\n' ;;
        i?86) printf 'i386\n' ;; ppc64le) printf 'ppc64el\n' ;; *) printf '%s\n' "$machine" ;;
    esac
}
# Mirrors debootstrap's own script lookup, so a typo fails before allocating.
debootstrap_knows_suite() {
    local scripts=${DEBOOTSTRAP_DIR:-/usr/share/debootstrap}/scripts
    [[ ! -d $scripts || -e $scripts/$1 ]] && return 0
    command -v distro-info >/dev/null 2>&1 || return 1
    debian-distro-info --series "$1" >/dev/null 2>&1 || ubuntu-distro-info --series "$1" >/dev/null 2>&1
}
check_debian_source() {
    valid_suite "$DEBIAN_SUITE" || { fail "CHROOTABLE_DEBIAN_SUITE is not a suite name: $DEBIAN_SUITE"; return 1; }
    valid_mirror "$DEBIAN_MIRROR" || { fail "CHROOTABLE_DEBIAN_MIRROR must be an http(s)://, file:// or ssh:// URL: $DEBIAN_MIRROR"; return 1; }
    debootstrap_knows_suite "$DEBIAN_SUITE" || { fail "debootstrap has no script for '$DEBIAN_SUITE'. Check the name or update debootstrap."; return 1; }
}
# One sanitized line the worker wrote about the guest (record_guest_details).
worker_detail() {
    local value=''
    if [[ -f $WORK/$1 && ! -L $WORK/$1 ]]; then IFS= read -r value <"$WORK/$1" || true; fi
    value=${value//[[:cntrl:]]/}
    printf '%s\n' "${value:0:120}"
}

create_image() (
    local name=$1 size=$2 lifecycle=$3 profile=${4:-minimal} image descriptor arch minimum release
    unused_image "$name" || return
    valid_size_mib "$size" || { fail "Size must be a whole number from 1 to $MAX_SIZE_MIB MiB."; return 1; }
    valid_lifecycle "$lifecycle" || { fail "Lifecycle must be persistent or ephemeral."; return 1; }
    valid_profile "$profile" || { fail "Unknown profile: $profile. See --profiles."; return 1; }
    minimum=$(profile_field "$profile" 2)
    (( size >= minimum )) || { fail "The $profile profile needs at least $minimum MiB ($(profile_field "$profile" 1) MiB suggested)."; return 1; }
    check_debian_source || return
    image="$IMAGE_DIR/$name.img"
    lock_image "$image" descriptor || return
    unused_image "$name" || return
    require_free_space "$IMAGE_DIR" "$((size * 1048576))" || return
    begin_operation create "$name" || return
    PENDING=$(mktemp "$IMAGE_DIR/.$name.XXXXXX.partial") || return
    make_workdir || return
    arch=$(host_architecture) || return
    info "Creating $name / Debian $DEBIAN_SUITE / $profile / $size MiB. Log: $OP_LOG"
    info "Allocating and formatting the image..."
    allocate_image "$PENDING" "$size" || return
    mkfs.ext4 -F -L "${name:0:16}" "$PENDING" >>"$OP_LOG" 2>&1 || return
    info "Bootstrapping Debian $DEBIAN_SUITE; downloading packages takes a few minutes..."
    run_worker create "$PENDING" "$WORK" "$name" "$arch" "$profile" 3>&2 >>"$OP_LOG" 2>&1 || return
    write_metadata "$PENDING" "$lifecycle" "$DEBIAN_SUITE" "$arch" "$size" "$(timestamp)" never "$profile" || return
    release=$(worker_detail release)
    [[ -z $release ]] || metadata_set "$PENDING" release "$release" || return
    publish_image "$PENDING" "$image" || return
    PENDING=
    info "Created '$name'. Enter with: sudo $0 --enter $name"
)
clone_image() (
    # shellcheck disable=SC2034  # destination_lock holds the new name's lock until exit
    local source=$1 name=$2 descriptor destination_lock destination
    unused_image "$name" || return
    lock_image "$source" descriptor || return
    assert_offline "$source" || return
    destination="$IMAGE_DIR/$name.img"
    lock_image "$destination" destination_lock || return
    unused_image "$name" || return
    begin_operation clone "$(basename "$source" .img)" || return
    PENDING=$(mktemp "$IMAGE_DIR/.$name.XXXXXX.partial") || return
    copy_image_file "$source" "$PENDING" || return
    copy_metadata "$source" "$PENDING" || return
    metadata_set "$PENDING" created_at "$(timestamp)" || return
    metadata_set "$PENDING" last_used_at never || return
    metadata_set "$PENDING" origin "$(basename "$source" .img)" || return
    publish_image "$PENDING" "$destination" || return
    PENDING=
    info "Created clone '$name'."
)
fsck_preflight() {
    local status=0
    e2fsck -f -p "$1" >>"$2" 2>&1 || status=$?
    (( status <= 1 ))
}
resize_image() (
    local image=$1 requested=$2 current descriptor
    current=$(image_size_mib "$image") || return
    valid_size_mib "$requested" && (( requested > current )) || { fail "Choose a size larger than $current MiB (maximum $MAX_SIZE_MIB)."; return 1; }
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    # The new capacity is allocated up front like at creation, so a full host
    # disk cannot surface later as I/O errors inside the guest.
    require_free_space "$IMAGE_DIR" "$(( (requested - current) * 1048576 ))" || return
    begin_operation resize "$(basename "$image" .img)" || return
    fsck_preflight "$image" "$OP_LOG" || return
    grow_image_file "$image" "$current" "$requested" || return
    resize2fs "$image" >>"$OP_LOG" 2>&1 || return
    metadata_set "$image" size_mib "$requested" || return
    info "Expanded '$(basename "$image" .img)' to $requested MiB."
)
repair_image() (
    local image=$1 descriptor status=0
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation repair "$(basename "$image" .img)" || return
    e2fsck -f -y "$image" >>"$OP_LOG" 2>&1 || status=$?
    (( status <= 1 )) || return "$status"
    info "Filesystem repair completed. Log: $OP_LOG"
)
export_image() (
    local image=$1 name descriptor archive token checksum
    name=$(basename "$image" .img)
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation export "$name" || return
    make_workdir || return
    PENDING=$(mktemp "$EXPORT_DIR/.$name.XXXXXX.partial") || return
    token=${PENDING%.partial}; token=${token##*.}
    archive="$EXPORT_DIR/$name-$(date +%Y%m%d-%H%M%S)-$token.tar.gz"
    info "Packing the filesystem into ${archive##*/}..."
    run_worker export "$image" "$WORK" "$PENDING" >>"$OP_LOG" 2>&1 || return
    info "Computing the checksum..."
    checksum=$(sha256sum -- "$PENDING") || return
    mv -T -- "$PENDING" "$archive" || return
    PENDING=
    # --import verifies the archive against this file when it sits beside it.
    printf '%s  %s\n' "${checksum%% *}" "${archive##*/}" >"$archive.sha256" || return
