unsafe_archive_path() { [[ $1 == /* || $1 == ../* || $1 == */../* || $1 == */.. || $1 == .. ]]; }
validate_tar_archive() {
    local archive=$1 perms owner bytes day clock entry target type payload=0 entries=0 status= entry_bytes
    gzip -t -- "$archive" 2>/dev/null || { fail "Archive is not a valid gzip-compressed file: $archive"; return 1; }
    # GNU tar quotes control characters in names, so each entry is one line and
    # --numeric-owner keeps the owner a single field. --absolute-names shows names
    # as stored, not with a leading / already removed. The status line cannot be
    # confused with an entry, whose first field is always a mode string.
    while read -r perms owner bytes day clock entry; do
        if [[ $perms == status ]]; then status=$owner; continue; fi
        type=${perms:0:1}
        target=
        # Symlink targets may be absolute: GNU tar defers them until extraction ends.
        case $type in
            l) entry=${entry%% -> *} ;;
            h) target=${entry#* link to }; entry=${entry%% link to *} ;;
        esac
        if unsafe_archive_path "$entry" || { [[ -n $target ]] && unsafe_archive_path "$target"; }; then
            fail "Unsafe path in archive: $entry"
            return 1
        fi
        entry_bytes=0
        case $type in
            -) [[ $bytes =~ ^(0|[1-9][0-9]{0,12})$ ]] && (( bytes <= 1099511627776 )) || {
                   fail "Archive entry size is invalid or exceeds the supported 1048576 MiB capacity limit: $entry"; return 1;
