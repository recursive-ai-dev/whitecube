    rmdir -- "$SNAPSHOT_DIR/$name" 2>/dev/null || true
    info "Deleted snapshot '$name / $label'."
)
list_snapshots() {
    local name=$1 format=${2:-text} snapshot comma=
    valid_name "$name" || { fail "Invalid image name."; return 1; }
    [[ $format != json ]] || printf '['
    for snapshot in "$SNAPSHOT_DIR/$name/"*.img; do
        [[ -f $snapshot && ! -L $snapshot ]] || continue
        if [[ $format != json ]]; then
            printf '%s\t%s MiB\t%s\n' "$(basename "$snapshot" .img)" "$(image_size_mib "$snapshot")" "$(metadata_value "$snapshot" snapshot_at unknown)"
            continue
        fi
        printf '%s{"label":' "$comma"; json_string "$(basename "$snapshot" .img)"
        printf ',"snapshot_at":'; json_string "$(metadata_value "$snapshot" snapshot_at unknown)"
        printf ',"path":'; json_string "$snapshot"
        printf ',"size_mib":%s,"allocated_bytes":%s}' "$(image_size_mib "$snapshot")" "$(allocated_bytes "$snapshot")"
        comma=,
    done
    [[ $format != json ]] || printf ']\n'
    return 0
}

enter_chrootable() (
    local image=$1 lifecycle=$2 network=$3 descriptor status=0 name
    shift 3
    name=$(basename "$image" .img)
    if [[ $lifecycle == ephemeral && -n $EPHEMERAL_SIZE ]] && ! valid_tmpfs_size "$EPHEMERAL_SIZE"; then
        fail "CHROOTABLE_EPHEMERAL_SIZE must look like 2G, 512M or 50%: $EPHEMERAL_SIZE"; return 1
    fi
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation session "$name" || return
    make_workdir || return
    local -a namespace=(--mount --uts --ipc --pid --fork --kill-child)
    [[ $network != isolated ]] || namespace+=(--net)
    spawn_worker "${namespace[@]}" "$BASH" "$SCRIPT_PATH" --worker enter "$image" "$WORK" "$name" "$lifecycle" "$network" "$@" || status=$?
    # A worker marker distinguishes a guest command failure from mount failure.
    if [[ -f $WORK/started ]]; then
        GUEST_EXITED=1
        metadata_set "$image" last_used_at "$(timestamp)" || info "Could not record the last-used time."
    fi
    return "$status"
)
worker_cleanup() {
    local status=$? cleanup_status=0
    cd / || true
    # Only PID 1 of the session's own namespace may signal "every process".
    if (( $$ == 1 )); then
        kill -TERM -1 2>/dev/null || true
        sleep 0.05 2>/dev/null || true
        kill -KILL -1 2>/dev/null || true
    fi
    if mountpoint -q "$WORKER_ROOT/etc/resolv.conf"; then umount "$WORKER_ROOT/etc/resolv.conf" 2>/dev/null || true; fi
    if mountpoint -q "$WORKER_ROOT/dev/ptmx"; then umount "$WORKER_ROOT/dev/ptmx" 2>/dev/null || true; fi
    if mountpoint -q "$WORKER_ROOT/dev/pts"; then umount "$WORKER_ROOT/dev/pts" 2>/dev/null || true; fi
    if mountpoint -q "$WORKER_ROOT"; then umount -R "$WORKER_ROOT" 2>/dev/null || umount -l "$WORKER_ROOT" || cleanup_status=$?; fi
    if mountpoint -q "$WORKER_LOWER"; then umount "$WORKER_LOWER" 2>/dev/null || umount -l "$WORKER_LOWER" || cleanup_status=$?; fi
    if mountpoint -q "$WORKER_OVERLAY"; then umount "$WORKER_OVERLAY" 2>/dev/null || umount -l "$WORKER_OVERLAY" || cleanup_status=$?; fi
    (( status != 0 || cleanup_status == 0 )) || status=$cleanup_status
