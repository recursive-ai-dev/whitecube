        choice=$(ui --cancel-button Back --menu "$name / Recovery points\n\nRestoring saves the current image as a recovery snapshot first." "$UI_HEIGHT" "$UI_WIDTH" "$((UI_HEIGHT - 11))" "${entries[@]}" 3>&1 1>&2 2>&3) || return 0
