# Capacity needed for payload bytes across a number of filesystem entries. For a
# capacity C, mke2fs leaves about 0.93 C for data: 5% is reserved for root,
# 256-byte inodes per 16 KiB take 1.5625%, and bitmaps and descriptors stay under
# 0.5%. The journal J(C) is a step function of C and never shrinks as C grows, so
# iterating C = (payload + J(C)) / 0.93 upward reaches a fixed point. Inodes add
# the bound C >= (entries + 16) * 16 KiB: inode numbers 1-10 are reserved,
# lost+found and orphan metadata consume more, and 16 leaves a small margin.
# Import explicitly sets block/inode sizes, density and reserved space to match
# this calculation. Round each candidate to MiB before reevaluating J(C), because
# rounding itself can cross a journal-size threshold. The minimum is 512 MiB.
# tests/test_cli_operations.py checks all of this against a real mke2fs.
journal_bytes_for() {
    local blocks=$(($1 / 4096))
    if (( blocks < 32768 )); then printf 4194304
    elif (( blocks < 262144 )); then printf 16777216
    elif (( blocks < 524288 )); then printf 33554432
    elif (( blocks < 4194304 )); then printf 67108864
    elif (( blocks < 8388608 )); then printf 134217728
    elif (( blocks < 16777216 )); then printf 268435456
    elif (( blocks < 33554432 )); then printf 536870912
    else printf 1073741824; fi
}
required_capacity_mib() {
    local payload=$1 entries=$2 capacity=536870912 next journal
    # The supported capacity is at most 1 TiB. Enforce that bound before any
    # arithmetic: Bash integers wrap, including multiplication by 100 below.
    # At 16 KiB per inode the largest image has 2^26 inodes, including 16 reserved
    # here for the filesystem's initial structures rather than archive entries.
    [[ $payload =~ ^(0|[1-9][0-9]{0,12})$ && $entries =~ ^(0|[1-9][0-9]{0,7})$ ]] &&
        (( payload <= 1099511627776 && entries <= 67108848 )) || {
        fail "Archive contents exceed the supported 1048576 MiB capacity limit."; return 1;
    }
    while :; do
        journal=$(journal_bytes_for "$capacity")
        next=$(( (payload + journal) * 100 / 93 + 1 ))
        (( next > (entries + 16) * 16384 )) || next=$(((entries + 16) * 16384))
        next=$(((next + 1048575) / 1048576 * 1048576))
        (( next <= 1099511627776 )) || {
            fail "Archive contents exceed the supported 1048576 MiB capacity limit."; return 1;
        }
        (( next > capacity )) || break
        capacity=$next
    done
    printf '%s' "$((capacity / 1048576))"
}
# debootstrap creates exactly these nodes; anything else could reach a host device
