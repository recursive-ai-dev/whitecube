    while true; do
        entries=(/search "Filter workspaces by name")
        for image in "$IMAGE_DIR/"*.img; do
            [[ -f $image && ! -L $image ]] || continue
            name=$(basename "$image" .img); valid_name "$name" || continue
            [[ ${name,,} == *"${filter,,}"* ]] || continue
            entries+=("$name" "$(image_status "$image") / $(image_lifecycle "$image") / $(image_size_mib "$image") MiB / $(metadata_value "$image" profile minimal)")
        done
        choice=$(ui --cancel-button Back --menu "Your workspaces\nFilter: ${filter:-all}  |  Choose a workspace to open its tools." "$UI_HEIGHT" "$UI_WIDTH" "$((UI_HEIGHT - 10))" "${entries[@]}" 3>&1 1>&2 2>&3) || return 0
        if [[ $choice == /search ]]; then
            filter=$(ui --inputbox "Name contains (leave empty to show all):" 10 "$UI_WIDTH" "$filter" 3>&1 1>&2 2>&3) || filter=
        else image_action_menu "$IMAGE_DIR/$choice.img"; fi
    done
}
recovery_library() {
    local directory name choice; local -a entries=()
    for directory in "$SNAPSHOT_DIR/"*/; do
