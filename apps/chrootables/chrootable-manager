# Bootable exports start through Debian's Microsoft-signed shim, which accepts
# the UKI because it is signed with this Machine Owner Key. Each machine
# enrolls MOK.cer once; shim offers MokManager when it is not enrolled yet.
ensure_signing_key() {
    local directory="$STORE_DIR/secureboot" subject
    SIGNING_KEY="$directory/MOK.key"; SIGNING_CERT="$directory/MOK.crt"; SIGNING_DER="$directory/MOK.cer"
    if [[ -e $directory || -L $directory ]]; then owned_private_directory "$directory" || return
    else install -d -m 0700 "$directory" || return; fi
    [[ -f $SIGNING_KEY && -f $SIGNING_CERT && -f $SIGNING_DER ]] && return 0
    info "Generating a Secure Boot signing key (Machine Owner Key) in $directory..."
    subject="/CN=Chrootable Manager MOK ${HOSTNAME//[^A-Za-z0-9.-]/}/"
    openssl req -new -x509 -newkey rsa:2048 -nodes -sha256 -days 3650 -subj "$subject" \
        -keyout "$SIGNING_KEY.partial" -out "$SIGNING_CERT.partial" >>"$OP_LOG" 2>&1 &&
        openssl x509 -in "$SIGNING_CERT.partial" -outform DER -out "$SIGNING_DER.partial" >>"$OP_LOG" 2>&1 || {
        rm -f -- "$SIGNING_KEY.partial" "$SIGNING_CERT.partial" "$SIGNING_DER.partial"; return 1;
    }
    # The certificate goes last: its presence marks a complete set.
    mv -T -- "$SIGNING_KEY.partial" "$SIGNING_KEY" && mv -T -- "$SIGNING_DER.partial" "$SIGNING_DER" &&
        mv -T -- "$SIGNING_CERT.partial" "$SIGNING_CERT" || return
    NEW_SIGNING_KEY=1
}
# FAT image with shim as the removable-media loader; shim starts grubx64.efi
# from its own directory, which here is the signed UKI.
make_esp() {
    local esp=$1 size_mib=$2 fat=()
    (( size_mib < 64 )) || fat=(-F 32)
    mkfs.vfat -C "${fat[@]}" -n CHROOTABLE "$esp" "$((size_mib * 1024))" >>"$OP_LOG" 2>&1 || return
    export MTOOLS_SKIP_CHECK=1
    mmd -i "$esp" ::/EFI ::/EFI/BOOT >>"$OP_LOG" 2>&1 &&
        mcopy -i "$esp" "$STAGE/shimx64.efi" ::/EFI/BOOT/BOOTX64.EFI &&
        mcopy -i "$esp" "$STAGE/mmx64.efi" ::/EFI/BOOT/mmx64.efi &&
        mcopy -i "$esp" "$STAGE/grubx64.efi" ::/EFI/BOOT/grubx64.efi &&
        mcopy -i "$esp" "$SIGNING_DER" ::/MOK.cer
}
gpt_disk() {
    local disk=$1 esp=$2 root=$3 name=$4 esp_mib root_mib
    esp_mib=$(image_size_mib "$esp") && root_mib=$(image_size_mib "$root") || return
    truncate -s "$((esp_mib + root_mib + 2))M" "$disk" || return
    # 8304: Linux x86-64 root, so systemd-gpt-auto-generator recognizes it too.
    sgdisk -o -n "1:1M:+${esp_mib}M" -t 1:ef00 -c 1:ESP \
        -n "2:$((esp_mib + 1))M:+${root_mib}M" -t 2:8304 -c "2:$name" "$disk" >>"$OP_LOG" 2>&1 || return
    dd if="$esp" of="$disk" bs=1M seek=1 conv=notrunc status=none 2>>"$OP_LOG" &&
        dd if="$root" of="$disk" bs=1M seek="$((esp_mib + 1))" conv=notrunc,sparse status=none 2>>"$OP_LOG"
}
# EFI-only hybrid: El Torito points at the appended ESP, which is also a GPT
# partition, so the same file boots from optical media and from a USB stick.
hybrid_iso() {
    local iso=$1 esp=$2 tree=$3
    xorriso -as mkisofs -iso-level 3 -R -J -V CHROOTABLE -o "$iso" -partition_offset 16 \
        -append_partition 2 0xef "$esp" -appended_part_as_gpt \
        -e --interval:appended_partition_2:all:: -no-emul-boot "$tree" >>"$OP_LOG" 2>&1
}
# A copy of the workspace gets a kernel, systemd and a UKI; the workspace itself
# never changes. iso: squashfs root under live-boot, writes stay in RAM.
# disk: GPT with an ESP and the copy as a persistent ext4 root partition.
boot_export() (
    local image=$1 kind=$2 name descriptor token output copy size_mib needed uuid='' esp esp_mib checksum
    name=$(basename "$image" .img)
    [[ $(metadata_value "$image" architecture unknown) == amd64 ]] || { fail "Bootable exports support amd64 workspaces only."; return 1; }
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation "export-$kind" "$name" || return
    ensure_commands "${BOOT_COMMANDS[@]}" || return
    ensure_signing_key || return
    size_mib=$(image_size_mib "$image") || return
    needed=$(allocated_bytes "$image") || return
    require_free_space "$EXPORT_DIR" "$(( 2 * (needed + BOOT_EXTRA_MIB * 1048576) + BOOT_ESP_MIB * 1048576 ))" || return
    STAGE=$(mktemp -d "$EXPORT_DIR/.$name.XXXXXX.stage") || return
    token=${STAGE%.stage}; token=${token##*.}
    output="$EXPORT_DIR/$name-$(date +%Y%m%d-%H%M%S)-$token.$kind"
    [[ $kind != disk ]] || output=${output%.disk}.img
    PENDING="$STAGE/output.partial"
    make_workdir || return
    copy="$STAGE/root.img"
    info "Copying the workspace. Log: $OP_LOG"
    copy_image_file "$image" "$copy" || return
    fsck_preflight "$copy" "$OP_LOG" || { fail "The workspace filesystem needs a repair first: sudo $0 --repair $name --yes"; return 1; }
    grow_image_file "$copy" "$size_mib" "$((size_mib + BOOT_EXTRA_MIB))" || return
    resize2fs "$copy" >>"$OP_LOG" 2>&1 || return
    if [[ $kind == disk ]]; then
        # A fresh UUID, so the exported root never collides with the workspace.
        uuid=$(</proc/sys/kernel/random/uuid) || return
        tune2fs -U "$uuid" "$copy" >>"$OP_LOG" 2>&1 || return
    fi
    info "Installing a kernel and building the UKI; downloading packages takes a few minutes..."
    run_worker boot "$copy" "$WORK" "$kind" "$name" "$STAGE" "$uuid" 3>&2 >>"$OP_LOG" 2>&1 || return
    info "Signing the UKI with $SIGNING_CERT..."
    sbsign --key "$SIGNING_KEY" --cert "$SIGNING_CERT" --output "$STAGE/grubx64.efi" "$STAGE/uki.efi" >>"$OP_LOG" 2>&1 || return
    esp="$STAGE/esp.img"
    if [[ $kind == disk ]]; then
        esp_mib=$BOOT_ESP_MIB
    else
        esp_mib=$(du -cm --apparent-size -- "$STAGE"/{shimx64,mmx64,grubx64}.efi | awk 'END {print $1}') || return
        esp_mib=$((esp_mib + 16))
    fi
    make_esp "$esp" "$esp_mib" || return
    if [[ $kind == disk ]]; then
        info "Writing the GPT disk image..."
        gpt_disk "$PENDING" "$esp" "$copy" "$name" || return
    else
        info "Compressing the root filesystem..."
        mkdir -p "$STAGE/iso/live" || return
        run_worker squash "$copy" "$WORK" "$STAGE/iso/live/filesystem.squashfs" 3>&2 >>"$OP_LOG" 2>&1 || return
        info "Writing the hybrid ISO..."
        hybrid_iso "$PENDING" "$esp" "$STAGE/iso" || return
    fi
    info "Computing the checksum..."
    checksum=$(sha256sum -- "$PENDING") || return
    mv -T -- "$PENDING" "$output" || return
    PENDING=
    printf '%s  %s\n' "${checksum%% *}" "${output##*/}" >"$output.sha256" || return
    [[ -z ${NEW_SIGNING_KEY:-} ]] || info "New signing key: enroll it once per machine with
  sudo mokutil --import $SIGNING_DER
or choose 'Enroll key from disk' > MOK.cer when shim opens MokManager at boot."
    printf '%s\n' "$output"
)
# Takes --export archives and other root filesystem tarballs (tar detects gzip,
# xz or zstd). A NAME.sha256 file beside the archive is verified first.
import_image() (
    local name=$1 archive=$2 size=$3 lifecycle=$4 image descriptor expected actual suite architecture release origin
    unused_image "$name" || return
    valid_size_mib "$size" || { fail "Size must be a whole number from 1 to $MAX_SIZE_MIB MiB."; return 1; }
    valid_lifecycle "$lifecycle" || { fail "Lifecycle must be persistent or ephemeral."; return 1; }
    archive=$(readlink -f -- "$archive") && [[ -f $archive && -r $archive ]] || { fail "Archive not found or unreadable: $2"; return 1; }
    image="$IMAGE_DIR/$name.img"
    lock_image "$image" descriptor || return
    unused_image "$name" || return
    require_free_space "$IMAGE_DIR" "$((size * 1048576))" || return
    begin_operation import "$name" || return
    if [[ -f $archive.sha256 ]]; then
        read -r expected _ <"$archive.sha256" || true
        actual=$(sha256sum -- "$archive") || return
        [[ ${actual%% *} == "${expected:-}" ]] || { fail "Checksum mismatch: $archive is damaged or was changed."; return 1; }
        info "Checksum verified: ${archive##*/}"
    fi
    PENDING=$(mktemp "$IMAGE_DIR/.$name.XXXXXX.partial") || return
    make_workdir || return
    info "Importing $name from ${archive##*/} / $size MiB. Log: $OP_LOG"
    allocate_image "$PENDING" "$size" || return
    mkfs.ext4 -F -L "${name:0:16}" "$PENDING" >>"$OP_LOG" 2>&1 || return
    info "Unpacking the archive..."
    run_worker import "$PENDING" "$WORK" "$archive" 3>&2 >>"$OP_LOG" 2>&1 || {
        fail "Extraction failed. If the log reports no space left, import with a larger size. Log: $OP_LOG"; return 1;
    }
    suite=$(worker_detail codename); [[ $suite =~ ^[a-z][a-z0-9.+-]*$ ]] || suite=unknown
    architecture=$(worker_detail architecture); [[ $architecture =~ ^[a-z0-9][a-z0-9-]*$ ]] || architecture=unknown
    origin=${archive##*/}; origin=${origin//[[:cntrl:]]/}
    write_metadata "$PENDING" "$lifecycle" "$suite" "$architecture" "$size" "$(timestamp)" never imported "$origin" || return
    release=$(worker_detail release)
    [[ -z $release ]] || metadata_set "$PENDING" release "$release" || return
    publish_image "$PENDING" "$image" || return
    PENDING=
    info "Imported '$name'. Enter with: sudo $0 --enter $name"
)
set_lifecycle() (
    local image=$1 lifecycle=$2 descriptor name
    name=$(basename "$image" .img)
    valid_lifecycle "$lifecycle" || { fail "Lifecycle must be persistent or ephemeral."; return 1; }
    lock_image "$image" descriptor || return
    if [[ $(image_lifecycle "$image") == "$lifecycle" ]]; then info "'$name' already uses $lifecycle sessions."; return 0; fi
    begin_operation mode "$name" || return
    metadata_set "$image" lifecycle "$lifecycle" || return
    info "'$name' now uses $lifecycle sessions."
)
describe_image() (
    local image=$1 description=$2 descriptor name
    name=$(basename "$image" .img)
    valid_description "$description" || { fail "A description is at most 200 characters, without control characters."; return 1; }
    lock_image "$image" descriptor || return
    begin_operation describe "$name" || return
    metadata_set "$image" description "$description" || return
    if [[ -n $description ]]; then info "Updated the description of '$name'."; else info "Cleared the description of '$name'."; fi
)
# Snapshots follow the workspace; logs and journal entries keep the old name.
rename_image() (
    # shellcheck disable=SC2034  # destination_lock holds the new name's lock until exit
    local image=$1 new_name=$2 name descriptor destination destination_lock
    name=$(basename "$image" .img)
    [[ $new_name != "$name" ]] || { fail "'$name' already has that name."; return 1; }
    unused_image "$new_name" || return
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    destination="$IMAGE_DIR/$new_name.img"
    lock_image "$destination" destination_lock || return
    unused_image "$new_name" || return
    [[ ! -e $SNAPSHOT_DIR/$new_name && ! -L $SNAPSHOT_DIR/$new_name ]] || {
        fail "Snapshots named '$new_name' remain from a deleted workspace. Restore or drop them, or pick another name."; return 1;
    }
    begin_operation rename "$name" || return
    if [[ -f $image.meta ]]; then mv -T -- "$image.meta" "$destination.meta" || return; fi
    if ! mv -T -- "$image" "$destination"; then
        if [[ -f $destination.meta ]]; then mv -T -- "$destination.meta" "$image.meta" || true; fi
        return 1
    fi
    if [[ -f $image.mode ]]; then mv -T -- "$image.mode" "$destination.mode" || return; fi
    if [[ -d $SNAPSHOT_DIR/$name && ! -L $SNAPSHOT_DIR/$name ]]; then
        mv -T -- "$SNAPSHOT_DIR/$name" "$SNAPSHOT_DIR/$new_name" || return
    fi
    e2label "$destination" "${new_name:0:16}" >>"$OP_LOG" 2>&1 || true
    info "Renamed '$name' to '$new_name'."
)
delete_image() (
    local image=$1 descriptor
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation delete "$(basename "$image" .img)" || return
    rm -f -- "$image" "$image.meta" "$image.mode" || return
    info "Deleted '$(basename "$image" .img)'. Snapshots and exports were retained."
)

snapshot_path() {
    valid_name "$1" && valid_name "$2" || { fail "Invalid image name or snapshot label."; return 1; }
    [[ ! -L $SNAPSHOT_DIR/$1 ]] || { fail "Snapshot directories must not be symlinks."; return 1; }
    printf '%s/%s/%s.img\n' "$SNAPSHOT_DIR" "$1" "$2"
}
# Caller holds the image lock throughout snapshot/restore, including copies.
save_snapshot_locked() {
    local image=$1 label=$2 name destination
    name=$(basename "$image" .img)
    destination=$(snapshot_path "$name" "$label") || return
    [[ ! -e $destination && ! -L $destination ]] || { fail "Snapshot '$label' already exists."; return 1; }
    install -d -m 0700 "$SNAPSHOT_DIR/$name" || return
    PENDING=$(mktemp "$SNAPSHOT_DIR/$name/.$label.XXXXXX.partial") || return
    copy_image_file "$image" "$PENDING" || return
    copy_metadata "$image" "$PENDING" || return
    metadata_set "$PENDING" snapshot_at "$(timestamp)" || return
    publish_image "$PENDING" "$destination" || return
    PENDING=
    info "Saved snapshot '$label' for '$name'."
}
snapshot_image() (
    local image=$1 label=$2 descriptor destination
    valid_name "$label" || { fail "Invalid snapshot label."; return 1; }
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    destination=$(snapshot_path "$(basename "$image" .img)" "$label") || return
    [[ ! -e $destination && ! -L $destination ]] || { fail "Snapshot '$label' already exists."; return 1; }
    begin_operation snapshot "$(basename "$image" .img)" || return
    save_snapshot_locked "$image" "$label"
)
restore_image() (
    local name=$1 label=$2 image snapshot descriptor recovery
    snapshot=$(snapshot_path "$name" "$label") || return
    [[ -f $snapshot && ! -L $snapshot ]] || { fail "Snapshot not found: $name / $label"; return 1; }
    image="$IMAGE_DIR/$name.img"
    [[ ! -L $image ]] || { fail "Refusing a symlink image."; return 1; }
    lock_image "$image" descriptor || return
    assert_offline "$snapshot" || return
    if [[ -e $image ]]; then assert_offline "$image" || return; fi
    begin_operation restore "$name" || return
    if [[ -f $image ]]; then
        recovery="before-restore-$(date +%Y%m%d-%H%M%S)-$BASHPID"
        save_snapshot_locked "$image" "$recovery" || return
    fi
    PENDING=$(mktemp "$IMAGE_DIR/.$name.XXXXXX.partial") || return
    copy_image_file "$snapshot" "$PENDING" || return
    copy_metadata "$snapshot" "$PENDING" || return
    metadata_set "$PENDING" restored_from "$label" || return
    metadata_set "$PENDING" restored_at "$(timestamp)" || return
    publish_image "$PENDING" "$image" || return
    PENDING=
    info "Restored '$name' from '$label'."
    [[ -z ${recovery:-} ]] || info "Undo this restore with: sudo $0 --restore $name $recovery --yes"
)
drop_snapshot() (
    local name=$1 label=$2 snapshot descriptor
    snapshot=$(snapshot_path "$name" "$label") || return
    [[ -f $snapshot && ! -L $snapshot ]] || { fail "Snapshot not found: $name / $label"; return 1; }
    lock_image "$IMAGE_DIR/$name.img" descriptor || return
    assert_offline "$snapshot" || return
    begin_operation drop-snapshot "$name" || return
    rm -f -- "$snapshot" "$snapshot.meta" || return
