ui_run() {
    if (( DEMO )); then ui_message "This is a read-only demo.\n\nRun sudo $0 to create real workspaces and use this action."; return; fi
    local output marker ticker status=0 heading
    output=$(mktemp /tmp/chrootable-result.XXXXXX) || return
    marker=$(mktemp /tmp/chrootable-start.XXXXXX) || { rm -f -- "$output"; return 1; }
    touch -d '1 second ago' "$marker" 2>/dev/null || true
    ui_progress "$marker" &
    ticker=$!
    "$@" >"$output" 2>&1 || status=$?
    kill "$ticker" 2>/dev/null || true
    wait "$ticker" 2>/dev/null || true
    heading="Operation completed"
    (( status == 0 )) || heading="Operation failed (status $status)"
    ui_view "$heading" "$(tail -n 30 "$output")" || true
    rm -f -- "$output" "$marker"
}
# Redraws the progress box every two seconds with the elapsed time and the
# newest line of the running operation's log, until ui_run stops it.
ui_progress() {
    local marker=$1 started=$SECONDS log latest line
    while kill -0 "$$" 2>/dev/null; do
        latest=
        for log in "$LOG_DIR"/*.log; do
            [[ -f $log && $log -nt $marker ]] || continue
            [[ -n $latest && ! $log -nt $latest ]] || latest=$log
        done
        line=
        if [[ -n $latest ]]; then line=$(tail -n 1 -- "$latest" 2>/dev/null) || line=; fi
        line=${line//[[:cntrl:]\\]/}
        ui --infobox "Working... $((SECONDS - started))s\n\n${line:0:$((UI_WIDTH - 6))}\n\nDetailed logs: $LOG_DIR" 10 "$UI_WIDTH" || true
        sleep 2
    done
}
ui_session() {
    local image=$1 lifecycle=$2 network=$3 status=0
    if (( DEMO )); then ui_message "This preview never mounts an image.\n\nIn a real workspace, this opens a $lifecycle shell with $network networking. Exit returns you to this menu."; return; fi
    printf '\033[H\033[2J'
    enter_chrootable "$image" "$lifecycle" "$network" || status=$?
    (( status == 0 )) || ui_message "The session ended with status $status.\n\nA shell reports the status of its last command. If the session never started, Recent log explains why."
    return 0
}
# NAME, or NAME-2, NAME-3 ... when taken (always a valid name).
unique_name() {
    local base=${1:0:60} candidate=${1:0:64} number=2
    while [[ -e $IMAGE_DIR/$candidate.img || -L $IMAGE_DIR/$candidate.img ]]; do
        candidate="$base-$number"; number=$((number + 1))
    done
    printf '%s\n' "$candidate"
}
choose_lifecycle() {
    ui --menu "How should this workspace remember changes?" 13 "$UI_WIDTH" 2 \
        persistent "Keep changes after each session" ephemeral "Discard session writes; reuse the base image" 3>&1 1>&2 2>&3
}
create_chrootable() {
    local name profile size lifecycle suggested minimum record; local -a entries=() fields=()
    for record in "${PROFILES[@]}"; do IFS='|' read -r -a fields <<<"$record"; entries+=("${fields[0]}" "${fields[4]}"); done
    profile=$(ui --menu "Start with a purpose. Each profile is Debian minbase plus a focused set of tools." 16 "$UI_WIDTH" 4 \
        "${entries[@]}" 3>&1 1>&2 2>&3) || return 0
    name=$(ui --inputbox "Workspace name (letters, digits, dot, underscore, hyphen):" 10 "$UI_WIDTH" "$(unique_name "$profile-lab")" 3>&1 1>&2 2>&3) || return 0
