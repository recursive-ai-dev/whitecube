}
# Guest DNS: the host's resolvers minus loopback stubs (systemd-resolved's
# 127.0.0.53, ::1) that a chroot cannot reach; fallbacks when none remain.
setup_resolv_conf() {
    local work=$1 root=$2
    local target="$root/etc/resolv.conf" dest="$work/resolv.conf" source_file server; local -a servers=()
    for source_file in /run/systemd/resolve/resolv.conf /etc/resolv.conf ''; do
        [[ -z $source_file || ( -f $source_file && -r $source_file ) ]] && break
    done
    : >"$dest" || return
    if [[ -n $source_file ]]; then
        awk '$1 == "nameserver" && ($2 ~ /^127\./ || $2 == "::1") {next} {print}' "$source_file" >"$dest" || true
    fi
    if ! awk '$1 == "nameserver" {found = 1} END {exit !found}' "$dest"; then
        read -r -a servers <<<"$FALLBACK_DNS"
        for server in "${servers[@]}"; do
            if [[ $server =~ ^[0-9A-Fa-f.:]+$ ]]; then printf 'nameserver %s\n' "$server"; fi
        done >>"$dest"
    fi
    # Never follow a guest symlink here: it would resolve against the host.
    [[ -d $root/etc && ! -L $root/etc ]] || return 0
    if [[ -L $target || ( -e $target && ! -f $target ) ]]; then
        info "Keeping the guest's own /etc/resolv.conf because it is not a regular file."
        return 0
    fi
    [[ -e $target ]] || : >"$target" || return 0
    mount --bind "$dest" "$target" || info "Could not share the host's DNS settings with the guest."
}
# Full-screen programs need terminfo for $TERM inside the guest. Minbase ships
# only a few entries (no foot, kitty or alacritty): fall back to xterm-256color.
guest_terminal() {
    local root=$1 term=${TERM:-xterm} directory
    if [[ $term =~ ^[A-Za-z0-9][A-Za-z0-9.+_-]*$ ]]; then
        for directory in etc/terminfo usr/share/terminfo usr/lib/terminfo lib/terminfo; do
            [[ ! -e $root/$directory/${term:0:1}/$term ]] || { printf '%s\n' "$term"; return; }
        done
    fi
    printf 'xterm-256color\n'
}
# A host locale the guest never generated makes perl and apt warn on every
# command; C.UTF-8 always exists.
guest_locale() {
    local root=$1 lang=${LANG:-C.UTF-8}
    case $lang in C|POSIX|C.UTF-8|C.utf8) printf '%s\n' "$lang"; return ;; esac
    if [[ $lang =~ ^[A-Za-z0-9_.@-]+$ && -f $root/usr/lib/locale/locale-archive && -f $root/etc/locale.gen ]] &&
        awk -v want="$lang" '$1 == want {found = 1} END {exit !found}' "$root/etc/locale.gen"; then
        printf '%s\n' "$lang"
    else printf 'C.UTF-8\n'; fi
}
# Facts for the parent's metadata, one line per file; the parent sanitizes them.
record_guest_details() {
    local root=$1 work=$2
    awk '/^PRETTY_NAME=/ {sub(/^PRETTY_NAME=/, ""); gsub(/^"|"$/, ""); print; exit}' "$root/etc/os-release" >"$work/release" 2>/dev/null || true
    awk -F= '$1 == "VERSION_CODENAME" {gsub(/"/, "", $2); print $2; exit}' "$root/etc/os-release" >"$work/codename" 2>/dev/null || true
    awk '$0 == "Package: dpkg" {found = 1; next} found && /^Architecture:/ {print $2; exit} /^$/ {found = 0}' \
        "$root/var/lib/dpkg/status" >"$work/architecture" 2>/dev/null || true
}
# Cleanup signals every process in its PID namespace and the worker makes all
# mounts private: refuse to run anywhere but in the namespaces spawn_worker makes.
worker_isolated() {
    local own host
    (( $$ == 1 )) || { fail "--worker is internal and must run as PID 1 of a new PID namespace."; return 1; }
    own=$(readlink /proc/self/ns/mnt 2>/dev/null) || own=
    host=$(readlink /proc/1/ns/mnt 2>/dev/null) || host=
    [[ -z $own || $own != "$host" ]] || { fail "--worker is internal and must run in a new mount namespace."; return 1; }
}
mount_session_devices() {
    mkdir -p "$WORKER_ROOT/proc" "$WORKER_ROOT/dev" "$WORKER_ROOT/run" || return
    mount -t proc proc "$WORKER_ROOT/proc" || return
    mount --rbind /dev "$WORKER_ROOT/dev" || return
    mount --make-rslave "$WORKER_ROOT/dev" || return
    if mkdir -p "$WORKER_ROOT/dev/pts" 2>/dev/null; then
        mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 devpts "$WORKER_ROOT/dev/pts" 2>/dev/null &&
            mount --bind "$WORKER_ROOT/dev/pts/ptmx" "$WORKER_ROOT/dev/ptmx" 2>/dev/null || true
    fi
    mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$WORKER_ROOT/run"
}
# A clean environment for guest tools: host locale and variables stay out of the log.
GUEST_ENV=(/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8 DEBIAN_FRONTEND=noninteractive)
# stdin to a guest path, created with ordinary permissions despite umask 077.
guest_write() { chroot "$WORKER_ROOT" /bin/sh -c 'umask 022; mkdir -p "${1%/*}" && cat >"$1"' sh "$1"; }
worker_main() (
    local kind=$1 image=$2 work=$3
    shift 3
    require_root || return
    worker_isolated || return
    WORKER_ROOT="$work/root"; WORKER_LOWER="$work/lower"; WORKER_OVERLAY="$work/overlay"
    trap worker_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    mount --make-rprivate / || return
    mkdir -p "$WORKER_ROOT" || return
    case $kind in
        create)
            local name=$1 arch=$2 profile=$3 packages
            mount -o loop "$image" "$WORKER_ROOT" || return
            debootstrap --variant=minbase --arch="$arch" "$DEBIAN_SUITE" "$WORKER_ROOT" "$DEBIAN_MIRROR" || return
            printf '%s\n' "$name" >"$WORKER_ROOT/etc/hostname" || return
            printf '127.0.0.1 localhost\n127.0.1.1 %s\n::1 localhost ip6-localhost ip6-loopback\n' "$name" >"$WORKER_ROOT/etc/hosts" || return
            packages=$(profile_packages "$profile") || return
            if [[ -n $packages ]]; then
                progress "Installing the $profile profile: $packages"
                setup_resolv_conf "$work" "$WORKER_ROOT"
                mount_session_devices || return
                local -a package_list=()
                read -r -a package_list <<<"$packages"
                chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" apt-get update || return
                chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" apt-get install -y --no-install-recommends "${package_list[@]}" || return
                chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" apt-get clean || return
            fi
            record_guest_details "$WORKER_ROOT" "$work"
            ;;
        export)
            mount -o loop,ro,noload "$image" "$WORKER_ROOT" || return
            tar --numeric-owner --acls --xattrs --one-file-system -C "$WORKER_ROOT" -czf "$1" . || return
            ;;
        boot)
            local kind=$1 name=$2 stage=$3 uuid=$4 version cmdline unit
            local -a packages=()
            read -r -a packages <<<"$BOOT_PACKAGES"
            [[ $kind != iso ]] || packages+=(live-boot)
            mount -o loop "$image" "$WORKER_ROOT" || return
            setup_resolv_conf "$work" "$WORKER_ROOT"
            mount_session_devices || return
            chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" apt-get update || return
            chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" apt-get install -y --no-install-recommends --download-only "${packages[@]}" || return
            # Only shim's files: its package scripts would install a bootloader.
            chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" sh -c 'rm -rf /var/tmp/chrootable-shim && mkdir /var/tmp/chrootable-shim &&
                cd /var/tmp/chrootable-shim && apt-get download shim-signed shim-helpers-amd64-signed &&
                for deb in *.deb; do dpkg-deb -x "$deb" files || exit; done' || return
            # systemd-resolved turns resolv.conf into a symlink, which it cannot
            # do while the host's file is bound over it; installing needs no network.
            if mountpoint -q "$WORKER_ROOT/etc/resolv.conf"; then umount "$WORKER_ROOT/etc/resolv.conf" || return; fi
            progress "Installing ${packages[*]}"
            chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" apt-get install -y --no-install-recommends --no-download "${packages[@]}" || return
            version=$(chroot "$WORKER_ROOT" sh -c 'ls /boot' | sed -n 's/^vmlinuz-//p' | sort -V | tail -n 1)
            [[ -n $version ]] && chroot "$WORKER_ROOT" test -f "/boot/initrd.img-$version" || { fail "The kernel or its initramfs is missing."; return 1; }
            # Writes go through the guest's chroot, so its symlinks never reach the host.
            [[ $kind != disk ]] || printf 'UUID=%s / ext4 errors=remount-ro 0 1\n' "$uuid" | guest_write /etc/fstab || return
            printf '[Match]\nType=ether\n\n[Network]\nDHCP=yes\n' | guest_write /etc/systemd/network/80-chrootable.network || return
            # Root is locked in a fresh workspace; consoles log in as root, like --enter.
            for unit in getty@tty1 serial-getty@ttyS0; do
                printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %%I $TERM\n' |
                    guest_write "/etc/systemd/system/$unit.service.d/autologin.conf" || return
            done
            printf '' | guest_write /etc/machine-id || return
            chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" systemctl enable systemd-networkd systemd-resolved || return
            cmdline='quiet console=ttyS0,115200 console=tty0'
            if [[ $kind == disk ]]; then cmdline="root=UUID=$uuid rw $cmdline"; else cmdline="boot=live $cmdline"; fi
            progress "Building the UKI for Linux $version"
            chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" ukify build --linux="/boot/vmlinuz-$version" --initrd="/boot/initrd.img-$version" \
                --uname="$version" --cmdline="$cmdline" --os-release=@/etc/os-release --output=/var/tmp/chrootable-uki.efi || return
            chroot "$WORKER_ROOT" cat /var/tmp/chrootable-uki.efi >"$stage/uki.efi" &&
                chroot "$WORKER_ROOT" cat /var/tmp/chrootable-shim/files/usr/lib/shim/shimx64.efi.signed >"$stage/shimx64.efi" &&
                chroot "$WORKER_ROOT" cat /var/tmp/chrootable-shim/files/usr/lib/shim/mmx64.efi.signed >"$stage/mmx64.efi" || return
            chroot "$WORKER_ROOT" rm -rf /var/tmp/chrootable-shim /var/tmp/chrootable-uki.efi || return
            chroot "$WORKER_ROOT" "${GUEST_ENV[@]}" apt-get clean || return
            ;;
        squash)
            mount -o loop,ro,noload "$image" "$WORKER_ROOT" || return
            # live-boot needs neither the kernel nor the initramfs: the UKI has both.
            mksquashfs "$WORKER_ROOT" "$1" -noappend -comp zstd -wildcards -e 'boot/vmlinuz-*' 'boot/initrd.img-*' || return
            ;;
        import)
            mount -o loop "$image" "$WORKER_ROOT" || return
            # '*.*' restores every xattr namespace, file capabilities included.
            tar --numeric-owner --acls --xattrs --xattrs-include='*.*' -xpf "$1" -C "$WORKER_ROOT" || return
            record_guest_details "$WORKER_ROOT" "$work"
            ;;
        enter)
            local name=$1 lifecycle=$2 network=$3 tmpfs_options=mode=0755,nosuid,nodev
            shift 3
            if [[ $lifecycle == ephemeral ]]; then
                if [[ -n $EPHEMERAL_SIZE ]]; then valid_tmpfs_size "$EPHEMERAL_SIZE" || return; tmpfs_options+=",size=$EPHEMERAL_SIZE"; fi
                mkdir -p "$WORKER_LOWER" "$WORKER_OVERLAY" || return
                mount -o loop,ro,noload "$image" "$WORKER_LOWER" || return
                mount -t tmpfs -o "$tmpfs_options" tmpfs "$WORKER_OVERLAY" || return
                mkdir -p "$WORKER_OVERLAY/upper" "$WORKER_OVERLAY/work" || return
                mount -t overlay overlay -o "lowerdir=$WORKER_LOWER,upperdir=$WORKER_OVERLAY/upper,workdir=$WORKER_OVERLAY/work" "$WORKER_ROOT" || return
            else
                mount -o loop "$image" "$WORKER_ROOT" || return
            fi
            if [[ $network == isolated ]]; then
                ip link set lo up 2>/dev/null || ifconfig lo up 2>/dev/null || true
            else
                setup_resolv_conf "$work" "$WORKER_ROOT"
            fi
            mount_session_devices || return
            hostname "$name" || return
            local -a environment=(HOME=/root USER=root LOGNAME=root SHELL=/bin/bash
                "LANG=$(guest_locale "$WORKER_ROOT")" "TERM=$(guest_terminal "$WORKER_ROOT")"
                PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
                "CHROOTABLE_NAME=$name" "CHROOTABLE_LIFECYCLE=$lifecycle" "CHROOTABLE_NETWORK=$network")
            [[ -z ${COLORTERM:-} ]] || environment+=("COLORTERM=$COLORTERM")
            printf 'started\n' >"$work/started" || return
            # Scripts get exactly the command's stdout; the banner is shell-only.
            if (( $# == 0 )); then
                info "[$name] $lifecycle session | network: $network"
                [[ $lifecycle != ephemeral ]] || info "All filesystem changes in this session disappear on exit."
                set -- /bin/bash --login
            fi
            cd "$WORKER_ROOT" || return
            chroot "$WORKER_ROOT" /usr/bin/env -i "${environment[@]}" "$@" || return
            cd / || return
            ;;
        *) fail "Unknown worker operation."; return 2 ;;
    esac
)

# JSON output needs no Python/jq dependency and never evaluates metadata.
json_string() {
    local value=$1 character number i
    # Most values need no escaping; skip the per-character loop for them.
    if [[ $value != *[\"\\[:cntrl:]]* ]]; then printf '"%s"' "$value"; return; fi
    printf '"'
    for ((i=0; i<${#value}; i++)); do
        character=${value:i:1}
        case $character in
            '"') printf '\\"' ;; \\) printf '\\\\' ;;
            *) printf -v number '%d' "'$character"
               if (( number < 32 )); then printf '\\u%04x' "$number"; else printf '%s' "$character"; fi ;;
        esac
    done
    printf '"'
}
image_json() {
    local image=$1 name key value comma=
    name=$(basename "$image" .img)
    printf '{'
    for key in name path status lifecycle suite architecture release profile description \
        created_at last_used_at origin restored_from restored_at; do
        case $key in
            name) value=$name ;; path) value=$image ;; status) value=$(image_status "$image") ;;
            lifecycle) value=$(image_lifecycle "$image") ;; profile) value=$(metadata_value "$image" "$key" minimal) ;;
            last_used_at) value=$(metadata_value "$image" "$key" never) ;;
            description|restored_from|restored_at) value=$(metadata_value "$image" "$key" '') ;;
            *) value=$(metadata_value "$image" "$key" unknown) ;;
        esac
        printf '%s"%s":' "$comma" "$key"; json_string "$value"; comma=,
    done
    printf ',"size_mib":%s,"allocated_bytes":%s,"snapshots":%s}' "$(image_size_mib "$image")" "$(allocated_bytes "$image")" "$(snapshot_count "$name")"
}
list_images() {
    local format=${1:-text} image comma=
    [[ $format != json ]] || printf '['
    for image in "$IMAGE_DIR/"*.img; do
        [[ -f $image && ! -L $image ]] || continue
        valid_name "$(basename "$image" .img)" || continue
        if [[ $format == json ]]; then printf '%s' "$comma"; image_json "$image"; comma=,
        else printf '%s\t%s\t%s MiB\n' "$(basename "$image" .img)" "$(image_lifecycle "$image")" "$(image_size_mib "$image")"; fi
    done
    [[ $format != json ]] || printf ']\n'
    return 0
}
image_details() {
    local image=$1 name value
    name=$(basename "$image" .img)
    printf '%s  /  %s  /  %s\n' "$name" "$(image_status "$image")" "$(image_lifecycle "$image")"
    value=$(metadata_value "$image" description '')
    [[ -z $value ]] || printf '%s\n' "$value"
    printf '\nDebian %-14s Architecture %s\nProfile %-13s Snapshots    %s\n' \
        "$(metadata_value "$image" suite unknown)" "$(metadata_value "$image" architecture unknown)" \
        "$(metadata_value "$image" profile minimal)" "$(snapshot_count "$name")"
    value=$(metadata_value "$image" release '')
    [[ -z $value ]] || printf 'Release  %s\n' "$value"
    printf 'Capacity %s MiB   Allocated %s\nCreated  %s\nLast run %s\n' \
        "$(image_size_mib "$image")" "$(human_bytes "$(allocated_bytes "$image")")" \
        "$(metadata_value "$image" created_at 'unknown (legacy image)')" "$(metadata_value "$image" last_used_at never)"
    value=$(metadata_value "$image" origin none)
    if [[ $value != none ]]; then
        if [[ $(metadata_value "$image" profile minimal) == imported ]]; then printf 'Imported %s\n' "$value"
        else printf 'Clone of %s\n' "$value"; fi
    fi
    value=$(metadata_value "$image" restored_from '')
    [[ -z $value ]] || printf 'Restored %s at %s\n' "$value" "$(metadata_value "$image" restored_at unknown)"
    printf 'Image    %s\n' "$image"
}
workspace_summary() {
    local image total=0 persistent=0 ephemeral=0 busy=0 bytes=0 snapshots=0 snapshot_bytes=0 allocated free=unknown
    for image in "$IMAGE_DIR/"*.img; do
        [[ -f $image && ! -L $image ]] || continue
        allocated=$(allocated_bytes "$image") || allocated=0
        total=$((total + 1)); bytes=$((bytes + allocated))
        if [[ $(image_lifecycle "$image") == ephemeral ]]; then ephemeral=$((ephemeral + 1)); else persistent=$((persistent + 1)); fi
        [[ $(image_status "$image") != busy ]] || busy=$((busy + 1))
    done
    for image in "$SNAPSHOT_DIR/"*/*.img; do
        [[ -f $image && ! -L $image ]] || continue
        allocated=$(allocated_bytes "$image") || allocated=0
        snapshots=$((snapshots + 1)); snapshot_bytes=$((snapshot_bytes + allocated))
    done
    # Free space where new images go; images/ may be a separate mount.
    if [[ -d $IMAGE_DIR ]]; then free=$(df -Ph -- "$IMAGE_DIR" | awk 'NR == 2 {print $4}')
    elif [[ -d $STORE_DIR ]]; then free=$(df -Ph -- "$STORE_DIR" | awk 'NR == 2 {print $4}'); fi
    printf '%s workspaces   %s persistent   %s disposable   %s busy\n' "$total" "$persistent" "$ephemeral" "$busy"
    printf '%s in images   %s in %s snapshots   %s host free\n' "$(human_bytes "$bytes")" "$(human_bytes "$snapshot_bytes")" "$snapshots" "$free"
}
dashboard() {
    local image accent='' reset=''
    if [[ -t 1 && -z ${NO_COLOR:-} ]]; then accent=$'\033[1;36m'; reset=$'\033[0m'; fi
    printf '\n%sCHROOTABLE%s  /  Debian environment workbench  /  %s\n\n' "$accent" "$reset" "$APP_VERSION"
    workspace_summary
    printf '\n%-24s %-7s %-11s %-10s %-9s %s\n' WORKSPACE STATE MODE PROFILE CAPACITY SNAPSHOTS
    for image in "$IMAGE_DIR/"*.img; do
        [[ -f $image && ! -L $image ]] || continue
        printf '%-24s %-7s %-11s %-10s %-9s %s\n' "$(basename "$image" .img)" "$(image_status "$image")" \
            "$(image_lifecycle "$image")" "$(metadata_value "$image" profile minimal)" "$(image_size_mib "$image")M" "$(snapshot_count "$(basename "$image" .img)")"
    done
    printf '\nStore: %s\n' "$STORE_DIR"
    if [[ -f $STORE_DIR/activity.tsv ]]; then printf '\nRecent activity\n'; activity 5; fi
    printf '\nCreate: --create NAME 4096 persistent build\nExplore: --help | --profiles | --doctor | --demo\n\n'
}
activity() {
    local count=${1:-20} format=${2:-text} time operation name status log comma=
    if [[ ! -f $STORE_DIR/activity.tsv ]]; then
        if [[ $format == json ]]; then printf '[]\n'; else printf 'No operations recorded yet. Create a workspace to get started.\n'; fi
        return 0
    fi
    if [[ $format != json ]]; then
        tail -n "$count" "$STORE_DIR/activity.tsv" | awk -F '\t' '{printf "%s  %-14s %-20s %s\n", $1, $2, $3, $4}'
        return
    fi
    printf '['
    while IFS=$'\t' read -r time operation name status log; do
        printf '%s{"time":' "$comma"; json_string "$time"
        printf ',"operation":'; json_string "$operation"
        printf ',"name":'; json_string "$name"
        printf ',"status":'; json_string "$status"
        printf ',"log":'; json_string "$log"; printf '}'; comma=,
    done < <(tail -n "$count" "$STORE_DIR/activity.tsv")
    printf ']\n'
}
show_logs() {
    local name=$1 log latest=
    valid_name "$name" || { fail "Invalid image name."; return 1; }
    if [[ -f $STORE_DIR/activity.tsv ]]; then
        # The chronological journal names each finished operation's log, so one
        # pass finds the newest and "foo-bar" logs never count as "foo" logs.
        while IFS= read -r log; do
            if [[ $log == "$LOG_DIR/"* && $log != *..* && -f $log && ! -L $log ]]; then latest=$log; fi
        done < <(awk -F '\t' -v name="$name" '$3 == name {print $5}' "$STORE_DIR/activity.tsv")
    else
        for log in "$LOG_DIR/$name-"*.log; do
            [[ -f $log && ! -L $log ]] || continue
            [[ -n $latest && ! $log -nt $latest ]] || latest=$log
        done
    fi
    [[ -n $latest ]] || { printf 'No completed operation logs for %s yet.\n' "$name"; return 0; }
    printf 'Log: %s\n\n' "$latest"
    tail -n 200 -- "$latest"
}
list_exports() {
    local format=${1:-text} archive base size created checksum kind comma=
    [[ $format != json ]] || printf '['
    for archive in "$EXPORT_DIR/"*.tar.gz "$EXPORT_DIR/"*.iso "$EXPORT_DIR/"*.img; do
        [[ -f $archive && ! -L $archive ]] || continue
        base=${archive##*/}
        size=$(stat -c%s -- "$archive") || continue
        created=$(date -r "$archive" --iso-8601=seconds) || created=unknown
        checksum=
        if [[ -f $archive.sha256 && ! -L $archive.sha256 && -r $archive.sha256 ]]; then read -r checksum _ <"$archive.sha256" || true; fi
        if [[ $format != json ]]; then
            printf '%s\t%s\t%s\n' "$base" "$(human_bytes "$size")" "$created"
            continue
        fi
        printf '%s{"file":' "$comma"; json_string "$base"
        case $base in *.iso) kind=iso ;; *.img) kind=disk ;; *) kind=archive ;; esac
        # NAME-YYYYmmdd-HHMMSS-TOKEN.EXT; the token never contains a hyphen.
        base=${base%.tar.gz}; base=${base%.iso}; base=${base%.img}
        printf ',"kind":"%s","workspace":' "$kind"; json_string "${base%-*-*-*}"
        printf ',"path":'; json_string "$archive"
        printf ',"created_at":'; json_string "$created"
        printf ',"sha256":'; if [[ -n $checksum ]]; then json_string "$checksum"; else printf null; fi
        printf ',"size_bytes":%s}' "$size"; comma=,
    done
    [[ $format != json ]] || printf ']\n'
    return 0
}
# Leftovers of operations that died without cleaning up (power loss, kill -9).
# Each belongs to a workspace name; if that name's lock is free, no operation
# is still writing it (new operations always pick fresh file names).
stale_files() {
    local file base name descriptor
    for file in "$IMAGE_DIR"/.*.partial* "$IMAGE_DIR"/*.img.meta.?????? "$EXPORT_DIR"/.*.partial* \
        "$SNAPSHOT_DIR"/*/.*.partial* "$SNAPSHOT_DIR"/*/*.img.meta.??????; do
        [[ -f $file && ! -L $file ]] || continue
        base=${file##*/}
        if [[ $file == "$SNAPSHOT_DIR"/* ]]; then name=${file#"$SNAPSHOT_DIR/"}; name=${name%%/*}
        elif [[ $base == .* ]]; then name=${base#.}; name=${name%.??????.partial*}
        else name=${base%.img.meta.??????}; fi
        valid_name "$name" || continue
        ( try_lock_image "$IMAGE_DIR/$name.img" descriptor ) || continue
        printf '%s\n' "$file"
    done
}
cleanup_store() (
    local apply=${1:-} file allocated bytes=0; local -a files=()
    mapfile -t files < <(stale_files)
    if (( ${#files[@]} == 0 )); then info "No leftover files from interrupted operations."; return 0; fi
    for file in "${files[@]}"; do
        allocated=$(allocated_bytes "$file") || allocated=0
        bytes=$((bytes + allocated))
        printf '%s\t%s\n' "$(human_bytes "$allocated")" "$file"
    done
    if [[ $apply != --yes ]]; then
        info "${#files[@]} leftover files use $(human_bytes "$bytes"). Remove them with: sudo $0 --cleanup --yes"
        return 0
    fi
    begin_operation cleanup store || return
    printf '%s\n' "${files[@]}" >>"$OP_LOG"
    rm -f -- "${files[@]}" || return
    info "Removed ${#files[@]} leftover files ($(human_bytes "$bytes"))."
)
doctor() {
    local command missing=0 fs namespace partials=0 file
    printf 'CHROOTABLE / Host health\n\n'
    printf 'Host: %s / %s\nStore: %s\nDebian: %s from %s\n\n' "$(uname -s)" "$(uname -m)" "$STORE_DIR" "$DEBIAN_SUITE" "$DEBIAN_MIRROR"
    if (( EUID == 0 )); then printf '[OK] Running as root.\n'
    else printf '[INFO] Not running as root; workspace operations need sudo.\n'; fi
    for command in "${REQUIRED_COMMANDS[@]}"; do
        command -v "$command" >/dev/null 2>&1 && continue
        if [[ $command == whiptail ]]; then printf '[INFO] whiptail is missing; only the menu needs it.\n'; continue; fi
        printf '[MISSING] %-14s install %s\n' "$command" "$(package_for_command "$command")"
        missing=$((missing + 1))
    done
    (( missing != 0 )) || printf '[OK] Host commands are available.\n'
    if ! valid_suite "$DEBIAN_SUITE" || ! valid_mirror "$DEBIAN_MIRROR"; then
        printf '[MISSING] CHROOTABLE_DEBIAN_SUITE or CHROOTABLE_DEBIAN_MIRROR is malformed.\n'; missing=$((missing + 1))
    elif ! debootstrap_knows_suite "$DEBIAN_SUITE"; then
        printf '[MISSING] debootstrap has no script for suite %s.\n' "$DEBIAN_SUITE"; missing=$((missing + 1))
    else printf '[OK] Debian suite and mirror settings are valid.\n'; fi
    for fs in ext4 overlay; do
        if awk -v fs="$fs" '$NF==fs {found=1} END {exit !found}' /proc/filesystems; then printf '[OK] Kernel filesystem: %s\n' "$fs"
        else printf '[INFO] %s is not loaded; it may be available as a kernel module.\n' "$fs"; fi
    done
    for namespace in mnt uts ipc pid net; do
        if [[ -e /proc/self/ns/$namespace ]]; then printf '[OK] Namespace: %s\n' "$namespace"
        else printf '[MISSING] Namespace: %s\n' "$namespace"; missing=$((missing + 1)); fi
    done
    if [[ -e /dev/loop-control ]]; then printf '[OK] Loop device control exists.\n'
    else printf '[INFO] /dev/loop-control is unavailable; image mounts may be blocked.\n'; fi
    if [[ -d $STORE_DIR ]]; then
        if [[ -r $STORE_DIR && -x $STORE_DIR ]]; then
            printf '[OK] Store is readable.\n'
            for file in "$IMAGE_DIR"/.*.partial "$EXPORT_DIR"/.*.partial "$SNAPSHOT_DIR"/*/.*.partial; do
                [[ ! -f $file ]] || partials=$((partials + 1))
            done 2>/dev/null
            (( partials == 0 )) || printf '[INFO] %s partial files: running operations or leftovers. Review: sudo %s --cleanup\n' "$partials" "$0"
            df -Ph -- "$STORE_DIR"
        else printf '[INFO] Store needs root access.\n'; fi
    else printf '[INFO] Store will be created on the first write operation.\n'; fi
    printf '\nMount permissions are not tested by this read-only check.\n'
    (( missing == 0 )) || printf 'Install missing tools: sudo %s --setup\n' "$0"
    (( missing == 0 ))
}

ui_init() {
    [[ -t 0 && -t 1 ]] || { fail "The menu needs a terminal. Use --dashboard, --list, or --help for command-line output."; return 1; }
    command -v whiptail >/dev/null || { fail "Install whiptail to use the menu (sudo apt-get install whiptail)."; return 1; }
    local rows columns
    read -r rows columns < <(stty size 2>/dev/null) || { rows=24; columns=80; }
