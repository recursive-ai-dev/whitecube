        --import) [[ $# == 5 && -n $3 ]] && valid_name "$2" && valid_size_mib "$4" && valid_lifecycle "$5" ;;
        --clone|--snapshot|--rename) [[ $# == 3 ]] && valid_name "$2" && valid_name "$3" ;;
        --describe) [[ $# == 3 ]] && valid_name "$2" && valid_description "$3" ;;
        --mode) [[ $# == 3 ]] && valid_name "$2" && valid_lifecycle "$3" ;;
        --resize) [[ $# == 3 ]] && valid_name "$2" && valid_size_mib "$3" ;;
        --restore|--drop-snapshot) [[ $# == 4 && $4 == --yes ]] && valid_name "$2" && valid_name "$3" ;;
        --repair|--delete) [[ $# == 3 && $3 == --yes ]] && valid_name "$2" ;;
        --exec|--try) [[ $# -ge 2 ]] && valid_name "$2" && validate_session_arguments "$@" ;;
        *) return 1 ;;
    esac
}
run_cli() {
    local image operation=$1 network=shared lifecycle count=20
    case $operation in
        --help|-h) usage ;; --version) printf '%s\n' "$APP_VERSION" ;;
        --profiles) list_profiles "${2:+json}" ;; --doctor) doctor ;; --demo) run_demo "${2:-}" ;;
        --dashboard) dashboard ;; --list) list_images "${2:+json}" ;; --exports) list_exports "${2:+json}" ;;
        --activity)
            shift
            if [[ ${1:-} =~ ^[0-9]+$ ]]; then count=$1; shift; fi
            activity "$count" "${1:+json}" ;;
        --logs) show_logs "$2" ;; --snapshots) list_snapshots "$2" "${3:+json}" ;;
        --setup) info "All host dependencies are available." ;;
        --cleanup) cleanup_store "${2:-}" ;;
        --create) create_image "$2" "$3" "$4" "${5:-minimal}" ;;
        --import) import_image "$2" "$3" "$4" "$5" ;;
        --restore) restore_image "$2" "$3" ;;
        --drop-snapshot) drop_snapshot "$2" "$3" ;;
        *)
            image=$(resolve_image "$2") || return
            case $operation in
                --inspect) if [[ ${3:-} == --json ]]; then image_json "$image"; printf '\n'; else image_details "$image"; fi ;;
                --clone) clone_image "$image" "$3" ;; --resize) resize_image "$image" "$3" ;;
                --rename) rename_image "$image" "$3" ;; --describe) describe_image "$image" "$3" ;;
                --repair) repair_image "$image" ;; --delete) delete_image "$image" ;; --export) export_image "$image" ;;
                --export-iso) boot_export "$image" iso ;; --export-disk) boot_export "$image" disk ;;
                --snapshot) snapshot_image "$image" "$3" ;; --mode) set_lifecycle "$image" "$3" ;;
                --enter|--enter-isolated)
                    [[ $operation != --enter-isolated && ${3:-} != --isolated ]] || network=isolated
                    enter_chrootable "$image" "$(image_lifecycle "$image")" "$network" ;;
                --exec|--try)
                    shift 2
                    lifecycle=$(image_lifecycle "$image")
                    [[ $operation != --try ]] || lifecycle=ephemeral
                    if [[ ${1:-} == --isolated ]]; then network=isolated; shift; fi
                    [[ ${1:-} != -- ]] || shift
                    enter_chrootable "$image" "$lifecycle" "$network" "$@" ;;
            esac ;;
    esac
}
main() {
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export PATH
    umask 077
    SCRIPT_PATH=$(readlink -f -- "$SCRIPT_PATH") || return
    if [[ ${1:-} == --worker ]]; then
        [[ $# -ge 5 ]] || return 2
        shift; worker_main "$@"; return
    fi
    if (( $# == 0 )); then
        NON_INTERACTIVE=0
        (( EUID == 0 )) || { fail "The menu needs root: sudo $0. Without root, try $0 --demo or $0 --dashboard."; return 1; }
        check_prerequisites && init_store && ui_init && main_menu
        return
    fi
    validate_cli "$@" || { usage_error "$1"; return 2; }
    case $1 in
        --help|-h|--version|--profiles|--demo) ;;
        --doctor) resolve_store || true ;;
        --dashboard|--list|--inspect|--activity|--logs|--snapshots|--exports) check_readable_store || return ;;
        *)
            [[ $1 != --setup ]] || NON_INTERACTIVE=0
            require_root && check_prerequisites && init_store || return ;;
    esac
    run_cli "$@"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
