# Whitecube boot splash. Assets (generated by install-plymouth.sh): bg.png, bar.png.
Window.SetBackgroundTopColor(0.016, 0.027, 0.051);
Window.SetBackgroundBottomColor(0.016, 0.027, 0.051);

sw = Window.GetWidth();
sh = Window.GetHeight();

bg = Image("bg.png");
if (bg) {
  bg_scaled = bg.Scale(sw, sh);
  bg_sprite = Sprite(bg_scaled);
  bg_sprite.SetZ(-100);
}

title = Image.Text("WHITECUBE", 1.0, 0.23, 0.23, 1.0, "Monospace 22");
title_sprite = Sprite(title);
title_sprite.SetX(sw / 2 - title.GetWidth() / 2);
title_sprite.SetY(sh * 0.42);

bar = Image("bar.png");
bar_w = sw * 0.3;
bar_sprite = Sprite();
bar_sprite.SetX(sw / 2 - bar_w / 2);
bar_sprite.SetY(sh * 0.42 + 56);

fun refresh(time, progress) {
  if (progress < 0.02) progress = 0.02;
  bar_sprite.SetImage(bar.Scale(bar_w * progress, 3));
}
Plymouth.SetBootProgressFunction(refresh);

# Disk passphrase prompt: without these a script theme hides the LUKS prompt entirely.
prompt_sprite = Sprite();
bullets_sprite = Sprite();

fun display_password(prompt, bullets) {
  p = Image.Text(prompt, 1.0, 0.48, 0.48, 1.0, "Monospace 12");
  prompt_sprite.SetImage(p);
  prompt_sprite.SetX(sw / 2 - p.GetWidth() / 2);
  prompt_sprite.SetY(sh * 0.58);
  dots = "";
  for (i = 0; i < bullets; i++) dots += "*";
  b = Image.Text(dots, 1.0, 0.23, 0.23, 1.0, "Monospace 14");
  bullets_sprite.SetImage(b);
  bullets_sprite.SetX(sw / 2 - b.GetWidth() / 2);
  bullets_sprite.SetY(sh * 0.58 + 28);
}
Plymouth.SetDisplayPasswordFunction(display_password);

fun display_normal() {
  prompt_sprite.SetOpacity(0);
  bullets_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal);

question_sprite = Sprite();
fun display_question(prompt, entry) {
  q = Image.Text(prompt + " " + entry, 1.0, 0.48, 0.48, 1.0, "Monospace 12");
  question_sprite.SetImage(q);
  question_sprite.SetX(sw / 2 - q.GetWidth() / 2);
  question_sprite.SetY(sh * 0.58);
}
Plymouth.SetDisplayQuestionFunction(display_question);

fun message(text) {
  m = Image.Text(text, 0.6, 0.6, 0.6, 1.0, "Monospace 10");
  msg_sprite.SetImage(m);
  msg_sprite.SetX(sw / 2 - m.GetWidth() / 2);
  msg_sprite.SetY(sh - 60);
}
msg_sprite = Sprite();
Plymouth.SetMessageFunction(message);
