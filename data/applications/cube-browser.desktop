[Desktop Entry]
Type=Application
Name=Cube Browser
GenericName=Web Browser
Comment=Native interactive-web browser preview for Whitecube
Exec=/usr/bin/cube-browser %u
TryExec=/usr/bin/cube-browser
Icon=cube-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=cube-browser
X-Wayland-Native=true
