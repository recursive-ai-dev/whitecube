[Desktop Entry]
Type=Application
Name=Cube Strap
GenericName=Debian Cube Builder
Comment=Bootstrap Debian whitecubes: Chrootables workspaces or bootable VMs
Exec=/usr/bin/cube-strap
TryExec=/usr/bin/cube-strap
