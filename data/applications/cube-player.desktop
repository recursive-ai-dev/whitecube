[Desktop Entry]
Type=Application
Version=1.0
Name=Cube Player
GenericName=Media Player
Comment=Your Whitecube space for films and music
Exec=/usr/bin/cube-player %U
TryExec=/usr/bin/cube-player
Icon=cube-player
Terminal=false
StartupNotify=true
StartupWMClass=cube-player
Categories=AudioVideo;Player;Audio;Video;
Keywords=Whitecube;mpv;film;music;media;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/ogg;audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/opus;audio/mp4;audio/x-wav;audio/wav;audio/aac;audio/x-mpegurl;application/x-mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;application/xspf+xml;
X-Wayland-Native=true
