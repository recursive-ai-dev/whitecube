# STAGED, NOT INSTALLED. A tighter replacement for sudoers-whitecube-settings (review, then install with:
#   sudo visudo -c -f sudoers-whitecube-settings.hardened && sudo install -m 0440 -o root -g root \
#        sudoers-whitecube-settings.hardened /etc/sudoers.d/whitecube-settings
# and rebuild/install cube-settings, which now asks for your password for the two actions below.)
#
# What changes compared with the current rule:
#   * Saving a Wi-Fi network (net-add) and forgetting one (net-forget) now need your password. A process
#     running as you can no longer silently add an attacker's network or delete yours.
#   * Every remaining passwordless command has its arguments pinned: net-connect takes exactly a 16-digit
#     hex profile id, brightness a number up to 100, power-action only suspend, reboot or poweroff.
#     (The helper validates these too; this is the second lock.)
# Unchanged: reads (services, firewall, net-scan), restarting Wi-Fi, brightness and the power menu stay
# passwordless because the top bar calls them through "sudo -n" and cannot ask for a password.
Cmnd_Alias CUBE_FREE = /usr/libexec/whitecube/cube-settings-helper services, /usr/libexec/whitecube/cube-settings-helper firewall, /usr/libexec/whitecube/cube-settings-helper net-scan, \
	/usr/libexec/whitecube/cube-settings-helper net-reconnect, /usr/libexec/whitecube/cube-settings-helper net-connect [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f], \
	/usr/libexec/whitecube/cube-settings-helper brightness [0-9], /usr/libexec/whitecube/cube-settings-helper brightness [0-9][0-9], /usr/libexec/whitecube/cube-settings-helper brightness 100, \
	/usr/libexec/whitecube/cube-settings-helper power-action suspend, /usr/libexec/whitecube/cube-settings-helper power-action reboot, /usr/libexec/whitecube/cube-settings-helper power-action poweroff
%sudo ALL=(root) /usr/libexec/whitecube/cube-settings-helper
%sudo ALL=(root) NOPASSWD: CUBE_FREE
