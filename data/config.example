# Whitecube / space. Existing custom command settings can be retained.
tab_w=160
tab_h=40
grid_step=96
bg=06080d
grid=0c0f15
tabbar=090c12
border=697c99
unfocused=8995a8
terminal=/usr/bin/whitecube-terminal
launcher=fuzzel
chat_app_id=cube-chat
chat_cmd=foot -a cube-chat -T cube-chat /usr/bin/cube-chat
scripts_app_id=cube-scripts
scripts_cmd=/usr/bin/whitecube-terminal -c "$HOME/.config/whitecube/scripts-foot.ini" -a cube-scripts -T Scripts /usr/bin/cube-scripts
browser_cmd=/usr/bin/whitecube-web open
help_cmd=foot -T keys -e less /usr/share/whitecube/keys.txt

# Privacy controls (Settings > Privacy). Defaults retain existing preferences.
privacy_hide_titles=0
privacy_hide_network=0
privacy_remember_layout=1
privacy_save_titles=1
privacy_clipboard=1
privacy_clear_clipboard_on_lock=1
privacy_lock_minutes=0
settings_cmd=cube-settings

# Wallpaper: 1 starts the cosmic zoom (cells > ... > expanding universe) instead of the plain cube field.
cosmos=0
