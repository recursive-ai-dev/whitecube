{
  "version": 1,
  "id": "my-browser-project",
  "name": "My browser project",
  "description": "Serve this project's existing dist on loopback.",
  "launch": {
    "command": [
      "python3",
      "-m",
      "http.server",
      "8790",
      "--bind",
      "127.0.0.1",
      "--directory",
      "dist"
    ],
    "url": "http://127.0.0.1:8790/"
  },
  "project_mode": "ro",
  "commands": {
    "build": {
      "command": [
        "make"
      ],
      "container": "build"
    },
    "test": {
      "command": [
        "python3",
        "-m",
        "unittest"
      ]
    },
    "preview": {
      "command": [
        "python3",
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "dist"
      ],
      "url": "http://127.0.0.1:8790/"
    }
  }
}
