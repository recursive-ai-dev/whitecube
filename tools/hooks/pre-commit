#!/bin/bash
# Runs the fast pure-Python test suites before every commit (the full build is ./BUILD.sh).
# Enabled with: git config core.hooksPath tools/hooks   (tools/install-hooks.sh does it).
# Skip once, knowingly, with: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
for t in net/test_cube_net.py net/test_cube_wifi.py tests/test-privacy.py tests/test-doctor.py tests/test-sudoers.py tests/test-clean.py tests/test-whitecube-install.py tests/test-install.py tests/test-migrate.py tests/test-cube-chat.py; do
  out=$(python3 -I "$t" 2>&1) || { printf '%s\n' "$out" | tail -25; echo "pre-commit: $t failed; commit refused" >&2; exit 1; }
done
echo "pre-commit: python test suites passed"
